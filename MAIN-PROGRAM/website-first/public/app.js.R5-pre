function xStrict(key,lang=state.uiLanguage){const l=lang||'en';const v=(T[l]&&T[l][key])??(extra[l]&&extra[l][key]);if(l!=='en'&&(!v||v===T.en?.[key]||v===extra.en?.[key]))return `[${key}]`;return v??(T.en?.[key]??extra.en?.[key]??key);}
function x(k){let v=(extra[state.uiLanguage]||{})[k]||(T[state.uiLanguage]||{})[k]||(extra.en||{})[k]||(T.en||{})[k]||fallback[k]||k;const p=state.monetizationPolicy;if(!p&&['freeParts','wait','earnings','firstTen'].includes(k))return 'Configured by Master Admin';if(!p)return v;const a=p.contentAccess||{};if(k==='freeParts'){const n=a.stories?.novel?.freeParts;if(Number.isFinite(Number(n)))v=v.replace('{v1}',String(n));}else if(k==='wait'){const n=a.stories?.novel?.dailyProgressHours;if(Number.isFinite(Number(n)))v=v.replace('{v1}',String(n));}else if(k==='earnings'){const n=p.royalty?.minGenuineFollowers;if(Number.isFinite(Number(n)))v=v.replace('{v1}',String(n));}return v}
Object.assign(extra.en,{"Katha Vistaar":"kathaVistaar", "Sponsored":"sponsored", "Support creators \u00b7 Explore more":"supportCreatorsExplore", "Sponsored media. Ad controls are governed by the active subscription/ad policy.":"sponsoredMediaPolicy", "Continue":"continue", "Made for India":"madeForIndia", "Secure":"secure", "23 languages":"languages23", "Internal AI":"internalAi", "FEATURED KATHA":"featuredKatha", "Read \u00b7 Listen \u00b7 Watch":"readListenWatch", "Continue Reading":"continueReadingTitle", "Your library":"yourLibrary", "Open library":"openLibrary", "Build, save and preview this format before publication.":"studioBuildPreview", "Internal layer ON":"internalLayerOn", "AI Production Plan":"aiProductionPlan", "Save Studio Project":"saveStudioProject", "Story Studio":"storyStudio", "Acts":"acts", "Scenes":"scenes", "Characters":"characters", "Beats":"beats", "Continuity":"continuity", "Language":"language", "Premise":"premise", "Act":"act", "Scene":"scene", "Character":"character", "Beat":"beat", "AI Review":"aiReview", "Publishing Readiness":"publishingReadiness", "Creator Approval":"creatorApproval", "Canonical facts":"canonicalFacts", "Open threads":"openThreads", "Add an act.":"addAct", "Add a scene.":"addScene", "Add a character.":"addCharacter", "Add a beat.":"addBeat", "Pages":"pages", "Page":"page", "panels":"panels", "Add Page":"addPage", "Panel":"panel", "Speech Balloon":"speechBalloon", "T Caption":"caption", "Layers":"layers", "AI Layout":"aiLayout", "Export PNG":"exportPng", "DPI":"dpi", "Print preset":"printPreset", "Screen":"screen", "PNG Master":"pngMaster", "PDF/X-4 metadata":"pdfX4", "Print Master":"printMaster", "Halftone":"halftone", "3-pt Perspective":"perspective", "Warp/Mesh":"warpMesh", "Works":"works", "Readers":"readers", "Coins":"coins", "Missions":"missions", "Training AI Coach":"trainingAiCoach", "Emotion-aware coaching for writing, comic, FM/audio and reel creation. Choose a female, male or child voice profile for rehearsal.":"trainingAiDescription", "What do you want to improve?":"trainingTopicPlaceholder", "Training topic":"trainingTopic", "Training language":"trainingLanguage", "Coach me":"coachMe", "Enter a training topic.":"enterTrainingTopic", "Training AI is preparing an emotion-aware coaching plan\u2026":"trainingPreparing", "Training AI":"trainingAi", "Training AI unavailable.":"trainingUnavailable", "Log out admin":"logoutAdmin", "Product Key (leave blank for Designated Admin)":"productKeyPrompt", "Design / UX / Architecture Mapping":"designUxArchitecture", "NO ENGINE INTEGRATION":"noEngineIntegration", "Project KV30 is used only as a reference source. Unverified engine, model, TTS, benchmark and cryptographic claims are not imported.":"referenceLayerDescription", "External services currently fallback/off":"externalServicesFallback", "None":"none", "No content yet":"noContentYet", "Open HLS playlist":"openHlsPlaylist", "Not transcoded yet":"notTranscodedYet", "Choose verification method":"chooseVerificationMethod", "Select where Katha Vistaar should send your OTP.":"selectOtpDestination", "Registered contact":"registeredContact", "Send OTP":"sendOtp", "Cancel":"cancel", "Application failed to render":"applicationRenderFailed", "The source program raised an error. This diagnostic does not substitute for a fix.":"renderDiagnostic", "Katha Vistaar diagnostic":"kathaDiagnostic", "Configured by Master Admin":"configuredByMasterAdmin"});
function t(key){return x(key)}
function configuredAccessText(){let v=x('firstTen');const p=state.monetizationPolicy||{};const a=p.contentAccess||{};const vals=[a.media?.noAppFreeParts,a.media?.appFreeParts];if(vals.every(n=>Number.isFinite(Number(n)))){let i=0;v=v.replace(/\{v\d+\}/g,()=>String(vals[Math.min(i++,vals.length-1)]));}return v}
async function getJSON(url,opt){const base=opt||{};const headers={'Accept-Language':String(state.uiLanguage||'en'),'X-KV30-UI-Language':String(state.uiLanguage||'en'),...(base.headers||{})};const r=await fetch(url,{cache:'no-store',credentials:'same-origin',...base,headers});if(!r.ok){const e=await r.json().catch(()=>({}));const code=e.error||String(r.status);const err=new Error(code);err.code=code;err.details=e;if(code==='session_expired'){state.user=null;sessionStorage.clear();updateHeader?.();showToast(e.message||'Your session is no longer active. Please log in again.','error');setTimeout(()=>{history.replaceState({},'',ROUTE_PATHS.home);render?.('home')},0)}if(code==='admin_session_expired'){localStorage.removeItem('kv.admin.role');showToast(e.message||'Your admin session is no longer active. Please sign in again.','error');setTimeout(()=>{history.replaceState({},'',ROUTE_PATHS.home);render?.('home')},0)}throw err}return r.json()}
const ROUTE_PATHS={home:'/',discover:'/discover',trending:'/trending',stories:'/stories',categories:'/categories',comic:'/comics',audio:'/audio',reel:'/reels',library:'/library',reader:'/reader',write:'/write',account:'/profile','reader-dashboard':'/reader-dashboard','author-dashboard':'/author-dashboard','admin-dashboard':'/admin-dashboard','ai-dashboard':'/ai-dashboard','account-settings':'/account-settings',settings:'/settings','phone-settings':'/phone-settings',help:'/help','safety-tickets':'/safety-tickets',editor:'/editor',series:'/series','media-tools':'/media-tools','payments':'/payments','notifications':'/notifications','messages':'/messages','subscriptions':'/subscriptions','reports':'/reports','ads':'/ads','stickers':'/stickers','admin-monetization':'/admin-monetization',analytics:'/analytics',audience:'/analytics/audience',performance:'/analytics/content',recommendations:'/recommendations',accessibility:'/settings/accessibility',privacy:'/settings/privacy',security:'/settings/security',interests:'/settings/interests','master-command':'/master-admin','security-audit':'/security-audit','regional-analytics':'/analytics/regional','events':'/events','creator-tiers':'/creator/tiers','my-writing':'/write'};
function currentRoute(){
  const p=location.pathname.replace(/\/$/,'')||'/';
  const byPath=Object.entries(ROUTE_PATHS).find(([,path])=>path===p);
  if(byPath)return byPath[0];
  const legacy=location.hash.replace(/^#/,'').trim();
  return legacy==='comics'?'comic':legacy==='stories'?'stories':legacy==='reels'?'reel':legacy||'home';
}
function navigate(route){
  const allowed=Object.keys(ROUTE_PATHS);
  const target=allowed.includes(route)?route:'home';
  history.pushState({},'',ROUTE_PATHS[target]);
  render(target);
}
function esc(v){return String(v??'').replace(/[&<>'"]/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[m]))}
state.user=null;state.myContent=[];state.authChecked=false;state.viewer=null;state.authMode='login';state.otpContext=null;state.resetContext=null;
function b64uFromBuffer(v){const b=new Uint8Array(v);let s='';for(const c of b)s+=String.fromCharCode(c);return btoa(s).replace(/\+/g,'-').replace(/\//g,'_').replace(/=+$/,'')}
function bufferFromB64u(s){const v=String(s||'').replace(/-/g,'+').replace(/_/g,'/');const p='='.repeat((4-v.length%4)%4);const raw=atob(v+p);return Uint8Array.from(raw,c=>c.charCodeAt(0))}
async function loginWithPasskey(){const out=document.getElementById('loginError');try{if(!window.PublicKeyCredential||!navigator.credentials){throw new Error(x('deviceAuthUnavailable'))}const opt=await getJSON('/api/auth/passkey/login/options',{method:'POST'});const cred=await navigator.credentials.get({publicKey:{challenge:bufferFromB64u(opt.challenge),rpId:opt.rpId,userVerification:'required',timeout:opt.timeout,allowCredentials:[]}});if(!cred)throw new Error('passkey_cancelled');const r=await getJSON('/api/auth/passkey/login/verify',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({challenge:opt.challenge,response:{clientDataJSON:b64uFromBuffer(cred.response.clientDataJSON),authenticatorData:b64uFromBuffer(cred.response.authenticatorData),signature:b64uFromBuffer(cred.response.signature),userHandle:b64uFromBuffer(cred.response.userHandle||new ArrayBuffer(0))}})});state.user=r.user;document.getElementById('login')?.close();updateHeader();render('home')}catch(e){if(out)out.textContent=humanAuthError(e.message||'Device authentication failed.')}}
async function registerPasskey(){try{if(!state.user)return openLogin();if(!window.PublicKeyCredential||!navigator.credentials)throw new Error(x('deviceAuthUnavailable'));const password=await uiPrompt(x('currentPasswordRequired'),true);if(!password)return;const opt=await getJSON('/api/auth/passkey/register/options',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({password})});const cred=await navigator.credentials.create({publicKey:{challenge:bufferFromB64u(opt.challenge),rp:opt.rp,user:{id:bufferFromB64u(opt.user.id),name:opt.user.name,displayName:opt.user.displayName},pubKeyCredParams:opt.pubKeyCredParams,authenticatorSelection:opt.authenticatorSelection,timeout:opt.timeout,attestation:'none'}});if(!cred)throw new Error('passkey_cancelled');const r=await getJSON('/api/auth/passkey/register/verify',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({challenge:opt.challenge,response:{clientDataJSON:b64uFromBuffer(cred.response.clientDataJSON),attestationObject:b64uFromBuffer(cred.response.attestationObject)}})});showToast(r.passkey?.enabled?x('enableDeviceAuth'):'Passkey setup completed.')}catch(e){showToast(humanAuthError(e.message||'Could not enable device authentication.'))}}

function openLogin(){const d=document.getElementById('login');if(d&&!d.open)d.showModal();document.getElementById('loginIdentifier')?.focus()}
function openRegister(){document.getElementById('login')?.close();const d=document.getElementById('register');if(d&&!d.open)d.showModal();document.querySelector('#register input[name=username]')?.focus()}
function openForgotPassword(){document.getElementById('login')?.close();const d=document.getElementById('forgotPasswordDialog');if(d&&!d.open)d.showModal();document.getElementById('forgotIdentifier')?.focus()}
function openResetPasswordDialog(ctx){state.resetContext=ctx;const d=document.getElementById('resetPasswordDialog');if(d&&!d.open)d.showModal();document.getElementById('resetNewPassword')?.focus()}
function loginGate(){return `<div class="gate card"><h2 class="gate-title">${kvIcon('lock')}<span>${x('loginRequired')}</span></h2><p>${t('loginHelp')}</p><div class="button-row"><button class="primary" data-open-login>${t('login')}</button><button class="button" data-register>${x('createAccount')}</button></div></div>`}
function page(title,body){return `<section class="page-shell"><div class="page-head"><button class="back-button" data-back>← ${t('back')}</button><div><span class="eyebrow">Katha Vistaar</span><h1>${title}</h1></div></div>${body}</section>`}
function adStrip(placement='home'){
 const labels={home:'Sponsored · Katha Vistaar',discover:'Sponsored · Discover',story:'Sponsored · Story',comic:'Sponsored · Comic',fm:'Sponsored · FM',reel:'Sponsored · Reel',notifications:'Sponsored · Updates',messages:'Sponsored · Messages',profile:'Sponsored · Profile'};
 return `<div class="ad-strip" data-ad-placement="${esc(placement)}"><div class="ad-strip-track"><span>${kvIcon('megaphone')}${esc(labels[placement]||x('sponsored'))}</span><span>•</span><span>Support creators · Explore more</span><span>•</span><span>Katha Vistaar</span></div></div>`;
}
async function showPreRoll(type='video',placement='reel',done){
 const key='kv.preroll.'+placement+'.'+type;if(sessionStorage.getItem(key))return done?.();
 try{const policy=await getJSON('/api/ads/active?placement='+encodeURIComponent(placement));if(!policy.eligible)return done?.();const a=(policy.ads||[]).find(x=>x.type===type&&x.assetUrl);if(!a)return done?.();
  const tag=type==='audio'?'audio':'video';const html=`<dialog id="adPreRoll" class="ad-preroll"><article class="card"><span class="eyebrow">Sponsored</span><h3>${type==='audio'?'Audio advertisement':'Video advertisement'}</h3><div id="adPreRollMedia" class="ad-demo-media"></div><p class="muted">Sponsored media. Ad controls are governed by the active subscription/ad policy.</p><button class="primary" id="adContinue">Continue</button></article></dialog>`;
  document.getElementById('adPreRoll')?.remove();document.body.insertAdjacentHTML('beforeend',html);const d=document.getElementById('adPreRoll'),host=document.getElementById('adPreRollMedia');if(!d||!host)return done?.();host.innerHTML=`<${tag} controls autoplay playsinline style="width:100%;max-height:320px" src="${esc(a.assetUrl)}"></${tag}>`;d.showModal();document.getElementById('adContinue')?.addEventListener('click',()=>{sessionStorage.setItem(key,'1');d.close();d.remove();done?.()},{once:true});
 }catch(e){console.warn('Pre-roll unavailable; continuing without blocking content.',e);done?.();}
}
function routeLink(route,label,cls='button'){return `<a class="${cls}" href="${ROUTE_PATHS[route]||'/'}" data-route="${route}">${label}</a>`}
function stitchThumb(type){return type==='story'?'/assets/stitch-v30/rani-durgavati.png':type==='comic'?'/assets/stitch-v30/chai-aur-charcha.png':type==='audio'?'/assets/stitch-v30/continue-midnight.png':'/assets/stitch-v30/home-feature-art.png'}
function contentCard(c){const icon=c.type==='comic'?kvIcon('comic'):c.type==='audio'?kvIcon('audio'):c.type==='reel'?kvIcon('reel'):kvIcon('book');const part=c.partNumber||1;const subs=state.user?.subscriptions||{};const hasApp=!!(subs.appReader||subs.app_reader);const hasFormat=!!(c.type==='comic'?(subs.comicReader||subs.comic_reader):c.type==='audio'?(subs.audioReader||subs.fm_reader):c.type==='reel'?(subs.reelReader||subs.reel_reader):false);const access=state.monetizationPolicy?.contentAccess||{},novelAccess=access.stories?.novel||{},mediaAccess=access.media||{},freeCount=(c.type==='story'&&String(c.workType||'').toLowerCase()==='novel')?Number(novelAccess.freeParts||0):(['comic','audio','reel'].includes(c.type)?(hasFormat?Number.POSITIVE_INFINITY:(hasApp?Number(mediaAccess.appFreeParts||0):Number(mediaAccess.noAppFreeParts||0))):Number.POSITIVE_INFINITY);const locked=!state.user||part>freeCount;const action=c.type==='comic'?x('readComic'):c.type==='audio'?x('listen'):c.type==='reel'?x('watchReel'):x('readStory');const eng=c.engagement||{};const rating=Number(eng.rating||c.rating||4.5);const readers=Number(c.readers||eng.readers||0);const author=c.author?.name||'Katha Vistaar Team';const authorId=c.author?.id||'system';const wt=WORK_TYPE_LABEL(c.type,c.workType||WORK_TYPES_BY_TYPE[c.type]?.[0]||'');return `<article class="content-card content-card-${c.type} stitch-content-card"><div class="content-thumb"><img src="${stitchThumb(c.type)}" alt="" loading="lazy"><span class="content-type-badge">${icon}<span>${esc(wt)}</span></span></div><div class="content-card-main"><span class="eyebrow">${esc(c.category||c.type)} · ${x('part')} ${part}</span><h3>${esc(c.title)}</h3><p>${locked?kvIcon('lock')+'<span>'+x('locked')+' · '+x('wait')+'</span>':esc((c.body||'').replace(/<[^>]+>/g,'').slice(0,120))}</p><div class="content-meta"><span class="meta-item">☆ ${rating.toFixed(1)}</span><span class="meta-item">${readers.toLocaleString()} ${readersLabel()}</span><span class="meta-item author-meta">${esc(authorLabel())}: <a class="author-link" href="/profile?userId=${encodeURIComponent(authorId)}" data-public-profile="${esc(authorId)}">${esc(author)}</a></span></div><div class="button-row"><button class="button" data-open-content="${c.id}" data-type="${c.type}" data-part="${part}">${locked?kvIcon('lock'):''}${action}</button>${state.user?`<button class="button icon-text-action" data-save-content="${c.id}">${kvIcon('bookmark')}${t('save')}</button>`:''}</div></div></article>`}
function formatTile(type,icon,label,active=false){const route=type==='story'?'stories':type==='comic'?'comic':type==='audio'?'audio':'reel';return `<a class="format-tile ${active?'active':''}" href="${ROUTE_PATHS[route]}" data-route="${route}"><span class="format-icon">${icon}</span><strong>${label}</strong></a>`}
function contentTypeNav(active=null){return `<nav class="content-type-nav" aria-label="${x('formats')}">${formatTile('story',kvIcon('book'),t('stories'),active==='story')}${formatTile('comic',kvIcon('comic'),t('comic'),active==='comic')}${formatTile('reel',kvIcon('reel'),t('reel'),active==='reel')}${formatTile('audio',kvIcon('audio'),t('audio'),active==='audio')}</nav>`}
function typeSelector(type){const selected=state.workTypeByType[type]||null;return `<div class="work-type-bar"><strong>${workTypesLabel()}</strong><div class="category-chip-row"><button type="button" class="category-chip ${selected===null?'active':''}" data-work-type="" data-work-type-format="${type}">${categoryLabel('all')}</button>${WORK_TYPES_BY_TYPE[type].map(k=>`<button type="button" class="category-chip ${selected===k?'active':''}" data-work-type="${k}" data-work-type-format="${type}">${esc(WORK_TYPE_LABEL(type,k))}</button>`).join('')}</div></div>`}
function competitionSection(type){return `<section class="section-block competition-section"><div class="section-heading"><div><span class="eyebrow">${competitionLabel()}</span><h2>${kvIcon('trophy')}${competitionLabel()}</h2><p class="muted">${t('competitionText')}</p></div></div><div class="competition-grid">${COMPETITIONS_BY_TYPE[type].map((name,i)=>`<article class="card competition-card"><span class="competition-rank">${i+1}</span><h3>${esc(name)}</h3><p class="muted">${t('competitionJoin')}</p><button class="button" type="button" data-competition="${esc(name)}">${t('viewCompetition')}</button></article>`).join('')}</div></section>`}
function kv30bSectionHead(icon,title,kicker,action=''){return `<div class="kv30b-section-head"><div class="kv30b-head-copy"><span class="eyebrow">${esc(kicker||x('kathaVistaar'))}</span><h2>${icon||''}<span>${esc(title)}</span></h2></div>${action}</div>`}
function home(){
  const smartHub=`<section class="kv-smart-hub" aria-labelledby="smartHubTitle"><div class="kv-smart-hub-head"><div><span class="eyebrow">Katha Vistaar · Internal Intelligence</span><h2 id="smartHubTitle">${kvIcon('spark')} Smart Creation & Reading Hub</h2><p>One governed internal-AI workspace for creating, transforming, reading, listening and watching.</p></div><span class="kv-smart-badge">23 LANGUAGES · INTERNAL-FIRST</span></div><div class="kv-smart-format-grid">${[['story','book',x('storyNovel'),'Write, plan or transform stories'],['comic','comic','Comic','Plan panels, dialogue and visual continuity'],['audio','audio',x('audio'),'Shape narration, pacing, voice and emotion'],['reel','reel','Reel','Plan scenes, shots, captions and timing']].map(([type,icon,label,desc])=>`<button type="button" class="kv-smart-format" data-smart-format="${type}"><span class="kv-smart-icon">${kvIcon(icon)}</span><span><strong>${label}</strong><small>${desc}</small></span><span class="kv-smart-arrow">→</span></button>`).join('')}</div><div class="kv-smart-actions"><button type="button" class="primary" id="openSmartAssist">${kvIcon('spark')} Ask Internal AI</button><span class="muted">AI proposes; you remain in control of applying and publishing.</span></div></section>`;
  return adStrip('home')+`<section class="kv30b-home-hero stitch-home-hero home-hero"><div class="kv30b-hero-copy"><span class="eyebrow">Katha Vistaar · ${esc(state.uiLanguage==='en'?x('madeForIndia'):'भारत')}</span><h1>${t('welcome')}</h1><p>${t('intro')}</p><div class="button-row"><a class="primary button" href="/stories" data-route="stories">${kvIcon('book')}${x('readStory')}</a><a class="button" href="/write" data-route="write">${kvIcon('write')}${t('write')}</a></div><div class="kv30b-trust-row"><span>${kvIcon('shield')} Secure</span><span>${kvIcon('globe')} 23 languages</span><span>${kvIcon('spark')} Internal AI</span></div></div><div class="kv30b-hero-art"><img src="/assets/stitch-v30/home-feature-art.png" alt="Featured Katha illustration"><div class="kv30b-hero-caption"><span>FEATURED KATHA</span><strong>${x('popularOnKV')}</strong><small>Read · Listen · Watch</small></div></div></section>
  <section class="kv30b-section">${kv30bSectionHead(kvIcon('bookmark'),x('continueReadingTitle'),x('yourLibrary'),`<a class="icon-button" href="/library" data-route="library" aria-label=x('openLibrary')>${kvIcon('library')}</a>`)}<div id="homeContinue" class="kv30b-rail stitch-continue-card"></div></section>
  <section class="kv30b-section">${kv30bSectionHead('', 'Top Katha','Trending now',routeLink('discover',x('more'),'button'))}<div id="homeStories" class="kv30b-top-list"></div></section>
  <section class="kv30b-section">${kv30bSectionHead(kvIcon('book'),x('formats'),'Explore by format','')}${contentTypeNav()}</section>
  <section class="kv30b-section">${kv30bSectionHead(kvIcon('library'),x('categories'),'Find your next story',routeLink('categories',x('more'),'button'))}<div class="category-chip-row kv30b-chips category-preview">${CATEGORIES_BY_TYPE.story.slice(0,8).map(k=>`<button type="button" class="category-chip" data-category-type="story" data-category="${k}">${categoryLabel(k)}</button>`).join('')}</div></section>
  <section class="kv30b-section">${kv30bSectionHead(kvIcon('comic'),x('comic'),'Visual stories',routeLink('comic',x('more'),'button'))}<div id="homeComics" class="content-grid"></div></section>
  <section class="kv30b-section">${kv30bSectionHead(kvIcon('reel'),x('reel'),'Up to 2 minutes',routeLink('reel',x('more'),'button'))}<div id="homeReels" class="content-grid"></div></section>
  <section class="kv30b-section">${kv30bSectionHead(kvIcon('audio'),x('audio'),'Listen anywhere',routeLink('audio',x('more'),'button'))}<div id="homeAudio" class="content-grid"></div></section>${competitionSection('story')}`;
}

function categoryChipBar(type){const selected=state.categoryByType[type]||null;return `<div class="category-chip-bar" aria-label="${x('categories')}"><button type="button" class="category-chip ${selected===null?'active':''}" data-category-type="${type}" data-category="">${categoryLabel('all')}</button>${CATEGORIES_BY_TYPE[type].map(k=>`<button type="button" class="category-chip ${selected===k?'active':''}" data-category-type="${type}" data-category="${k}">${categoryLabel(k)}</button>`).join('')}</div>`}
function mediaPage(type){const title=type==='story'?x('stories'):type==='comic'?x('comic'):type==='audio'?x('audio'):x('reel');return page(title,`${adStrip(type==='audio'?'fm':type)}${contentTypeNav(type)}${categoryChipBar(type)}${typeSelector(type)}<div class="notice"><strong>${configuredAccessText()}</strong> · ${x('wait')} · ${x('ads')}</div><div class="section-heading"><div><h2>${title}</h2><p class="muted">${t('discoverText')}</p></div></div><div id="${type}Grid" class="content-grid"></div>${competitionSection(type)}<section class="section-block sample-section"><div class="section-heading"><div><span class="eyebrow">${x('sampleContent')}</span><h2>${title} · ${x('sampleParts')}</h2></div></div><div class="sample-parts">${Array.from({length:6},(_,i)=>`<span class="sample-part">${x('part')} ${i+1}</span>`).join('')}</div></section>`)}
function discover(){
 return page(t('discover'),`<section class="kv30b-discover-head"><div><span class="eyebrow">Katha Vistaar</span><h1>${x('discover')}</h1><p>${t('discoverText')}</p></div><div class="kv30b-search-box"><span>${kvIcon('search')}</span><input id="searchBox" placeholder="${t('search')}" autocomplete="off"><button class="primary" id="searchBtn">${kvIcon('search')} ${t('search')}</button></div></section><div class="kv30b-filter-strip"><button class="button" id="advancedSearchToggle">${kvIcon('settings')}<span>${t('advancedSearch')}</span></button>${['story','comic','audio','reel'].map(k=>`<button class="category-chip" type="button" data-category-type="${k}" data-category="">${k==='story'?x('stories'):k==='comic'?x('comic'):k==='audio'?x('audio'):x('reel')}</button>`).join('')}</div><div id="advancedSearchPanel" class="card advanced-search-panel" hidden><div class="grid"><label>${x('contentType')}<select id="searchType"><option value="">${x('all')}</option><option value="story">${x('stories')}</option><option value="comic">${x('comic')}</option><option value="reel">${x('reel')}</option><option value="audio">${x('audio')}</option></select></label><label>${workTypesLabel()}<select id="searchWorkType"><option value="">${x('all')}</option></select></label><label>${x('category')}<select id="searchCategory"><option value="">${x('all')}</option></select></label><label>${t('sortBy')}<select id="searchSort"><option value="popular">${t('sortPopular')}</option><option value="rating">${t('sortRating')}</option><option value="readers">${t('sortReaders')}</option></select></label></div><button class="primary" id="applyAdvancedSearch">${t('applyFilters')}</button></div><div id="searchResult" class="result"></div><section class="section-block">${kv30bSectionHead('',x('popular'),'Curated for you','')}<div id="discoverGrid" class="content-grid"></div></section>`);
}
function trendingPage(){return page(x('trending'),`${adStrip('discover')}<section class="kv30b-section"><div class="section-heading"><div><span class="eyebrow">Katha Vistaar</span><h1>${kvIcon('trophy')} ${x('trending')}</h1><p class="muted">${x('popularOnKV')}</p></div></div><div id="trendingGrid" class="content-grid"><div class="card loading-card">Loading…</div></div></section>`)}
function categoriesPage(){return page(x('categories'),`<div class="card"><p class="muted">${t('discoverText')}</p></div>${['story','comic','reel','audio'].map(type=>`<section class="section-block"><div class="section-heading"><h2>${type==='story'?kvIcon('book'):type==='comic'?kvIcon('comic'):type==='reel'?kvIcon('reel'):kvIcon('audio')} ${type==='story'?x('stories'):type==='comic'?x('comic'):type==='reel'?x('reel'):x('audio')}</h2>${routeLink(type==='story'?'stories':type==='comic'?'comic':type==='reel'?'reel':'audio',x('more'),'button')}</div><div class="category-chip-row">${CATEGORIES_BY_TYPE[type].map(k=>`<button type="button" class="category-chip" data-category-type="${type}" data-category="${k}">${categoryLabel(k)}</button>`).join('')}</div>${typeSelector(type)}${competitionSection(type)}</section>`).join('')}`)}
function series(){if(state.user)return page(x('series'),`<div class="dashboard-head"><div><h2>${x('series')}</h2><p class="muted">${t('writeText')}</p></div>${routeLink('write',x('myWriting'),'button')}</div><div id="seriesList" class="series-manager"></div>`);return page(x('series'),`<div class="card"><p class="muted">${t('discoverText')}</p></div><div id="publicSeriesList" class="content-grid"></div>`)}
function library(){
  if(!state.user)return page(t('library'),loginGate());
  const tabs=[['story',t('stories')],['comic',t('comic')],['audio',t('audio')],['reel',t('reel')]];
  return page(t('library'),`<div class="library-tabs" role="tablist">${tabs.map(([type,label])=>`<button type="button" role="tab" aria-selected="${state.libraryTab===type}" class="${state.libraryTab===type?'active':''}" data-library-tab="${type}">${label}</button>`).join('')}</div><div id="libraryContent" class="library-content"></div>`);
}
function reader(){return page(t('reader'),`<div class="card"><h2>${kvIcon('book')}${x('stories')}</h2><p>${t('continueReading')}</p><p class="muted">Open any public work to read. Login is requested at that moment.</p></div><div id="readerGrid" class="content-grid"></div>`)}
function write(){if(!state.user)return page(t('write'),loginGate());return page(x('myWriting'),`<div class="dashboard-head"><div><h2>${x('drafts')}</h2><p>${t('writeText')}</p></div><div class="button-row">${routeLink('series',x('reorder'),'button')}<button class="primary" data-create-draft>${kvIcon('plus')}${x('create')}</button></div></div><div id="writingList" class="writing-list"></div><section class="creator-tools card"><h2>${x('creator')}</h2><div class="creator-tool-grid"><div><strong>${kvIcon('write')}${x('stories')}</strong><p>${x('creatorAccess')}</p></div><div><strong>${kvIcon('palette')}${x('comic')}</strong><p>${state.user.subscriptions.comicCreator?x('approved'):x('creatorSub')}</p>${state.user.subscriptions.comicCreator?routeLink('editor','Create Comic','button'):routeLink('subscriptions',x('subscription'),'button')}</div><div><strong>${kvIcon('audio')}${x('audio')}</strong><p>${state.user.subscriptions.audioCreator?x('approved'):x('creatorSub')}</p>${state.user.subscriptions.audioCreator?routeLink('editor','Create Audio','button'):routeLink('subscriptions',x('subscription'),'button')}</div><div><strong>${kvIcon('reel')}${x('reel')}</strong><p>${state.user.subscriptions.reelCreator?x('approved'):x('creatorSub')}</p>${state.user.subscriptions.reelCreator?routeLink('editor','Create 2-minute Reel','button'):routeLink('subscriptions',x('subscription'),'button')}</div></div><div class="creator-revenue card"><strong>${x('earnings')}</strong><p>${x('followers')}: ${state.user.followers||0}</p></div></section>`)}
function studioPanel(type='story'){
 const cfg={story:[`${kvIcon('write')} Story Studio`,'Outline','AI Writer','Voice-to-Write','Translation'],comic:[`${kvIcon('palette')} Comic Studio`,x('pages'),'Panels','Dialogue','Assets',x('aiStoryboard')],audio:[`${kvIcon('audio')} FM Studio`,'Episodes','Audio','Transcript','Voice Plan','AI Script'],reel:[`${kvIcon('reel')} Reel Studio`,'Storyboard','Timeline','Captions','Assets','AI Reel']}[type]||[];
 return `<section class="creator-studio card"><div class="section-heading"><div><h3>${cfg[0]}</h3><p class="muted">Build, save and preview this format before publication.</p></div><span class="service-badge">Internal layer ON</span></div><div id="studioTabs" class="studio-tabs">${cfg.slice(1).map((x,i)=>`<button type="button" class="studio-tab ${i===0?'active':''}" data-studio-tab="${i}">${x}</button>`).join('')}</div><div id="studioWorkspace" class="studio-workspace"></div><div class="button-row"><button type="button" class="button" id="studioAiPlan">${kvIcon('spark')} AI Production Plan</button><button type="button" class="button" id="studioSave">${kvIcon('save')} Save Studio Project</button><span id="studioStatus" class="result"></span></div></section>`;
}
async function runBoundedAiEndpoint(path,body){const out=document.getElementById('studioStatus')||document.getElementById('aiDash');if(out)out.textContent='Internal AI is preparing a governed proposal…';try{const r=await getJSON(path,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});if(out)out.innerHTML=`<strong>AI proposal ready.</strong> <span class="muted">Human approval required; no automatic publish/apply.</span>`;return r}catch(e){if(out)out.textContent='AI request failed: '+humanAuthError(e.message||e.code||x('aiRequestFailed'));return null}}
async function runStudioAI(type,request){
 const out=document.getElementById('studioStatus');
 if(out)out.textContent='Internal AI is analysing the studio project…';
 try{
  const r=await getJSON('/api/ai/creator-assist',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({type,title:document.getElementById('editorTitle')?.value||'',body:document.getElementById('editorBody')?.innerText||'',request,project:state.studioProject})});
  const suggestions=r.assistant?.suggestions||[];
  if(out)out.innerHTML=`<strong>Internal AI proposal ready.</strong> ${esc(suggestions.join(' '))} <span class=\"muted\">Creator approval required.</span>`;
  return r;
 }catch(e){if(out)out.textContent='Internal AI request failed: '+humanAuthError(e.message||e.code||x('aiRequestFailed'));return null;}
}
function renderStudioWorkspace(type,project={}){
 const box=document.getElementById('studioWorkspace');if(!box)return;
 state.studioPageIndex=Number.isInteger(state.studioPageIndex)?state.studioPageIndex:0;
 if(type==='story'){
  const acts=Array.isArray(project.acts)?project.acts:[], scenes=Array.isArray(project.scenes)?project.scenes:[], chars=Array.isArray(project.characters)?project.characters:[], beats=Array.isArray(project.beats)?project.beats:[];
  const continuity=project.continuity||{canonicalFacts:[],openThreads:[]};
  box.innerHTML=`<div class="pro-studio story-studio-workspace"><div class="studio-sidebar"><strong>Story Studio</strong><div class="studio-item active">Acts <span>${acts.length}</span></div><div class="studio-item">Scenes <span>${scenes.length}</span></div><div class="studio-item">Characters <span>${chars.length}</span></div><div class="studio-item">Beats <span>${beats.length}</span></div><div class="studio-item">Continuity <span>${(continuity.canonicalFacts||[]).length}</span></div></div><div><div class="studio-settings-row"><label>Language <input id="storyLanguage" maxlength="20" value="${esc(project.language||state.uiLanguage||'en')}"></label><label>Premise <input id="storyPremise" maxlength="10000" value="${esc(project.premise||'')}"></label></div><div class="timeline-toolbar"><button type="button" class="button" id="storyAddAct">${kvIcon('plus')} Act</button><button type="button" class="button" id="storyAddScene">${kvIcon('plus')} Scene</button><button type="button" class="button" id="storyAddCharacter">${kvIcon('plus')} Character</button><button type="button" class="button" id="storyAddBeat">${kvIcon('plus')} Beat</button><button type="button" class="button" id="storyReview">${kvIcon('history')} AI Review</button><button type="button" class="button" id="storyReadiness">Publishing Readiness</button><button type="button" class="button" id="storyApprove">Creator Approval</button></div><div class="story-studio-grid"><section class="card"><h4>Acts</h4>${acts.map((a,i)=>`<label>Act ${i+1}<input data-story-act="${i}" value="${esc(a.title||'')}" maxlength="200"></label>`).join('')||'<p class="muted">Add an act.</p>'}</section><section class="card"><h4>Scenes</h4>${scenes.map((a,i)=>`<label>Scene ${i+1}<input data-story-scene-title="${i}" value="${esc(a.title||'')}" maxlength="200"><textarea data-story-scene-body="${i}" rows="3" maxlength="20000">${esc(a.body||'')}</textarea></label>`).join('')||'<p class="muted">Add a scene.</p>'}</section><section class="card"><h4>Characters</h4>${chars.map((a,i)=>`<label>Character ${i+1}<input data-story-char="${i}" value="${esc(a.name||'')}" maxlength="200"></label>`).join('')||'<p class="muted">Add a character.</p>'}</section><section class="card"><h4>Beats</h4>${beats.map((a,i)=>`<label>Beat ${i+1}<input data-story-beat="${i}" value="${esc(a.action||'')}" maxlength="3000"></label>`).join('')||'<p class="muted">Add a beat.</p>'}</section><section class="card"><h4>Continuity</h4><label>Canonical facts<textarea id="storyCanonicalFacts" rows="4">${esc((continuity.canonicalFacts||[]).join('\n'))}</textarea></label><label>Open threads<textarea id="storyOpenThreads" rows="4">${esc((continuity.openThreads||[]).join('\n'))}</textarea></label></section></div></div></div>`;
  box.querySelector('#storyLanguage')?.addEventListener('input',e=>state.studioProject.language=e.target.value);
  box.querySelector('#storyPremise')?.addEventListener('input',e=>state.studioProject.premise=e.target.value);
  box.querySelectorAll('[data-story-act]').forEach(i=>i.oninput=e=>{acts[Number(i.dataset.storyAct)].title=e.target.value});
  box.querySelectorAll('[data-story-scene-title]').forEach(i=>i.oninput=e=>{scenes[Number(i.dataset.storySceneTitle)].title=e.target.value});
  box.querySelectorAll('[data-story-scene-body]').forEach(i=>i.oninput=e=>{scenes[Number(i.dataset.storySceneBody)].body=e.target.value});
  box.querySelectorAll('[data-story-char]').forEach(i=>i.oninput=e=>{chars[Number(i.dataset.storyChar)].name=e.target.value});
  box.querySelectorAll('[data-story-beat]').forEach(i=>i.oninput=e=>{beats[Number(i.dataset.storyBeat)].action=e.target.value});
  box.querySelector('#storyCanonicalFacts')?.addEventListener('input',e=>state.studioProject.continuity={...(state.studioProject.continuity||{}),canonicalFacts:e.target.value.split(/\n/).map(x=>x.trim()).filter(Boolean)});
  box.querySelector('#storyOpenThreads')?.addEventListener('input',e=>state.studioProject.continuity={...(state.studioProject.continuity||{}),openThreads:e.target.value.split(/\n/).map(x=>x.trim()).filter(Boolean)});
  box.querySelector('#storyAddAct')?.addEventListener('click',()=>{state.studioProject.acts=acts.concat({number:acts.length+1,title:'New Act'});renderStudioWorkspace(type,state.studioProject)});
  box.querySelector('#storyAddScene')?.addEventListener('click',()=>{state.studioProject.scenes=scenes.concat({number:scenes.length+1,title:'New Scene',body:'',actId:acts[0]?.id||''});renderStudioWorkspace(type,state.studioProject)});
  box.querySelector('#storyAddCharacter')?.addEventListener('click',()=>{state.studioProject.characters=chars.concat({name:'New Character',role:'supporting'});renderStudioWorkspace(type,state.studioProject)});
  box.querySelector('#storyAddBeat')?.addEventListener('click',()=>{state.studioProject.beats=beats.concat({order:beats.length+1,sceneId:scenes[0]?.id||'',type:'turn',action:'New beat'});renderStudioWorkspace(type,state.studioProject)});
  box.querySelector('#storyReview')?.addEventListener('click',async()=>{const cid=document.getElementById('editorForm')?.dataset.id;if(!cid)return;try{const r=await getJSON('/api/studio/story/'+encodeURIComponent(cid)+'/review',{method:'POST'});document.getElementById('studioStatus').textContent=`AI review: ${r.review.summary.findingCount} finding(s). Human approval required.`}catch(e){document.getElementById('studioStatus').textContent=e.message}});
  box.querySelector('#storyReadiness')?.addEventListener('click',async()=>{const cid=document.getElementById('editorForm')?.dataset.id;if(!cid)return;try{const r=await getJSON('/api/studio/story/'+encodeURIComponent(cid)+'/readiness');document.getElementById('studioStatus').textContent=r.readiness.ready?'Publishing readiness: READY':'Publishing readiness: NOT READY — '+Object.entries(r.readiness.checks).filter(([,v])=>!v).map(([k])=>k).join(', ')}catch(e){document.getElementById('studioStatus').textContent=e.message}});
  box.querySelector('#storyApprove')?.addEventListener('click',async()=>{const cid=document.getElementById('editorForm')?.dataset.id;if(!cid)return;try{const r=await getJSON('/api/studio/story/'+encodeURIComponent(cid)+'/approve',{method:'POST'});document.getElementById('studioStatus').textContent=r.approval.approved?'Creator publication approval recorded.':'Approval not recorded.'}catch(e){document.getElementById('studioStatus').textContent=e.message}});
 }else if(type==='comic'){
  const pages=Array.isArray(project.pages)?project.pages:[];if(!pages.length)pages.push({page:1,panels:[],layers:[]});const pi=Math.min(state.studioPageIndex,pages.length-1),active=pages[pi];
  const dpi=Number(project.dpi||300),preset=project.printPreset||'screen';
  box.innerHTML=`<div class="pro-studio comic-canvas"><div class="studio-sidebar"><strong>Pages</strong><div id="studioPages">${pages.map((pg,i)=>`<button type="button" class="studio-item ${i===pi?'active':''}" data-page-index="${i}"><b>Page ${i+1}</b><span>${(pg.panels||[]).length} panels</span></button>`).join('')}</div><button type="button" class="button" id="studioAddPage">${kvIcon('plus')} Add Page</button></div><div><div class="canvas-toolbar"><button type="button" class="button" id="studioAddPanel">${kvIcon('plus')} Panel</button><button type="button" class="button" id="studioAddDialogue">${kvIcon('message')} Speech Balloon</button><button type="button" class="button" id="studioAddCaption">T Caption</button><button type="button" class="button" id="studioAddLayer">Layers</button><button type="button" class="button" id="studioAiVisual">${kvIcon('spark')} AI Layout</button><button type="button" class="button" id="studioExportComic">${kvIcon('download')} Export PNG</button></div><div class="studio-settings-row"><label>DPI <input id="comicDpi" type="number" min="72" max="1200" value="${dpi}"></label><label>Print preset <select id="comicPreset"><option value="screen" ${preset==='screen'?'selected':''}>Screen</option><option value="png" ${preset==='png'?'selected':''}>PNG Master</option><option value="pdf_x4" ${preset==='pdf_x4'?'selected':''}>PDF/X-4 metadata</option><option value="print_master" ${preset==='print_master'?'selected':''}>Print Master</option></select></label><label>Halftone <input id="comicHalftone" type="checkbox" ${project.halftone60l!==false?'checked':''}></label><label>3-pt Perspective <input id="comicPerspective" type="checkbox" ${project.perspective3pt?'checked':''}></label><label>Warp/Mesh <input id="comicWarp" type="checkbox" ${project.warpMesh?'checked':''}></label></div><div class="comic-canvas-grid" id="comicCanvas">${(active.panels||[]).map((pn,i)=>`<div class="comic-panel draggable-panel" draggable="true" data-panel-index="${i}" style="left:${pn.x??(i%2)*50}%;top:${pn.y??Math.floor(i/2)*50}%;width:${pn.w??48}%;height:${pn.h??44}%"><span>Panel ${i+1}</span><input class="panel-scene" value="${esc(pn.scene||x('scene'))}" aria-label="Panel scene"><textarea class="panel-dialogue" placeholder="Dialogue">${esc(pn.dialogue||'')}</textarea><select class="panel-bubble-type" aria-label="Balloon type"><option value="speech">Speech</option><option value="shout">Shout</option><option value="thought">Thought</option><option value="narration">Narration</option></select><input class="panel-kerning" type="number" step="0.001" value="${Number(pn.kerning||0)}" aria-label="Kerning"><label class="panel-shirorekha"><input type="checkbox" ${pn.shirorekha!==false?'checked':''}> Shirorekha</label><small>Drag · scene/dialogue · balloon typography · Save Studio Project</small></div>`).join('')||'<div class="canvas-empty">Add a panel to start your comic page.</div>'}</div></div></div>`;
  box.querySelectorAll('[data-page-index]').forEach(btn=>btn.onclick=()=>{state.studioPageIndex=Number(btn.dataset.pageIndex);renderStudioWorkspace(type,state.studioProject)});
  box.querySelector('#comicDpi')?.addEventListener('input',e=>state.studioProject.dpi=Number(e.target.value||300));box.querySelector('#comicPreset')?.addEventListener('change',e=>state.studioProject.printPreset=e.target.value);box.querySelector('#comicHalftone')?.addEventListener('change',e=>state.studioProject.halftone60l=e.target.checked);box.querySelector('#comicPerspective')?.addEventListener('change',e=>state.studioProject.perspective3pt=e.target.checked);box.querySelector('#comicWarp')?.addEventListener('change',e=>state.studioProject.warpMesh=e.target.checked);
  box.querySelectorAll('.draggable-panel').forEach(el=>{el.addEventListener('dragend',e=>{const r=box.querySelector('#comicCanvas').getBoundingClientRect();const p=active.panels[Number(el.dataset.panelIndex)];p.x=Math.max(0,Math.min(95,((e.clientX-r.left)/r.width)*100-10));p.y=Math.max(0,Math.min(95,((e.clientY-r.top)/r.height)*100-10));p.w=Number(p.w||48);p.h=Number(p.h||44);renderStudioWorkspace(type,state.studioProject)});el.querySelector('.panel-scene')?.addEventListener('input',e=>active.panels[Number(el.dataset.panelIndex)].scene=e.target.value);el.querySelector('.panel-dialogue')?.addEventListener('input',e=>active.panels[Number(el.dataset.panelIndex)].dialogue=e.target.value);el.querySelector('.panel-bubble-type')?.addEventListener('change',e=>active.panels[Number(el.dataset.panelIndex)].bubbleType=e.target.value);el.querySelector('.panel-kerning')?.addEventListener('input',e=>active.panels[Number(el.dataset.panelIndex)].kerning=Number(e.target.value||0));el.querySelector('.panel-shirorekha input')?.addEventListener('change',e=>active.panels[Number(el.dataset.panelIndex)].shirorekha=e.target.checked)});
 }else if(type==='audio'){
  const eps=Array.isArray(project.episodes)?project.episodes:[];const assets=(state.editorMedia||[]).filter(a=>String(a.mimeType||'').startsWith('audio/'));const sr=String(project.sampleRate||'48000'),bd=String(project.bitDepth||'24'),lu=Number(project.loudnessTarget??-14),tp=Number(project.truePeak??-1);box.innerHTML=`<div class="pro-studio audio-timeline"><div class="studio-settings-row"><label>Sample rate <select id="fmSampleRate"><option value="44100" ${sr==='44100'?'selected':''}>44.1kHz</option><option value="48000" ${sr==='48000'?'selected':''}>48kHz</option><option value="96000" ${sr==='96000'?'selected':''}>96kHz</option></select></label><label>Bit depth <select id="fmBitDepth"><option value="16" ${bd==='16'?'selected':''}>16-bit</option><option value="24" ${bd==='24'?'selected':''}>24-bit</option><option value="32" ${bd==='32'?'selected':''}>32-bit</option></select></label><label>LUFS target <input id="fmLufs" type="number" min="-30" max="-5" step="0.1" value="${lu}"></label><label>True peak <input id="fmPeak" type="number" min="-10" max="0" step="0.1" value="${tp}"></label><label>Sidechain duck <input id="fmDuck" type="checkbox" ${project.sidechainDucking!==false?'checked':''}></label></div><div class="timeline-toolbar"><button type="button" class="button" id="studioAddEpisode">${kvIcon('plus')} Episode</button><button type="button" class="button" id="studioAddSegment">${kvIcon('plus')} Segment</button><button type="button" class="button" id="studioAiAudio">${kvIcon('spark')} AI Script</button><button type="button" class="button" id="studioLoadWave">${kvIcon('waveform')} Load Real Waveform</button><button type="button" class="button" id="studioMixAudio">${kvIcon('mix')} Render Mix</button></div><div id="audioWaveHost" class="waveform"><span>00:00</span><canvas id="realWaveform" width="900" height="120" aria-label="Audio waveform"></canvas><span>Ready</span></div><div class="timeline-list">${eps.map((e,i)=>`<div class="timeline-row"><b>Episode ${e.episode||i+1}</b><span>${(e.segments||[]).length} segments</span><div class="timeline-track">${(e.segments||[]).map((sg,j)=>`<span style="width:${Math.min(40,8+(j*7))}%"><input data-seg-title="${i}:${j}" value="${esc(sg.title||sg.name||'Segment')}"><input data-seg-duration="${i}:${j}" type="number" min="1" value="${Number(sg.duration||sg.seconds||30)}">s</span>`).join('')}</div></div>`).join('')||'<div class="muted">Create an episode to start the FM timeline.</div>'}</div>${assets.length?`<label>Mix source audio<select id="fmMixAssets" multiple size="${Math.min(4,assets.length)}">${assets.map(a=>`<option value="${esc(a.assetId||a.id)}" selected>${esc(a.filename||a.id)}</option>`).join('')}</select></label>`:'<p class="muted">Upload an audio asset in the media attachment area to enable real waveform and mix rendering.</p>'}</div>`;
  box.querySelector('#studioAddEpisode')?.addEventListener('click',()=>{state.studioProject.episodes=Array.isArray(state.studioProject.episodes)?state.studioProject.episodes:[];state.studioProject.episodes.push({episode:state.studioProject.episodes.length+1,segments:[]});renderStudioWorkspace(type,state.studioProject)});box.querySelector('#fmSampleRate')?.addEventListener('change',e=>state.studioProject.sampleRate=e.target.value);box.querySelector('#fmBitDepth')?.addEventListener('change',e=>state.studioProject.bitDepth=e.target.value);box.querySelector('#fmLufs')?.addEventListener('input',e=>state.studioProject.loudnessTarget=Number(e.target.value));box.querySelector('#fmPeak')?.addEventListener('input',e=>state.studioProject.truePeak=Number(e.target.value));box.querySelector('#fmDuck')?.addEventListener('change',e=>state.studioProject.sidechainDucking=e.target.checked);
  box.querySelector('#studioAddSegment')?.addEventListener('click',()=>{state.studioProject.episodes=state.studioProject.episodes?.length?state.studioProject.episodes:[{episode:1,segments:[]}];state.studioProject.episodes[0].segments.push({title:'New segment',start:0,duration:30});renderStudioWorkspace(type,state.studioProject)});
  box.querySelectorAll('[data-seg-title]').forEach(i=>i.oninput=e=>{const [a,b]=i.dataset.segTitle.split(':').map(Number);state.studioProject.episodes[a].segments[b].title=e.target.value});box.querySelectorAll('[data-seg-duration]').forEach(i=>i.oninput=e=>{const [a,b]=i.dataset.segDuration.split(':').map(Number);state.studioProject.episodes[a].segments[b].duration=Number(e.target.value||1)});
  box.querySelector('#studioLoadWave')?.addEventListener('click',async()=>{const asset=assets[0];if(!asset){showToast('Upload an audio file first.');return}try{const r=await getJSON('/api/media/assets/'+encodeURIComponent(asset.assetId||asset.id));const blob=new Blob([r]);const ab=await blob.arrayBuffer();const ac=new AudioContext();const buf=await ac.decodeAudioData(ab);const ch=buf.getChannelData(0),cv=document.getElementById('realWaveform'),ctx=cv.getContext('2d');ctx.clearRect(0,0,cv.width,cv.height);ctx.beginPath();const step=Math.max(1,Math.floor(ch.length/cv.width));for(let x=0;x<cv.width;x++){let max=0;for(let j=0;j<step;j++)max=Math.max(max,Math.abs(ch[x*step+j]||0));const y=(1-max)*cv.height/2;ctx.moveTo(x,y);ctx.lineTo(x,cv.height-y)}ctx.stroke();document.querySelector('#audioWaveHost span:last-child').textContent=`${buf.duration.toFixed(1)}s`;}catch(e){showToast(e.message)}});
  box.querySelector('#studioMixAudio')?.addEventListener('click',async()=>{const ids=[...(box.querySelector('#fmMixAssets')?.selectedOptions||[])].map(o=>o.value);if(!ids.length){showToast('Select at least one audio asset.');return}try{const r=await getJSON('/api/media/audio/mix',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({assetIds:ids})});state.editorMedia.push(r.asset);document.getElementById('studioStatus').textContent='FM mix rendered successfully. Attach/save it before publishing.';renderStudioWorkspace(type,state.studioProject)}catch(e){showToast(e.message)}});
 }else if(type==='reel'){
  const clips=Array.isArray(project.clips)?project.clips:[];const assets=(state.editorMedia||[]).filter(a=>String(a.mimeType||'').startsWith('video/'));const rfps=Number(project.fps||60),res=String(project.resolution||'1080x1920'),ar=String(project.aspectRatio||'9:16');box.innerHTML=`<div class="pro-studio reel-timeline"><div class="studio-settings-row"><label>FPS <select id="reelFps"><option value="24" ${rfps===24?'selected':''}>24</option><option value="30" ${rfps===30?'selected':''}>30</option><option value="60" ${rfps===60?'selected':''}>60</option></select></label><label>Canvas <select id="reelResolution"><option value="1080x1920" ${res==='1080x1920'?'selected':''}>1080×1920</option><option value="2160x3840" ${res==='2160x3840'?'selected':''}>4K 9:16</option><option value="1920x1080" ${res==='1920x1080'?'selected':''}>1920×1080</option></select></label><label>Aspect <select id="reelAspect"><option value="9:16" ${ar==='9:16'?'selected':''}>9:16</option><option value="16:9" ${ar==='16:9'?'selected':''}>16:9</option><option value="1:1" ${ar==='1:1'?'selected':''}>1:1</option></select></label><label>Safe zones <input id="reelSafeZones" type="checkbox" ${project.safeZones!==false?'checked':''}></label><label>Auto-frame <input id="reelAutoFrame" type="checkbox" ${project.autoFrame!==false?'checked':''}></label></div><div class="timeline-toolbar"><button type="button" class="button" id="studioAddClip">${kvIcon('plus')}Clip</button><button type="button" class="button" id="studioTrimClip">${kvIcon('scissors')} Trim selected</button><button type="button" class="button" id="studioAddCaption">T Caption</button><button type="button" class="button" id="studioAiReel">${kvIcon('spark')} AI Storyboard</button><button type="button" class="button" id="studioPreviewReel">${kvIcon('play')} Preview</button><button type="button" class="primary" id="studioRenderReel">${kvIcon('reel')} Render MP4</button></div><div class="video-preview" id="reelPreview">${kvIcon('reel')} Reel Preview</div><div class="reel-track">${clips.map((c,i)=>`<div class="reel-clip" data-clip-index="${i}" draggable="true" style="width:${Math.max(80,Math.min(240,(c.duration||5)*20))}px"><b>#${c.order||i+1}</b><span>${c.duration||0}s</span><input data-clip-duration="${i}" type="number" min="1" value="${Number(c.duration||5)}"><small>${esc(c.role||'Clip')}</small></div>`).join('')||'<div class="canvas-empty">Add a clip to start the Reel timeline.</div>'}</div>${assets.length?`<label>Render source video<select id="reelSourceAsset">${assets.map(a=>`<option value="${esc(a.assetId||a.id)}">${esc(a.filename||a.id)}</option>`).join('')}</select></label>`:'<p class="muted">Upload a video asset to enable real Reel preview and MP4 rendering.</p>'}</div>`;
  box.querySelector('#studioAddClip')?.addEventListener('click',()=>{state.studioProject.clips=Array.isArray(state.studioProject.clips)?state.studioProject.clips:[];state.studioProject.clips.push({order:state.studioProject.clips.length+1,duration:5,role:'Clip',start:0,speed:1,keyframes:[{frame:0,easing:'linear'}],captions:[]});renderStudioWorkspace(type,state.studioProject)});box.querySelector('#reelFps')?.addEventListener('change',e=>{state.studioProject.fps=Number(e.target.value);renderStudioWorkspace(type,state.studioProject)});box.querySelector('#reelResolution')?.addEventListener('change',e=>state.studioProject.resolution=e.target.value);box.querySelector('#reelAspect')?.addEventListener('change',e=>state.studioProject.aspectRatio=e.target.value);box.querySelector('#reelSafeZones')?.addEventListener('change',e=>state.studioProject.safeZones=e.target.checked);box.querySelector('#reelAutoFrame')?.addEventListener('change',e=>state.studioProject.autoFrame=e.target.checked);
  box.querySelectorAll('[data-clip-duration]').forEach(i=>i.oninput=e=>{state.studioProject.clips[Number(i.dataset.clipDuration)].duration=Math.max(1,Number(e.target.value||1))});
  box.querySelector('#studioTrimClip')?.addEventListener('click',()=>{const c=state.studioProject.clips?.[0];if(c){c.duration=Math.max(1,(Number(c.duration)||5)-1);renderStudioWorkspace(type,state.studioProject)}});
  box.querySelector('#studioPreviewReel')?.addEventListener('click',()=>{const a=assets[0];if(!a){showToast('Upload a video asset first.');return}const v=document.createElement('video');v.controls=true;v.playsInline=true;v.src='/api/media/assets/'+encodeURIComponent(a.assetId||a.id);const host=document.getElementById('reelPreview');host.innerHTML='';host.appendChild(v);});
  box.querySelector('#studioRenderReel')?.addEventListener('click',async()=>{const assetId=box.querySelector('#reelSourceAsset')?.value;if(!assetId){showToast('Upload a video asset first.');return}const c=state.studioProject.clips?.[0]||{start:0,duration:5};try{const r=await getJSON('/api/media/video/render',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({clips:[{assetId,start:Number(c.start||0),duration:Number(c.duration||5)}]})});state.editorMedia.push(r.asset);document.getElementById('studioStatus').textContent='Reel MP4 rendered successfully. Attach/save it before publishing.';renderStudioWorkspace(type,state.studioProject)}catch(e){showToast(e.message)}});
 }else{
  const outline=Array.isArray(project.outline)?project.outline:[];box.innerHTML=`<div class="studio-grid"><div><strong>Story outline</strong><ol>${outline.map(v=>`<li>${esc(v)}</li>`).join('')||'<li class="muted">No outline yet.</li>'}</ol><button type="button" class="button" id="studioAddOutline">+ Add outline point</button><button type="button" class="button" id="studioAiMapper">AI Story Map</button></div><div><strong>Writing workflow</strong><p class="muted">Rich text, voice-to-write, translation and AI assistance remain advisory. Nothing publishes without creator action.</p></div></div>`;box.querySelector('#studioAddOutline')?.addEventListener('click',()=>{state.studioProject.outline=Array.isArray(state.studioProject.outline)?state.studioProject.outline:[];state.studioProject.outline.push('New story beat');renderStudioWorkspace(type,state.studioProject)});box.querySelector('#studioAiMapper')?.addEventListener('click',()=>runBoundedAiEndpoint('/api/ai/story-mapper',{premise:(state.studioProject.outline||[]).join(' · ')||document.getElementById('editorTitle')?.value||x('currentStoryPremise'),branches:3}));
 }
 box.querySelector('#studioAddPage')?.addEventListener('click',()=>{state.studioProject.pages=Array.isArray(state.studioProject.pages)?state.studioProject.pages:[];state.studioProject.pages.push({page:state.studioProject.pages.length+1,panels:[]});state.studioPageIndex=state.studioProject.pages.length-1;renderStudioWorkspace(type,state.studioProject)});
 box.querySelector('#studioAddPanel')?.addEventListener('click',()=>{state.studioProject.pages=state.studioProject.pages?.length?state.studioProject.pages:[{page:1,panels:[]}];state.studioProject.pages[state.studioPageIndex||0].panels.push({scene:'New scene',dialogue:'',x:5,y:5,w:48,h:44});renderStudioWorkspace(type,state.studioProject)});
 box.querySelector('#studioAddDialogue')?.addEventListener('click',()=>{const pg=state.studioProject.pages?.[state.studioPageIndex||0];if(!pg?.panels?.length){showToast('Add a panel first');return}pg.panels[pg.panels.length-1].dialogue='Dialogue';renderStudioWorkspace(type,state.studioProject)});box.querySelector('#studioAddLayer')?.addEventListener('click',()=>{const pg=state.studioProject.pages?.[state.studioPageIndex||0];if(!pg)return;pg.layers=Array.isArray(pg.layers)?pg.layers:[];pg.layers.push({name:`Layer ${pg.layers.length+1}`,visible:true,locked:false,blend:'normal'});document.getElementById('studioStatus').textContent=`Layer ${pg.layers.length} added. Save Studio Project.`;});
 box.querySelector('#studioAddCaption')?.addEventListener('click',()=>{state.studioProject.captions=Array.isArray(state.studioProject.captions)?state.studioProject.captions:[];state.studioProject.captions.push({text:'Caption',start:0,duration:3});renderStudioWorkspace(type,state.studioProject)});
 box.querySelector('#studioAiVisual')?.addEventListener('click',()=>runStudioAI('comic','Create a concrete visual comic page layout proposal based on the current panels, scene descriptions and dialogue. Return panel ordering, composition and readability guidance for creator approval.'));
 box.querySelector('#studioAiAudio')?.addEventListener('click',()=>runStudioAI('audio','Create a concrete FM/audio episode script and pacing proposal based on the current episode and segments. Return segment and narration guidance for creator approval.'));
 box.querySelector('#studioAiReel')?.addEventListener('click',()=>runStudioAI('reel','Create a concrete 2-minute Reel storyboard with shot sequence, timing, captions and audio guidance based on the current clips. Return storyboard guidance for creator approval.'));
 box.querySelector('#studioExportComic')?.addEventListener('click',()=>{const canvas=document.createElement('canvas');canvas.width=1200;canvas.height=800;const ctx=canvas.getContext('2d');ctx.fillStyle='#fff';ctx.fillRect(0,0,canvas.width,canvas.height);(state.studioProject.pages?.[state.studioPageIndex||0]?.panels||[]).forEach((pn,i)=>{const x=(pn.x||0)*12,y=(pn.y||0)*8,w=(pn.w||48)*12,h=(pn.h||44)*8;ctx.strokeRect(x,y,w,h);ctx.fillText(`Panel ${i+1}`,x+10,y+20);ctx.fillText(String(pn.dialogue||''),x+10,y+45)});const a=document.createElement('a');a.download='katha-vistaar-comic-page.png';a.href=canvas.toDataURL('image/png');a.click()});
}

async function loadCreatorLimitsHint(){try{const d=await getJSON('/api/creator/limits');const l=d.limits.defaults;const el=document.getElementById('formatHint');if(el)el.textContent=`Story ${l.story_words_per_part.toLocaleString()} words/part · Reel ${Math.round(l.reel_duration_seconds/60)} min · Video ${Math.round(l.video_upload_duration_seconds/60)} min · Photos ${l.photos_per_part}/part · Comic ${l.comic_generated_images_per_part}/part · PDF ${Math.round(l.pdf_upload_bytes/1024/1024)} MB`; }catch{}}

function editor(){
 if(!state.user)return page(x('creator'),loginGate());
 return page(x('create'),`<form id="editorForm" class="editor card">
  <div class="editor-top"><input id="editorTitle" placeholder="${t('draftTitle')}" required><span id="saveState" class="save-state">${x('autosave')}</span></div>
  <div class="format-studio-grid">
   <section><div class="toolbar"><button type="button" data-cmd="bold"><b>B</b></button><button type="button" data-cmd="italic"><i>I</i></button><button type="button" data-cmd="underline"><u>U</u></button><button type="button" data-cmd="insertUnorderedList">• List</button><button type="button" data-cmd="formatBlock" data-value="h2">H2</button><button type="button" data-cmd="formatBlock" data-value="blockquote">❝</button><button type="button" data-cmd="undo">↶</button><button type="button" data-cmd="redo">↷</button></div>
   <div id="editorBody" class="rich-editor" contenteditable="true" data-placeholder="${t('draftContent')}"></div></section>
   <aside class="creator-format-panel"><strong>${x('coreFormats')}</strong><p class="muted">${x('creatorAccess')}</p><label>${x('contentType')}<select id="editorType"><option value="story">${x('stories')}</option><option value="comic">${x('comic')}</option><option value="reel">${x('reel')}</option><option value="audio">${x('audio')}</option></select></label><label>${workTypesLabel()}<select id="editorWorkType"></select></label><div id="formatHint" class="notice"></div></aside>
  </div>
  ${studioPanel('story')}
  <section class="media-attach card"><div class="section-heading"><div><h3>${kvIcon('comic')}${kvIcon('audio')}${kvIcon('reel')}${x('mediaRights')}</h3><p class="muted">${x('creatorAccess')} · ${x('aiReview')}</p></div></div>
   <div class="media-attach-row"><input id="editorMediaFile" type="file" accept="audio/mpeg,audio/wav,audio/mp4,audio/aac,audio/ogg,audio/opus,audio/flac,video/mp4,video/webm,video/quicktime,video/x-matroska,video/x-m4v,image/png,image/jpeg,image/webp,image/gif,application/pdf" multiple><button type="button" class="button" id="editorMediaUpload">${x('save')}</button></div>
   <div id="editorMediaList" class="media-attachment-list"></div><div id="editorMediaStatus" class="result"></div>
  </section>
  <div class="card creator-ai-panel"><div class="section-heading ai-panel-heading"><div><strong>${kvIcon('spark')} ${x('aiCreatorTools')}</strong><p class="muted">Internal-first AI tools appear only for the selected creation format.</p></div><span class="service-badge">Internal AI ON</span></div><div class="ai-icon-rail" aria-label="Creator AI tools"><button type="button" class="ai-icon-button" id="creatorAiSuggest" title=x('aiSuggestion') aria-label=x('aiSuggestion')>${kvIcon('spark')}<span>Suggest</span></button><button type="button" class="ai-icon-button" id="creatorAiPlan" title=x('aiVerification') aria-label=x('aiVerification')>${kvIcon('shield')}<span>Check</span></button><button type="button" class="ai-icon-button" id="creatorAiGenerate" title=x('createDraftWithAi') aria-label=x('createDraftWithAi')>${kvIcon('spark')}<span>Create</span></button><button type="button" class="ai-icon-button" id="voiceDictate" title=x('speakToWrite') aria-label=x('speakToWrite')>${kvIcon('audio')}<span>Voice</span></button><button type="button" class="ai-icon-button" id="characterArchitectAssist" title="${x('aiCharacter')}" aria-label="${x('aiCharacter')}">${kvIcon('profile')}<span>${x('aiCharacter')}</span></button><button type="button" class="ai-icon-button" id="comicIllustratorAssist" hidden title=x('comicAiPanels') aria-label=x('comicAiPanels')>${kvIcon('comic')}<span>Panels</span></button><button type="button" class="ai-icon-button" id="audioPacingAssist" hidden title=x('audioAiPacing') aria-label=x('audioAiPacing')>${kvIcon('waveform')}<span>Pacing</span></button><button type="button" class="ai-icon-button" id="storyboardAssist" hidden title="${x('aiStoryboard')}" aria-label="${x('aiStoryboard')}">${kvIcon('folder')}<span>Storyboard</span></button><button type="button" class="ai-icon-button" id="dialogueArchitectAssist" hidden title="${x('aiDialogueArchitect')}" aria-label="${x('aiDialogueArchitect')}">${kvIcon('message')}<span>Dialogue</span></button><button type="button" class="ai-icon-button" id="storyMapAssist" title="${x('aiStoryMap')}" aria-label="${x('aiStoryMap')}">${kvIcon('insights')}<span>Map</span></button></div><div id="creatorAiOutput" class="muted" aria-live="polite"></div></div>
  <div class="editor-bottom"><label>${t('category')}<input id="editorCategory"></label><label>${x('seriesName')}<input id="editorSeries"></label><label>${x('part')}<input id="editorPart" type="number" min="1" value="1"></label><label>${x('summary')}<input id="editorSummary"></label><label>${x('cover')}<input id="editorCover" type="url"></label><label><input id="rightsConfirmed" type="checkbox"> ${x('rights')}</label><label><input id="mediaRightsConfirmed" type="checkbox"> ${x('mediaRights')}</label></div>
  <div class="notice">${kvIcon('shield')}${x('aiReview')}: ${x('policy')}</div>
  <div class="button-row"><button type="button" class="button" data-save-editor>${x('save')}</button><button type="button" class="button" data-preview-editor>${x('preview')}</button><button type="button" class="primary" data-publish-editor>${x('publish')}</button><button type="button" class="button" data-schedule-editor>${x('schedule')}</button></div>
  <div id="editorStatus" class="result"></div>
 </form>`)
}
function publicProfilePage(){return page(x('profile'),`<div id="publicProfilePage" class="public-profile-page"><div class="kv30b-profile-skeleton card"><span class="skeleton-circle"></span><div class="skeleton-lines"><i></i><i></i><i></i></div></div></div>`)}
async function loadPublicProfile(){const uid=new URLSearchParams(location.search).get('userId');const box=document.getElementById('publicProfilePage');if(!box||!uid)return;if(state.user&&uid===state.user.id){navigate('account');return}try{const d=await getJSON('/api/profile/public?userId='+encodeURIComponent(uid));const p=d.profile||{};const avatar=p.profilePhoto?`<img class="profile-avatar-large" src="${esc(p.profilePhoto)}" alt="${esc(p.username)}">`:`<div class="profile-avatar-large avatar-fallback">${esc((p.name||p.username||'U').slice(0,1).toUpperCase())}</div>`;const actions=p.id!=='system'?(state.user?`<button type="button" class="primary" id="publicProfileFollow">${d.following?'✓ '+x('following'):'＋ '+x('followAuthor')}</button><button type="button" class="button" id="publicProfileSubscribe">${d.subscribed?'✓ Author Subscribed':x('authorSubscription')}</button>${d.canMessage?`<button type="button" class="button" id="publicProfileMessage">${kvIcon('message')} Message</button>`:''}`:`<button type="button" class="primary" data-open-login>${t('login')} · ${x('followAuthor')}</button>`):'';box.innerHTML=`<section class="profile-dashboard card public-profile-card"><div class="profile-top">${avatar}<div class="profile-main"><span class="eyebrow">${x('profile')}</span><h1>${esc(p.name||p.username)}</h1><p class="muted">@${esc(p.username)} · ${esc(p.role||'user')}${p.verified?' · ✓ Verified':''}</p><p>${esc(p.bio||'')}</p></div><div class="button-row profile-actions">${actions}</div></div><div class="profile-stats"><div><strong>${Number(p.followers||0).toLocaleString()}</strong><span>${x('followers')}</span></div><div><strong>${Number(p.following||0).toLocaleString()}</strong><span>${x('following')}</span></div><div><strong>${(d.works||[]).length}</strong><span>${x('myWorks')}</span></div></div></section><section class="section-block"><div class="section-heading"><div><span class="eyebrow">${x('myWorks')}</span><h2>${x('myWorks')}</h2></div></div><div id="publicProfileWorks" class="content-grid"></div></section>`;const w=document.getElementById('publicProfileWorks');if(w)w.innerHTML=(d.works||[]).map(contentCard).join('')||`<div class="empty card">No public works yet.</div>`;bindContentButtons();box.querySelectorAll('[data-open-login]').forEach(b=>b.onclick=openLogin);const fb=document.getElementById('publicProfileFollow');if(fb)fb.onclick=async()=>{try{const r=await getJSON('/api/follows',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({authorId:p.id,following:!d.following})});d.following=r.following;fb.textContent=d.following?'✓ '+x('following'):'＋ '+x('followAuthor')}catch(e){showToast(humanAuthError(e.message||'Unable to update follow status.'),'error')}};const sb=document.getElementById('publicProfileSubscribe');if(sb)sb.onclick=()=>{if(d.subscribed){showToast('This paid author subscription is already active. Use Subscription & Billing to manage cancellation.');return}if(!state.user){openLogin();return}state.pendingSubscriptionPlan='author_subscription';state.pendingAuthorId=p.id;navigate('payments')};const mb=document.getElementById('publicProfileMessage');if(mb)mb.onclick=()=>navigate('messages');}catch(e){box.innerHTML=`<div class="card error"><h2>Profile unavailable</h2><p>${esc(e.message||'Unable to load this profile.')}</p></div>`}}

function changePasswordCard(){return `<article class="card"><h2>${kvIcon('lock')}${x('changePassword')}</h2><p class="muted">${x('oldPassword')} → ${x('newPassword')} → ${x('confirmNewPassword')}</p><form id="changePasswordForm" class="profile-form"><label>${x('username')}<input value="${esc(state.user?.userId||'')}" disabled></label><label>${x('oldPassword')}<div class="password-field"><input id="oldPassword" type="password" autocomplete="current-password" required><button type="button" class="button password-toggle" data-toggle-password="oldPassword">${x('showPassword')}</button></div></label><label>${x('newPassword')}<div class="password-field"><input id="newPassword" type="password" autocomplete="new-password" required><button type="button" class="button password-toggle" data-toggle-password="newPassword">${x('showPassword')}</button></div></label><label>${x('confirmNewPassword')}<div class="password-field"><input id="confirmNewPassword" type="password" autocomplete="new-password" required><button type="button" class="button password-toggle" data-toggle-password="confirmNewPassword">${x('showPassword')}</button></div></label><button class="primary" type="submit">${x('changePassword')}</button><div id="changePasswordStatus" class="result"></div></form></article>`}
function royaltyDetailsCard(){const locked=!!state.royaltyDetailsVerified;return `<article class="card"><h2>${kvIcon('coins')}${x('royaltyDetails')}</h2><p class="muted">${locked?x('royaltyLocked'):'Add your royalty/payment details. The mobile number entered here receives the verification OTP.'}</p>${locked?`<div id="royaltyLockedDetails" class="result">Verified details are on file.</div><button type="button" class="button" id="royaltyChangeRequest">Request change approval</button><div id="royaltyStatus" class="result"></div>`:`<form id="royaltyDetailsForm" class="profile-form"><label>${x('bankAccountNumber')}<input id="royaltyBankAccount" inputmode="numeric" required></label><label>${x('bankName')}<input id="royaltyBankName" required></label><label>${x('ifsc')}<input id="royaltyIfsc" required></label><label>${x('bankBranch')}<input id="royaltyBranch" required></label><label>${x('panNumber')}<input id="royaltyPan" required></label><label>${x('royaltyEmail')}<input id="royaltyEmail" type="email" required></label><label>${x('royaltyMobile')}<input id="royaltyMobile" inputmode="tel" required></label><button class="primary" type="submit">${x('verifyAndSave')}</button><div id="royaltyStatus" class="result"></div></form>`}</article>`}
async function initAccountSecurity(){try{const rd=await getJSON('/api/profile/royalty-details');state.royaltyDetailsVerified=!!rd.verified}catch(e){state.royaltyDetailsVerified=false}document.querySelectorAll('[data-toggle-password]').forEach(b=>b.onclick=()=>{const input=document.getElementById(b.dataset.togglePassword);if(!input)return;const show=input.type==='password';input.type=show?'text':'password';b.textContent=show?x('hidePassword'):x('showPassword')});document.getElementById('royaltyChangeRequest')?.addEventListener('click',async()=>{const out=document.getElementById('royaltyStatus');try{const r=await getJSON('/api/profile/royalty-details/change-request',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({})});out.textContent=`Ticket ${r.ticket?.id||''}: sent for administrator approval.`}catch(e){out.textContent=e.message}});const f=document.getElementById('changePasswordForm');if(f)f.onsubmit=async e=>{e.preventDefault();const out=document.getElementById('changePasswordStatus');try{const r=await getJSON('/api/auth/change-password',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({oldPassword:document.getElementById('oldPassword').value,newPassword:document.getElementById('newPassword').value,confirmPassword:document.getElementById('confirmNewPassword').value})});out.textContent=r.message||x('passwordChanged');f.reset()}catch(err){out.textContent=humanAuthError(err.code||err.message)}};const rf=document.getElementById('royaltyDetailsForm');if(rf)rf.onsubmit=async e=>{e.preventDefault();const out=document.getElementById('royaltyStatus');try{const r=await getJSON('/api/profile/royalty-details',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({bankAccountNumber:document.getElementById('royaltyBankAccount').value,bankName:document.getElementById('royaltyBankName').value,ifsc:document.getElementById('royaltyIfsc').value,bankBranch:document.getElementById('royaltyBranch').value,pan:document.getElementById('royaltyPan').value,email:document.getElementById('royaltyEmail').value,mobile:document.getElementById('royaltyMobile').value})});const m=await openOtpDialog({target:r.target,purpose:r.purpose,sendPath:'/api/auth/resend-otp',sendBody:{target:r.target,purpose:r.purpose},message:x('otpSent'),lastResponse:r});if(!m)return;out.textContent=m.verified?'Verified and locked.':x('royaltyLocked')}catch(err){out.textContent=humanAuthError(err.code||err.message)}}}
function account(){if(!state.user)return page(t('account'),loginGate());const avatar=state.user.profilePhoto?`<img class="profile-avatar-large" src="${esc(state.user.profilePhoto)}" alt="${esc(state.user.username)}">`:`<div class="profile-avatar-large avatar-fallback">${esc((state.user.name||state.user.username||'U').slice(0,1).toUpperCase())}</div>`;return page(x('profile'),`${adStrip('profile')}<section class="profile-dashboard card"><div class="profile-top">${avatar}<div class="profile-main"><span class="eyebrow">${x('profile')}</span><h1>${esc(state.user.name||state.user.username)}</h1><p class="muted">@${esc(state.user.username)}</p><p>${x('privacyNote')}</p></div><div class="button-row">${routeLink('settings',x('settings'),'button')}<button type="button" class="button" id="enablePasskey">Use fingerprint / face / passkey</button>${routeLink('write',x('myWriting'),'primary button')}</div></div><div class="profile-stats"><div><strong>${state.user.followers||0}</strong><span>${x('followers')}</span></div><div><strong>${state.user.following||0}</strong><span>${x('following')}</span></div><div><strong>${state.myContent?.length||0}</strong><span>${x('myWorks')}</span></div></div></section><div class="tabs profile-tabs" role="tablist"><button type="button" class="tab active" data-profile-tab="works" aria-selected="true">${x('myWorks')}</button><button type="button" class="tab" data-profile-tab="posts" aria-selected="false">${x('posts')}</button><button type="button" class="tab" data-profile-tab="updates" aria-selected="false">${x('updates')}</button></div><div id="profileTabPanel" class="profile-tab-panel card"><strong>${x('myWorks')}</strong><p class="muted">${t('writeText')}</p>${routeLink('write',x('open'),'button')}</div><div class="grid"><article class="card"><h2>${kvIcon('write')}${x('myWorks')}</h2><p>${t('writeText')}</p>${routeLink('write',x('open'),'button')}</article><article class="card"><h2>${kvIcon('spark')}${x('subscription')}</h2><div class="subscription-list">${subscriptionRow('comicReader',x('comicReader'))}${subscriptionRow('audioReader',x('audioReader'))}${subscriptionRow('reelReader',x('reelReader'))}</div></article><article class="card"><h2>${kvIcon('coins')}${x('earnings')}</h2><p>${x('followers')}: ${state.user.followers||0}</p></article><article class="card"><h2>${kvIcon('lock')}${x('privateProfile')}</h2><p><strong>${x('mobile')}:</strong> <span id="profileMobile"></span></p><p><strong>${x('email')}:</strong> <span id="profileEmail"></span></p><p><strong>${x('verified')}:</strong> <span id="verificationState"></span></p></article></div><section class="card"><div class="section-heading"><h2>${x('profile')} ${x('settings')}</h2>${routeLink('settings',x('settings'),'button')}</div><form id="profileForm" class="profile-form"><label>${x('username')}<input value="${esc(state.user.username)}" disabled></label><label>${x('name')}<input id="profileName"></label><label>${x('location')}<input id="profileLocation"></label><label>${x('address')}<input id="profileAddress"></label><label>${x('dob')}<input id="profileDob" type="date"></label><label>${x('gender')}<input id="profileGender"></label><label>${x('profilePhoto')}<input id="profilePhoto" placeholder="https://..."></label><button class="primary" type="submit">${x('saveProfile')}</button></form><div id="profileStatus" class="result"></div></section>${changePasswordCard()}${royaltyDetailsCard()}${state.user.locked?`<div class="notice">🔒 Account locked. ${esc(state.user.appealStatus||'')}<textarea id="apology" placeholder="Apology / appeal"></textarea><button class="primary" data-appeal>Submit appeal</button></div>`:''}<button class="link-button" data-logout>${x('logout')}</button>`)}
function settings(){
 const publicBasic=`<div class="kv30b-settings-grid"><article class="card settings-card kv30b-setting-card"><div class="settings-card-head"><span class="settings-icon">${kvIcon('palette')}</span><div><h2>${x('appearance')}</h2><p class="muted">Theme, font and reading comfort.</p></div></div><div class="kv30b-setting-row"><span>Theme</span><select id="settingTheme"><option value="system">System</option><option value="light">Light</option><option value="dark">Dark</option></select></div><div class="kv30b-setting-row"><span>Font</span><select id="settingFont"><option value="system">System</option><option value="serif">Serif</option><option value="sans">Sans</option></select></div><div class="kv30b-setting-row"><span>${x('fontSize')}</span><input id="settingFontSize" type="range" min="14" max="22" value="16"></div><div class="settings-preview">Aa · ${x('preview')}</div></article>
 <article class="card settings-card kv30b-setting-card"><div class="settings-card-head"><span class="settings-icon">${kvIcon('globe')}</span><div><h2>${t('language')}</h2><p class="muted">23 separately supported languages.</p></div></div><button class="button" id="settingsLanguage">${t('selectLanguage')}</button><label>${t('readingLanguage')}<select id="readingLanguage"></select></label></article>
 <article class="card settings-card kv30b-setting-card"><div class="settings-card-head"><span class="settings-icon">${kvIcon('book')}</span><div><h2>Reading & Media</h2><p class="muted">Control playback and data use.</p></div></div><label class="toggle-row"><input type="checkbox" id="prefAutoplay"> <span>Autoplay media</span></label><label class="toggle-row"><input type="checkbox" id="prefDataSaver"> <span>Data saver</span></label></article>
 <article class="card settings-card kv30b-setting-card"><div class="settings-card-head"><span class="settings-icon">${kvIcon('shield')}</span><div><h2>Device & Media Access</h2><p class="muted">Keyboard and normal browser interaction are system defaults. Other capabilities are user-controlled and requested by the browser/OS when needed.</p></div></div><div id="deviceAccessSettings"><div class="muted">Loading access settings…</div></div></article>
 <article class="card settings-card kv30b-setting-card"><div class="settings-card-head"><span class="settings-icon">${kvIcon('spark')}</span><div><h2>${x('aiHelp')}</h2><p class="muted">Get safe, contextual internal AI guidance.</p></div></div>${routeLink('help',kvIcon('spark')+' Open AI Help','button')}</article>
 <article class="card settings-card kv30b-setting-card"><div class="settings-card-head"><span class="settings-icon">${kvIcon('help')}</span><div><h2>${t('help')}</h2><p class="muted">Help, tickets and policy guidance.</p></div></div>${routeLink('help',kvIcon('help')+' '+t('help'),'button')}</article></div>`;
 if(!state.user)return page(t('settings'),`<section class="kv30b-settings-intro"><span class="eyebrow">Katha Vistaar</span><h1>${x('appSettings')}</h1><p>${x('publicSettingsHelp')||'Basic appearance, language and reading settings are available without login.'}</p></section>${publicBasic}<div class="card login-settings-note kv30b-login-note"><div><strong>Account settings</strong><p class="muted">Login is required for private profile, notifications, security and account controls.</p></div><div class="button-row"><button class="primary" data-open-login>${t('login')}</button><button class="button" data-register>${x('createAccount')}</button></div></div>`);
 return page(t('settings'),`${publicBasic}<div class="kv30b-settings-grid"><article class="card settings-card kv30b-setting-card"><div class="settings-card-head"><span class="settings-icon">${kvIcon('bell')}</span><div><h2>${x('notificationPreferences')}</h2><p class="muted">App, web and email delivery.</p></div></div><label class="toggle-row"><input type="checkbox" id="prefInApp" checked><span>${x('inApp')}</span></label><label class="toggle-row"><input type="checkbox" id="prefWeb" checked><span>${x('webNotification')}</span></label><label class="toggle-row"><input type="checkbox" id="prefEmail" checked><span>${x('emailNotification')}</span></label><label class="toggle-row"><input type="checkbox" id="prefComment" checked><span>${x('comments')}</span></label><label class="toggle-row"><input type="checkbox" id="prefFollow" checked><span>${x('follows')}</span></label><label class="toggle-row"><input type="checkbox" id="prefAuthor" checked><span>${x('authorUpdates')}</span></label><button class="primary" id="saveNotificationPreferences">${x('saveNotificationSettings')}</button></article><article class="card settings-card kv30b-setting-card"><div class="settings-card-head"><span class="settings-icon">${kvIcon('lock')}</span><div><h2>Account & Security</h2><p class="muted">Manage your authenticated account safely.</p></div></div><div class="kv30b-action-list"><a href="/account-settings" data-route="account-settings">${kvIcon('profile')}<span>Profile & account</span>${kvIcon('chevron')}</a><a href="/phone-settings" data-route="phone-settings">${kvIcon('phone')}<span>Verified contacts</span>${kvIcon('chevron')}</a><button type="button" id="enablePasskey">${kvIcon('fingerprint')}<span>Fingerprint / Face / Passkey</span>${kvIcon('chevron')}</button><a href="/settings/security" data-route="security">${kvIcon('lock')}<span>${x('accountSecurity')}</span>${kvIcon('chevron')}</a></div></article><article class="card settings-card kv30b-setting-card"><div class="settings-card-head"><span class="settings-icon">${kvIcon('shield')}</span><div><h2>Privacy & Content</h2><p class="muted">Visibility and safety controls follow policy.</p></div></div>${routeLink('privacy',kvIcon('shield')+' '+x('privacyContent'),'button')}${routeLink('accessibility',kvIcon('accessibility')+' '+x('accessibilitySettings'),'button')}${routeLink('interests',kvIcon('spark')+' Interest Preferences','button')}</article><article class="card settings-card kv30b-setting-card"><div class="settings-card-head"><span class="settings-icon">${kvIcon('insights')}</span><div><h2>${x('analytics')}</h2><p class="muted">${x('realMetrics')}</p></div></div><div class="kv30b-action-list">${routeLink('analytics',x('analytics'),'button')}${routeLink('regional-analytics','Regional Activity','button')}${routeLink('recommendations',x('forYou'),'button')}${routeLink('events',x('eventsCalendar'),'button')}${routeLink('creator-tiers',x('creatorTiers'),'button')}</div></article></div>`);
}
function interestsPage(){if(!state.user)return loginGate();const choices=['mythology','sci-fi','historical-fantasy','romance','crime','horror','slice-of-life','poetry','audio-dramas','motion-comics'];return page('Interest Preferences',`<section class="card"><span class="eyebrow">Katha Vistaar</span><h1>${kvIcon('spark')} Interest Preferences</h1><p class="muted">Choose interests to improve internal recommendations.</p><div id="interestChoices" class="category-chip-row">${choices.map(c=>`<button type="button" class="category-chip" data-interest="${c}">${c}</button>`).join('')}</div><button type="button" class="primary" id="saveInterests">Save interests</button><div id="interestStatus" class="result"></div></section>`)}
function masterCommandPage(){return page('Command Center',`<section class="kv30b-audit-head"><div><span class="kv30b-audit-kicker">MASTER ADMIN · LIVE CONTROL PLANE</span><h1>${kvIcon('dashboard')} Command Center</h1><p>High-density operational telemetry from authoritative internal state. Unverified external claims are not displayed as PASS.</p></div><div class="kv30b-audit-actions">${routeLink('ai-dashboard','AI Workbench','button')}${routeLink('security-audit','Security Audit','button')}</div></section><div id="masterCommand" class="kv30b-audit-grid"></div>`)}
function securityAuditPage(){return page('Security Audit Ledger',`<section class="card"><span class="eyebrow">Master Admin</span><h1>${kvIcon('shield')} Security Audit Ledger</h1><p class="muted">Security AI has highest defensive priority. Analyze a message/activity before allowing or escalating it.</p><form id="securityAiForm" class="profile-form"><label>Content / activity<textarea id="securityAiInput" required maxlength=6000></textarea></label><button class="primary" type="submit">Run Security AI</button><div id="securityAiResult" class="result"></div></form><hr><div id="securityAudit"></div></section>`)}
async function initInterests(){const box=document.getElementById('interestChoices');if(!box)return;try{const d=await getJSON('/api/preferences/interests');const set=new Set(d.interests||[]);box.querySelectorAll('[data-interest]').forEach(b=>b.classList.toggle('active',set.has(b.dataset.interest)));box.querySelectorAll('[data-interest]').forEach(b=>b.onclick=()=>b.classList.toggle('active'));document.getElementById('saveInterests').onclick=async()=>{const interests=[...box.querySelectorAll('[data-interest].active')].map(b=>b.dataset.interest);const r=await getJSON('/api/preferences/interests',{method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify({interests})});document.getElementById('interestStatus').textContent=`Saved ${r.interests.length} interests.`}}catch(e){document.getElementById('interestStatus').textContent=e.message}}
async function loadMasterCommand(){
 const b=document.getElementById('masterCommand');if(!b)return;
 try{
  const [d,m,lr]=await Promise.all([getJSON('/api/admin/command-center'),getJSON('/api/admin/command-center/matrix'),getJSON('/api/language-registry')]);
  const events=(d.telemetry.latest||[]).map(e=>`<div class="kv30b-telemetry-row"><span><b>${esc(e.action||'event')}</b><small>${esc(e.actor||'system')} · ${esc(e.resourceType||'')}</small></span><span class="kv30b-state">${esc(e.result||'RECORDED')}</span></div>`).join('')||'<div class="kv30b-empty">No telemetry events recorded.</div>';
  const langs=(m.languages.rows||[]).map(l=>`<span class="kv30b-chip"><b>${esc(l.code)}</b> ${esc(l.name)}</span>`).join('');
  const aiRows=(m.ais.rows||[]).map(x=>`<tr><td><code>${esc(x.id)}</code></td><td>${esc(x.tier)}</td><td>${esc(x.responsibility)}</td><td>${esc((x.pipeline||[]).join(' · '))}</td><td>${x.active?'PASS':'REVIEW'}</td></tr>`).join('');
  const futureRows=(lr.languages||[]).filter(x=>x.source!=='canonical').map(x=>`<div class="language-governance-row"><span><b>${esc(x.code)}</b> ${esc(x.nativeName||x.name)}</span><span class="pill">${esc(x.status||'proposed')}</span></div>`).join('')||'<p class="muted">No staged future languages.</p>';
  b.innerHTML=`<article class="kv30b-card kv30b-span-2"><div class="kv30b-card-head"><div><span class="kv30b-code">SYSTEM / AUDIT</span><h3>Live Verification Plane</h3></div><span class="kv30b-status kv30b-status-pass">● INTERNAL LEDGER</span></div><div class="kv30b-metrics"><div><strong>${d.telemetry.events}</strong><span>Audit events</span></div><div><strong>${m.ais.count}</strong><span>Registered AIs</span></div><div><strong>${m.languages.count}</strong><span>Contract languages</span></div><div><strong>${d.ai.active}</strong><span>Active AIs</span></div></div></article><article class="kv30b-card kv30b-span-2"><div class="kv30b-card-head"><div><span class="kv30b-code">PART 3 / CURRENT REGISTRY DATA</span><h3>Language & Model Pipeline Matrix</h3><small>Source: current internal AI and language registries</small></div><span class="kv30b-status kv30b-status-pass">● ${m.ais.count} AI / ${m.languages.count} LANG</span></div><div class="kv30b-chip-grid">${langs}</div><div class="kv30b-table-wrap"><table class="kv30b-table"><thead><tr><th>AI</th><th>Tier</th><th>Responsibility</th><th>Pipeline</th><th>State</th></tr></thead><tbody>${aiRows}</tbody></table></div></article><article class="kv30b-card kv30b-span-2 language-governance-card"><div class="kv30b-card-head"><div><span class="kv30b-code">GOVERNED LOCALIZATION</span><h3>New-language lifecycle</h3><small>Proposal → evidence → Master Admin approval → enable. A registry entry alone never enables a language.</small></div><span class="kv30b-status ${lr.enabledCount>=23?'kv30b-status-pass':'kv30b-status-critical'}">● ${lr.enabledCount} ENABLED / 23 REQUIRED</span></div><div class="language-governance-grid"><label>Code<input id="newLanguageCode" maxlength="7" placeholder="e.g. kok-XX"></label><label>English name<input id="newLanguageName" maxlength="80" placeholder="Language name"></label><label>Native name<input id="newLanguageNativeName" maxlength="120" placeholder="Native name"></label><label>ISO 639-3<input id="newLanguageIso3" maxlength="3" placeholder="abc"></label></div><div class="button-row"><button type="button" class="primary" id="proposeLanguage">Stage language</button><button type="button" class="button" id="refreshLanguageGovernance">Refresh</button></div><div class="language-governance-evidence"><label><input type="checkbox" id="languageUiCoverage"> UI strings reviewed</label><label><input type="checkbox" id="languageAiCoverage"> AI contract/runtime reviewed</label><label><input type="checkbox" id="languageTtsCoverage"> TTS coverage verified</label><label><input type="checkbox" id="languageTestCoverage"> Deterministic tests added/passed</label><label><input type="checkbox" id="languageGovernanceReview"> Governance review complete</label></div><div class="button-row"><button type="button" class="button" id="recordLanguageEvidence">Record evidence</button><button type="button" class="button" id="approveLanguage">Approve</button><button type="button" class="primary" id="enableLanguage">Enable</button></div><div id="languageGovernanceRows">${futureRows}</div><p id="languageGovernanceResult" class="muted" aria-live="polite"></p></article><article class="kv30b-card"><div class="kv30b-card-head"><div><span class="kv30b-code">FINANCE</span><h3>Ledger</h3></div></div><div class="kv30b-list"><div><span>Coins in balances</span><b>${d.financial.coins}</b></div><div><span>Ledger transactions</span><b>${d.financial.transactions}</b></div><div><span>Subscription payments</span><b>${d.financial.subscriptions}</b></div></div></article><article class="kv30b-card"><div class="kv30b-card-head"><div><span class="kv30b-code">RISK / GATES</span><h3>Critical Alerts</h3></div><span class="kv30b-status ${d.alerts.lockedUsers||d.alerts.openTickets||d.alerts.pendingModeration?'kv30b-status-critical':'kv30b-status-pass'}">${d.alerts.lockedUsers||d.alerts.openTickets||d.alerts.pendingModeration?'● REVIEW':'● CLEAR'}</span></div><div class="kv30b-list"><div><span>Locked accounts</span><b>${d.alerts.lockedUsers}</b></div><div><span>Open tickets</span><b>${d.alerts.openTickets}</b></div><div><span>Pending moderation</span><b>${d.alerts.pendingModeration}</b></div></div></article><article class="kv30b-card kv30b-span-2"><div class="kv30b-card-head"><div><span class="kv30b-code">TELEMETRY / LAST 20</span><h3>Audit Stream</h3></div><button class="button" data-route="security-audit">Inspect Trace</button></div><div class="kv30b-telemetry">${events}</div></article>`;
  const code=()=>String(document.getElementById('newLanguageCode')?.value||'').trim().toLowerCase();
  const result=document.getElementById('languageGovernanceResult');
  document.getElementById('proposeLanguage')?.addEventListener('click',async()=>{try{const row=await getJSON('/api/admin/languages/propose',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({code:code(),name:document.getElementById('newLanguageName')?.value,nativeName:document.getElementById('newLanguageNativeName')?.value,iso639_3:document.getElementById('newLanguageIso3')?.value})});result.textContent=`Staged ${row.language.code}. Complete all five evidence gates before approval.`;loadMasterCommand()}catch(e){result.textContent=e.message||'Language proposal failed.'}});
  document.getElementById('recordLanguageEvidence')?.addEventListener('click',async()=>{try{const row=await getJSON(`/api/admin/languages/${encodeURIComponent(code())}/evidence`,{method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify({evidence:{uiCoverage:document.getElementById('languageUiCoverage')?.checked===true,aiCoverage:document.getElementById('languageAiCoverage')?.checked===true,ttsCoverage:document.getElementById('languageTtsCoverage')?.checked===true,testCoverage:document.getElementById('languageTestCoverage')?.checked===true,governanceReview:document.getElementById('languageGovernanceReview')?.checked===true}})});result.textContent=`Evidence recorded for ${row.language.code}. Status: ${row.language.status}.`;loadMasterCommand()}catch(e){result.textContent=e.message||'Evidence update failed.'}});
  document.getElementById('approveLanguage')?.addEventListener('click',async()=>{try{const row=await getJSON(`/api/admin/languages/${encodeURIComponent(code())}/approve`,{method:'POST'});result.textContent=`${row.language.code} approved. Enable it only after final deployment verification.`;loadMasterCommand()}catch(e){result.textContent=e.message||'Approval blocked until all evidence gates pass.'}});
  document.getElementById('enableLanguage')?.addEventListener('click',async()=>{try{const row=await getJSON(`/api/admin/languages/${encodeURIComponent(code())}/enable`,{method:'POST'});result.textContent=`${row.language.code} enabled.`;loadMasterCommand()}catch(e){result.textContent=e.message||'Enable blocked until Master Admin approval.'}});
  document.getElementById('refreshLanguageGovernance')?.addEventListener('click',loadMasterCommand);
 }catch(e){b.innerHTML=`<div class="kv30b-card kv30b-error">${esc(e.message)}</div>`}
}
async function loadSecurityAudit(){const form=document.getElementById('securityAiForm'),out=document.getElementById('securityAiResult');if(form&&out)form.onsubmit=async e=>{e.preventDefault();out.textContent='Security AI is analysing…';try{const r=await getJSON('/api/admin/ai/security-defense',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({content:document.getElementById('securityAiInput').value})});out.textContent=`Risk: ${r.assessment.risk} · Action: ${r.assessment.action} · Signals: ${(r.assessment.signals||[]).join(', ')||'none'}`;}catch(err){out.textContent=humanAuthError(err.code||err.message)}};const b=document.getElementById('securityAudit');if(!b)return;try{const d=await getJSON('/api/admin/security-audit');b.innerHTML=(d.events||[]).slice(0,100).map(e=>`<div class="service-row"><span><strong>${esc(e.action||'event')}</strong><small>${esc(e.actor||'system')} · ${esc(e.resourceType||'')}</small></span><span>${esc(e.result||'')}</span></div>`).join('')||'<p class="muted">No audit events yet.</p>'}catch(e){b.innerHTML=`<div class="card error">${esc(e.message)}</div>`}}
function aiWorkbenchProposal(){return `<article class="card"><h3>${x('aiProposal')}</h3><p class="muted">${x('governedLoop')}</p><form id="aiProposalForm" class="profile-form"><label>Summary<input id="aiProposalSummary" required maxlength=2000></label><label>Category<select id="aiProposalCategory"><option value="general">General</option><option value="design">Design</option><option value="software">Software</option><option value="security_policy">Security policy</option></select></label><button class="primary" type="submit">Create governed proposal</button><div id="aiProposalStatus" class="result"></div></form></article>`}
async function initAiWorkbench(){const sf=document.getElementById('aiSocialForm');if(sf)sf.onsubmit=async e=>{e.preventDefault();const out=document.getElementById('aiSocialStatus');try{const r=await getJSON('/api/ai/social-assistant',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({topic:document.getElementById('aiSocialTopic').value,platform:document.getElementById('aiSocialPlatform').value})});out.textContent=`Proposal ready: ${r.proposal.caption}`;}catch(err){out.textContent=err.message}};const f=document.getElementById('aiProposalForm');if(!f)return;f.onsubmit=async e=>{e.preventDefault();const out=document.getElementById('aiProposalStatus');try{const r=await getJSON('/api/admin/ai-workbench/proposals',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({summary:document.getElementById('aiProposalSummary').value,category:document.getElementById('aiProposalCategory').value,tests:['static','api','integration','runtime','regression']})});out.textContent=`${x('aiProposalCreated')} ${r.proposal.id}`;f.reset()}catch(e){out.textContent=e.message}}}
function analyticsPage(){if(!state.user)return loginGate();return page(x('analytics'),`<section class="kv30b-notification-head"><div><span class="eyebrow">Creator Studio</span><h1>${kvIcon('insights')} Analytics</h1><p>Real activity from your published and draft works. No fabricated demographic data.</p></div><div class="button-row">${routeLink('audience',x('audienceInsights'),'button')}${routeLink('performance',x('contentPerformance'),'button')}</div></section><div id="analyticsOverview" class="content-grid"><div class="card loading-card">Loading analytics…</div></div>`)}
function audiencePage(){if(!state.user)return loginGate();return page(x('audienceInsights'),`<section class="card"><span class="eyebrow">Creator Studio</span><h1>${kvIcon('profile')} Audience Insights</h1><p class="muted">Only metrics actually collected by Katha Vistaar are shown.</p><div id="audienceInsights" class="content-grid"></div></section>`)}
function performancePage(){if(!state.user)return loginGate();return page(x('contentPerformance'),`<section class="card"><span class="eyebrow">Creator Studio</span><h1>${kvIcon('insights')} Content Performance</h1><div id="performanceSelector"></div><div id="contentPerformance" class="content-grid"></div></section>`)}
function recommendationsPage(){if(!state.user)return loginGate();return page(x('forYou'),`<section class="kv30b-discover-head"><span class="eyebrow">Katha Vistaar</span><h1>${kvIcon('spark')} For You</h1><p>Internal ranking uses available engagement and your reading history. External AI is not required.</p></section><div id="recommendationGrid" class="content-grid"><div class="card loading-card">Loading recommendations…</div></div>`)}
function accessibilityPage(){return page(x('accessibilitySettings'),`<section class="card"><span class="eyebrow">Katha Vistaar</span><h1>${kvIcon('accessibility')} Accessibility Settings</h1><form id="accessibilityForm" class="profile-form"><label>Text size<select id="a11yTextSize"><option value="normal">Normal</option><option value="large">Large</option><option value="xlarge">Extra large</option></select></label><label>Contrast<select id="a11yContrast"><option value="standard">Standard</option><option value="high">High contrast</option><option value="grayscale">Grayscale</option></select></label><label class="toggle-row"><input type="checkbox" id="a11yReduceMotion"> Reduce motion</label><label class="toggle-row"><input type="checkbox" id="a11yCaptions"> Closed captions where available</label><button class="primary" type="submit">Save accessibility settings</button><div id="accessibilityStatus" class="result"></div></form></section>`)}
function privacyPage(){if(!state.user)return page(x('privacyContent'),loginGate());return page(x('privacyContent'),`<section class="card"><span class="eyebrow">Account</span><h1>${kvIcon('shield')} Privacy & Content</h1><form id="privacyForm" class="profile-form"><label>Profile visibility<select id="privacyProfile"><option value="public">Public</option><option value="followers">Followers</option></select></label><label class="toggle-row"><input type="checkbox" id="privacyPersonalization"> Allow personalized recommendations</label><label class="toggle-row"><input type="checkbox" id="privacyAnalytics"> Allow product analytics</label><button class="primary" type="submit">Save privacy settings</button><div id="privacyStatus" class="result"></div></form></section>`)}
function securityPage(){if(!state.user)return loginGate();return page(x('accountSecurity'),`<section class="card"><span class="eyebrow">Account</span><h1>${kvIcon('lock')} Account Security</h1><p>Session logout remains explicit; there is no arbitrary session timeout.</p><div class="button-row">${routeLink('account-settings',x('changePassword'),'button')}<button type="button" class="danger button" id="logoutAllDevices">Log out other sessions</button></div><div id="securityStatus" class="result"></div></section>`)}
async function loadAnalyticsOverview(){const b=document.getElementById('analyticsOverview');if(!b)return;try{const d=await getJSON('/api/analytics/overview');b.innerHTML=`<article class="card"><h3>30-Day Overview</h3><div class="stats-grid"><div><strong>${Number(d.summary.views).toLocaleString()}</strong><span>Views</span></div><div><strong>${Number(d.summary.likes).toLocaleString()}</strong><span>Likes</span></div><div><strong>${Number(d.summary.comments).toLocaleString()}</strong><span>Comments</span></div><div><strong>${Number(d.summary.followers).toLocaleString()}</strong><span>Followers</span></div></div></article><article class="card"><h3>Top Performing Content</h3>${d.topContent.map(c=>`<div class="service-row"><span><strong>${esc(c.title)}</strong><small>${esc(c.type)} · ${esc(c.workType||'')}</small></span><span>${Number(c.views).toLocaleString()} views</span></div>`).join('')||'<p class="muted">No creator content yet.</p>'}</article><article class="card"><h3>Format Mix</h3><div class="chips">${Object.entries(d.summary.byType).map(([k,v])=>`<span class="pill">${esc(k)}: ${v}</span>`).join('')}</div></article>`}catch(e){b.innerHTML=`<div class="card error">${esc(e.message)}</div>`}}
async function loadAudienceInsights(){const b=document.getElementById('audienceInsights');if(!b)return;try{const d=await getJSON('/api/analytics/audience');const peak=Object.entries(d.activeHours).sort((a,b)=>b[1]-a[1]).slice(0,5).filter(x=>x[1]>0);b.innerHTML=`<article class="card"><h3>Followers</h3><strong>${Number(d.followers).toLocaleString()}</strong></article><article class="card"><h3>Active Hours</h3>${peak.length?peak.map(([h,v])=>`<div class="service-row"><span>${String(h).padStart(2,'0')}:00</span><strong>${v}</strong></div>`).join(''):'<p class="muted">Activity history will appear as real events are collected.</p>'}</article><article class="card"><h3>Demographics</h3><p class="muted">Gender, age and location are not collected in this analytics layer, so no demographic numbers are fabricated.</p></article>`}catch(e){b.innerHTML=`<div class="card error">${esc(e.message)}</div>`}}
async function loadPerformance(){const b=document.getElementById('contentPerformance'),sel=document.getElementById('performanceSelector');if(!b||!sel)return;try{const mine=await getJSON('/api/my-content');const works=mine.content||[];sel.innerHTML=`<label>Select work<select id="performanceWork">${works.map(c=>`<option value="${esc(c.id)}">${esc(c.title)}</option>`).join('')}</select></label>`;const load=async()=>{const selected=document.getElementById('performanceWork').value;if(!selected){b.innerHTML='<div class="card">No creator content yet.</div>';return}const d=await getJSON('/api/analytics/content-performance?contentId='+encodeURIComponent(selected));if(!d.content){b.innerHTML='<div class="card">No creator content yet.</div>';return}b.innerHTML=`<article class="card"><h3>${esc(d.content.title)}</h3><div class="stats-grid"><div><strong>${d.content.views}</strong><span>Views</span></div><div><strong>${d.content.likes}</strong><span>Likes</span></div><div><strong>${d.content.comments}</strong><span>Comments</span></div><div><strong>${d.content.rating.toFixed(2)}</strong><span>Rating</span></div></div></article><article class="card"><h3>Chapter Breakdown</h3>${d.parts.map(p=>`<div class="service-row"><span>${p.partNumber}. ${esc(p.title)}</span><span>${p.views} views · ${p.likes} likes</span></div>`).join('')||'<p class="muted">No series parts available.</p>'}</article>`};document.getElementById('performanceWork').onchange=load;await load()}catch(e){b.innerHTML=`<div class="card error">${esc(e.message)}</div>`}}
async function loadRecommendations(){const b=document.getElementById('recommendationGrid');if(!b)return;try{const d=await getJSON('/api/recommendations');b.innerHTML=(d.recommendations||[]).map(contentCard).join('')||'<div class="empty card">No recommendations yet. Explore Discover to build more history.</div>';bindContentButtons()}catch(e){b.innerHTML=`<div class="card error">${esc(e.message)}</div>`}}
async function initAccessibility(){const form=document.getElementById('accessibilityForm');if(!form)return;form.onsubmit=async e=>{e.preventDefault();const out=document.getElementById('accessibilityStatus');try{const r=await getJSON('/api/preferences/accessibility',{method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify({textSize:document.getElementById('a11yTextSize').value,contrast:document.getElementById('a11yContrast').value,reduceMotion:document.getElementById('a11yReduceMotion').checked,captions:document.getElementById('a11yCaptions').checked})});out.textContent=r.message||'Accessibility settings saved.'}catch(e){out.textContent=e.message}}}
async function initPrivacy(){const form=document.getElementById('privacyForm');if(!form)return;form.onsubmit=async e=>{e.preventDefault();const out=document.getElementById('privacyStatus');try{const r=await getJSON('/api/preferences/privacy',{method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify({profileVisibility:document.getElementById('privacyProfile').value,personalization:document.getElementById('privacyPersonalization').checked,analytics:document.getElementById('privacyAnalytics').checked})});out.textContent=r.message||'Privacy settings saved.'}catch(e){out.textContent=e.message}}}
async function initSecurity(){document.getElementById('logoutAllDevices')?.addEventListener('click',async()=>{const out=document.getElementById('securityStatus');try{const r=await getJSON('/api/auth/logout-all',{method:'POST'});out.textContent=r.message||'Other sessions invalidated.'}catch(e){out.textContent=e.message}})}
function subscriptionRow(k,label){return `<div class="service-row"><span>${label}</span><span class="pill">${state.user.subscriptions[k]?x('active'):x('available')}</span>${routeLink('subscriptions',x('manage'),'button')}</div>`}
function help(){const loggedIn=!!state.user;return page(t('help'),loggedIn?`<section class="help-support-shell"><article class="card"><h1>${kvIcon('help')}${x('supportTitle')}</h1><p>${x('supportThreeLayers')}</p><div class="notice">${x('supportNote')}</div><article class="card ai-help-panel"><div class="section-heading"><div><span class="eyebrow">${x('supportAi')}</span><h2>${x('supportThreeLayers')}</h2></div><span class="service-badge">AI layer ON</span></div><form id="helpAiForm"><label>Ask Internal AI<textarea id="helpAiQuestion" rows=4 maxlength=5000 required placeholder="Describe the software, design, security or help problem…"></textarea></label><button type="submit" class="primary">Ask Internal AI</button></form><div id="helpAiResult" class="result"></div></article><div id="helpContactSummary" class="support-contact-summary muted">${x('supportContact')}…</div><form id="helpSupportForm"><label>${x('supportChannel')}<select id="helpChannel"><option value="ai">${x('supportAi')}</option><option value="email">${x('supportEmail')}</option><option value="mobile">${x('supportMobile')}</option></select></label><label>${x('supportProblem')}<textarea id="helpProblem" rows="6" maxlength="5000" required></textarea></label><label>Screenshot (optional)<input id="helpScreenshot" type="file" accept="image/png,image/jpeg,image/webp"></label><button type="submit" class="primary">${x('supportCreate')}</button><div id="helpStatus" class="result"></div></form><p class="muted">${x('supportWriterScope')}</p><p class="muted">${x('supportCritical')}</p></article><article class="card"><h2>${kvIcon('history')} ${x('supportHistory')}</h2><div id="helpTicketHistory" class="writing-list"><p class="muted">${x('supportNoTickets')}</p></div></article><article class="card"><h2>${kvIcon('shield')} ${x('moderation')}</h2><p>${x('aiReview')}. ${x('uncertainCases')}</p></article><article class="card"><h2>${kvIcon('document')} ${x('policyTitle')}</h2><p>${x('policyText')}</p></article><article class="card"><h2>${kvIcon('lock')} ${x('privacyTitle')}</h2><p>${x('privacyNote')}</p></article></section>`:`<section class="help-support-shell"><article class="card ai-help-public"><div class="section-heading"><div><span class="eyebrow">Internal AI Help</span><h1>${kvIcon('spark')} ${x('helpLoginTitle')}</h1></div><span class="service-badge">Internal layer ON</span></div><p>${x('helpLoginText')}</p><form id="publicAiHelpForm"><label>Ask about Login, OTP, Registration or Password<input id="publicAiHelpQuestion" maxlength="800" required placeholder="e.g. I did not receive my OTP"></label><button class="primary" type="submit">Ask Internal AI</button></form><div id="publicAiHelpAnswer" class="result"></div><div class="button-row"><button class="primary" data-open-login>${x('helpLoginAction')}</button><button class="button" data-register>${x('helpRegisterAction')}</button></div><p class="muted">${x('helpForgotText')}</p><div class="notice">${x('helpVerifiedContact')}</div></article><article class="card"><h2>❓ ${t('help')}</h2><p>${t('helpText')}</p><p class="muted">Public Help covers account creation, OTP verification failure, OTP not received and Forgot Password. Account-state requests are routed to Master Admin and are never executed by Help AI.</p><form id="publicAccountStateForm"><label>Registered email/mobile<input id="publicAccountIdentifier" required></label><label>Request type<select id="publicAccountStateType"><option value="unblock">Unblock blocked account</option><option value="reactivate">Reactivate deactivated account</option><option value="deletion">Request account deletion</option></select></label><label>Reason<textarea id="publicAccountStateReason" rows="4" maxlength="3000" required></textarea></label><label>Screenshot (optional)<input id="publicAccountStateScreenshot" type="file" accept="image/png,image/jpeg,image/webp"></label><button class="primary" type="submit">Submit to Master Admin</button><div id="publicAccountStateResult" class="result"></div></form><hr><form id="publicTicketTrackForm"><label>Track ticket number<input id="publicTicketNumber" required></label><label>Registered email/mobile<input id="publicTicketIdentifier" required></label><button class="button" type="submit">Track Ticket</button><div id="publicTicketTrackResult" class="result"></div></form></article></section>`)}
async function initHelpSupport(){const form=document.getElementById('helpSupportForm'),status=document.getElementById('helpStatus');if(!form)return;const aiForm=document.getElementById('helpAiForm'),aiOut=document.getElementById('helpAiResult');if(aiForm&&aiOut)aiForm.onsubmit=async e=>{e.preventDefault();const q=document.getElementById('helpAiQuestion').value.trim();if(!q)return;aiOut.textContent='Internal AI is analysing…';try{const r=await getJSON('/api/ai/help',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({problem:q,language:state.uiLanguage})});aiOut.innerHTML=`<strong>${esc(r.ai.reply||'')}</strong><p class="muted">${esc(r.ai.category||'general')} · ${Math.round(Number(r.ai.confidence||0)*100)}% · ${r.ai.ticketId?`Ticket ${esc(r.ai.ticketId)}`:'No ticket required'}</p>`}catch(e){aiOut.textContent=e.message}};try{const ctx=await getJSON('/api/help/context');const summary=document.getElementById('helpContactSummary');if(summary)summary.textContent=`${x('supportContact')}: ${ctx.verifiedContact} (${ctx.verifiedContactType})`;const email=document.querySelector('#helpChannel option[value="email"]'),mobile=document.querySelector('#helpChannel option[value="mobile"]');if(email)email.disabled=!ctx.channels.email;if(mobile)mobile.disabled=!ctx.channels.mobile;form.onsubmit=async e=>{e.preventDefault();try{const r=await getJSON('/api/help/tickets',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({channel:document.getElementById('helpChannel').value,problem:document.getElementById('helpProblem').value,screenshot:await fileAsDataUrl(document.getElementById('helpScreenshot'))})});const ticket=r.ticket;status.innerHTML=`<strong>${x('supportResult')}</strong><br>${esc(r.ai.reply||'')}<br><strong>${x('supportTicketId')}:</strong> ${esc(ticket.id)}<br>${ticket.status==='ai_resolved'?x('supportAiSolved'):(ticket.assignedQueue==='master_admin'?x('supportRoutedMaster'):x('supportRoutedAdmin'))}`;document.getElementById('helpProblem').value='';await loadHelpTickets()}catch(e){status.textContent=e.message}};await loadHelpTickets()}catch(e){if(status)status.textContent=e.message}}
async function loadHelpTickets(){const box=document.getElementById('helpTicketHistory');if(!box||!state.user)return;try{const r=await getJSON('/api/help/tickets');box.innerHTML=r.tickets.length?r.tickets.map(t=>`<article class="writing-item"><div><strong>${esc(t.id)}</strong><div class="muted">${esc(t.status)} · ${esc(t.category)}</div><div>${esc(t.ai?.reply||t.problem||'')}</div></div></article>`).join(''):x('supportNoTickets')}catch(e){box.innerHTML=`<p class="error">${esc(e.message)}</p>`}}
function dashboardCard(title,body,route){return `<article class="card"><h3>${title}</h3><p class="muted">${body}</p>${route?routeLink(route,x('open')||x('open'),'button'):''}</article>`}
function readerDashboard(){if(!state.user)return loginGate();return page(x('readerDashboard'),`<div id="readerDash" class="content-grid"><div class="card">Loading…</div></div>`)}
function authorDashboard(){if(!state.user)return loginGate();return page(x('authorDashboard'),`<div id="authorDash" class="content-grid"><div class="card">Loading…</div></div>`)}
async function loadAdminAuthorityDashboard(){
 const b=document.getElementById('adminAuthorityDash');if(!b)return;
 try{
  const d=await getJSON('/api/admin/authority/overview');
  const modules=(d.modules||[]).map(m=>'<article class="card admin-module-card"><div class="section-heading"><div><span class="eyebrow">'+esc(m.permission)+'</span><h3>'+kvIcon('dashboard')+esc(m.label)+'</h3></div><span class="pill">'+(m.allowed?'Authorized':'Not authorized')+'</span></div><p class="muted">'+(m.allowed?'This module is available under the current delegated rights.':'Master Admin has not granted this right to this Admin.')+'</p><button class="button" data-admin-module="'+esc(m.id)+'" data-admin-permission="'+esc(m.permission)+'" data-admin-route="'+esc(m.route)+'">Open</button></article>').join('');
  let master='';
  if(d.role==='master_admin'){
   let requests=[],permissions=[];
   try{requests=(await getJSON('/api/admin/rights-requests')).requests||[]}catch(_){}
   try{permissions=(await getJSON('/api/admin/rbac/permissions')).permissions||[]}catch(_){}
   const permissionRows=permissions.map(r=>'<article class="writing-item"><div><strong>'+esc(r.adminId)+'</strong><div class="muted">'+esc(r.permission)+' · '+(r.active===false?'Disabled':'Active')+'</div></div><button class="button '+(r.active===false?'primary':'danger')+'" data-rbac-toggle="1" data-rbac-admin="'+esc(r.adminId)+'" data-rbac-permission="'+esc(r.permission)+'" data-rbac-active="'+(r.active===false?'true':'false')+'">'+(r.active===false?'Enable':'Disable')+'</button></article>').join('');
   master='<section class="card"><h2>'+kvIcon('lock')+' Master Admin Authority Control</h2><p class="muted">Human Master Admin has full control. Delegated Admin rights can be explicitly granted, disabled, re-enabled and audited here. Disabling a delegated right does not remove the grant history.</p><form id="masterGrantForm"><input id="masterGrantAdminId" placeholder="Admin ID" required><input id="masterGrantPermission" placeholder="Permission" required><button class="primary" type="submit">Grant Right</button><div id="masterGrantStatus" class="result"></div></form><h3>Delegated Rights Status</h3><div class="writing-list">'+(permissionRows||'<p class="muted">No delegated rights recorded.</p>')+'</div><h3>Rights Requests</h3><div class="writing-list">'+(requests.map(r=>'<article class="writing-item"><div><strong>'+esc(r.id)+'</strong><div class="muted">Admin: '+esc(r.ownerId)+' · '+esc(r.status)+'</div><div>'+esc((r.requestedPermissions||[]).join(', '))+'</div></div><div class="button-row"><button class="button" data-rights-approve="'+esc(r.id)+'">Approve</button><button class="button danger" data-rights-reject="'+esc(r.id)+'">Reject</button></div></article>').join('')||'<p class="muted">No Admin rights requests.</p>')+'</div></section>';
  }
  b.innerHTML='<section class="card"><h2>'+kvIcon('dashboard')+' Admin Authority</h2><p class="muted">Role: '+esc(d.role)+' · Explicit rights only. Master Admin is the highest human authority.</p><div class="chips">'+((d.rights||[]).map(r=>'<span class="pill">'+esc(r)+'</span>').join('')||'<span class="pill">No delegated rights</span>')+'</div></section>'+master+'<div class="grid">'+modules+'</div><section class="card"><h2>'+kvIcon('ticket')+' Request additional rights</h2><p class="muted">Submit a secure request to Master Admin. Rights become active only after approval.</p><form id="adminRightsRequestForm"><textarea id="adminRightsRequested" rows="4" placeholder="One permission per line"></textarea><textarea id="adminRightsReason" rows="3" placeholder="Reason"></textarea><button class="primary" type="submit">Request Rights</button><div id="adminRightsRequestStatus" class="result"></div></form></section>';
  b.querySelectorAll('[data-admin-module]').forEach(btn=>btn.onclick=async()=>{const item=(d.modules||[]).find(x=>x.permission===btn.dataset.adminPermission);if(!item?.allowed){try{await getJSON('/api/admin/authorization/denied-click',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({module:btn.dataset.adminModule,permission:btn.dataset.adminPermission,route:btn.dataset.adminRoute,action:'click'})})}catch(_){}showToast('You are not authorized. Ask Master Admin for this right.','error');return}navigate(btn.dataset.adminRoute)});
  document.getElementById('adminRightsRequestForm')?.addEventListener('submit',async e=>{e.preventDefault();const status=document.getElementById('adminRightsRequestStatus');const permissions=document.getElementById('adminRightsRequested').value.split(/\n|,/).map(x=>x.trim()).filter(Boolean);try{const r=await getJSON('/api/admin/rights-requests',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({permissions,reason:document.getElementById('adminRightsReason').value})});status.textContent='Request '+r.ticket.id+' submitted to Master Admin.'}catch(e){status.textContent=e.message}});
  document.getElementById('masterGrantForm')?.addEventListener('submit',async e=>{e.preventDefault();const status=document.getElementById('masterGrantStatus');try{const r=await getJSON('/api/admin/rbac/permissions',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({adminId:document.getElementById('masterGrantAdminId').value,permission:document.getElementById('masterGrantPermission').value})});status.textContent='Granted '+r.permission.permission+' to '+r.permission.adminId;loadAdminAuthorityDashboard()}catch(e){status.textContent=e.message}});
  b.querySelectorAll('[data-rbac-toggle]').forEach(btn=>btn.onclick=async()=>{try{await getJSON('/api/admin/rbac/permissions',{method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify({adminId:btn.dataset.rbacAdmin,permission:btn.dataset.rbacPermission,active:btn.dataset.rbacActive==='true'})});loadAdminAuthorityDashboard()}catch(e){showToast(e.message,'error')}});
  b.querySelectorAll('[data-rights-approve]').forEach(btn=>btn.onclick=async()=>{try{await getJSON('/api/admin/rights-requests/'+btn.dataset.rightsApprove,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({approved:true})});loadAdminAuthorityDashboard()}catch(e){showToast(e.message,'error')}});
  b.querySelectorAll('[data-rights-reject]').forEach(btn=>btn.onclick=async()=>{try{await getJSON('/api/admin/rights-requests/'+btn.dataset.rightsReject,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({approved:false})});loadAdminAuthorityDashboard()}catch(e){showToast(e.message,'error')}});
 }catch(e){b.innerHTML='<div class="card error">'+esc(e.message)+'</div>'}
}
function adminDashboard(){return page(x('adminRole'),`<div class="card"><p class="muted">Master Admin has full control. Designated Admins can act only within explicitly granted rights.</p><div class="button-row"><button class="button" data-admin-login>${x('adminLogin')}</button>${routeLink('admin-monetization',x('adminMonetization'),'button')}</div></div><div id="adminDash" class="content-grid"></div><div id="adminAuthorityDash" class="content-grid"></div>`)}
function safetyTicketsPage(){if(!state.user)return page(t('help'),`<section class="page-shell"><article class="card"><h1>${kvIcon('ticket')} Safety & Tickets</h1><p>Login is required to view account-specific safety notices and ticket communication.</p><button class="primary" data-open-login>Login</button></article></section>`);return page('Safety & Tickets',`<section class="page-shell"><article class="card"><div class="section-heading"><div><span class="eyebrow">Internal Safety AI</span><h1>${kvIcon('shield')} Safety & Tickets</h1></div><span class="service-badge">Internal AI</span></div><p class="muted">Your account-specific safety notices, official messages and your replies are shown here. AI/admin working notes remain private.</p><div id="safetyTicketList" class="content-grid"><div class="card">Loading…</div></div></article><article class="card"><div class="section-heading"><div><span class="eyebrow">Damage Control AI</span><h2>${kvIcon('shield')} Report a problem</h2></div></div><form id="damageReportForm"><label>Describe damage, suspicious activity or a broken system function<textarea id="damageDescription" rows="5" maxlength="5000" required></textarea></label><button class="primary" type="submit">Create Review Ticket</button><div id="damageReportStatus" class="result"></div></form></article></section>`)}
async function loadSafetyTickets(){const box=document.getElementById('safetyTicketList');if(!box)return;try{const d=await getJSON('/api/ai/user-monitoring/tickets');box.innerHTML=(d.tickets||[]).map(t=>`<article class="card ticket-card"><div class="section-heading"><strong>${kvIcon('ticket')} ${esc(t.id)}</strong><span class="service-badge">${esc(t.risk||'review')}</span></div><p>${esc(t.problem)}</p><p class="muted">Status: ${esc(t.status)}</p><div class="ticket-comments">${(t.comments||[]).map(c=>`<div class="ticket-comment ${c.visibility==='official'?'official':''}"><small>${esc(c.visibility==='official'?x('kathaVistaar'):'You')}</small><div>${esc(c.body)}</div></div>`).join('')}</div><form class="ticket-reply-form" data-ticket-id="${esc(t.id)}"><textarea maxlength="2000" required placeholder="Reply to this ticket…"></textarea><button class="button" type="submit">Reply</button></form></article>`).join('')||'<div class="empty card">No safety notices or tickets.</div>';box.querySelectorAll('.ticket-reply-form').forEach(f=>f.onsubmit=async e=>{e.preventDefault();const textarea=f.querySelector('textarea');try{await getJSON('/api/ai/tickets/comment',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({ticketId:f.dataset.ticketId,body:textarea.value})});textarea.value='';loadSafetyTickets()}catch(err){showToast(err.message)}})}catch(e){box.innerHTML=`<div class="card error">${esc(e.message)}</div>`}}
function bindSafetyTickets(){loadSafetyTickets();const f=document.getElementById('damageReportForm');if(f)f.onsubmit=async e=>{e.preventDefault();const out=document.getElementById('damageReportStatus');try{const r=await getJSON('/api/ai/damage-control',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({description:document.getElementById('damageDescription').value})});out.textContent=`Ticket ${r.ticket.id} created and routed for review.`;f.reset();loadSafetyTickets()}catch(err){out.textContent=err.message}}}
function aiDashboard(){return page(x('aiManagement'),`<div id="aiDash" class="content-grid"><div class="card">${x('aiManagementLogin')}</div><div class="button-row"><button class="primary" data-admin-ai-login>${x('adminLogin')}</button></div><article class="card"><h3>Creator Social Assistant</h3><p class="muted">Generates a proposal only; publishing remains a human-approved creator action.</p><form id="aiSocialForm" class="profile-form"><label>Topic or work title<input id="aiSocialTopic" required maxlength=200></label><label>Platform<input id="aiSocialPlatform" value="generic" maxlength=30></label><button class="button" type="submit">Generate proposal</button><div id="aiSocialStatus" class="result"></div></form></article></div>`)}
function reportsPage(){if(!state.user)return loginGate();return page('Reports & Analysis',`<div id="reportsDash" class="content-grid"><div class="card">Loading…</div></div>`)}
function mediaTools(){if(!state.user)return loginGate();return page('Media Studio',`<section class="content-grid"><article class="card"><h2>${kvIcon('audio')}FM / Audio + ${kvIcon('reel')}Reel / Video</h2><p class="muted">Upload your own audio/video, run the internal security preflight, then generate encrypted HLS (AES-128). Nothing is published directly from upload.</p><input id="mediaFile" type="file" accept="audio/mpeg,audio/wav,audio/mp4,audio/aac,audio/ogg,audio/opus,audio/flac,video/mp4,video/webm,video/quicktime,video/x-matroska,video/x-m4v,image/png,image/jpeg,image/webp,image/gif,application/pdf"><label>Attach to your content (optional)<select id="mediaContentSelect"><option value="">No content yet</option></select></label><div class="button-row"><button class="primary" id="mediaUploadBtn">Upload & Quarantine</button><button class="button" data-media-job="audio">Test Audio Job</button><button class="button" data-media-job="video">Test Video Job</button></div><div id="mediaUploadStatus" class="result"></div></article><article class="card"><h2>${kvIcon('lock')} Encrypted Media</h2><p class="muted">HLS keys are stored encrypted at rest in local/demo mode and delivered only after login + content entitlement checks. Production mode requires a dedicated media-key secret/KMS.</p><div id="mediaAssetList">Loading…</div></article><article class="card"><h2>${kvIcon('spark')} Creator AI</h2><p class="muted">AI can help with story structure, comic panel/dialogue planning, FM script/narration, reel timing and media-rights checks. It never publishes or changes your work without your approval.</p>${routeLink('editor',x('create'),'button')}</article></section>`)}
function paymentsPage(){if(!state.user)return page(x('accountPayments'),`<div class="gate card"><h2>${kvIcon('lock')} Login required for payment</h2><p>Plans remain publicly viewable, but payment and account activation require login.</p><div class="button-row"><button class="primary" data-open-login>${t('login')}</button><button class="button" data-register>${x('createAccount')}</button></div></div>`);return page(x('accountPayments'),`<section class="payment-shell"><article class="card"><div class="section-heading"><div><span class="eyebrow">Secure checkout</span><h1>Choose payment method</h1></div><span class="service-badge">Internal + External</span></div><div id="paymentPlanSummary" class="payment-plan-summary">Loading selected plan…</div><div class="payment-method-grid"><button type="button" class="payment-method active" data-payment-method="internal_test"><strong>KV Internal Payment</strong><span>Local/device payment ledger; no live gateway required</span></button><button type="button" class="payment-method" data-payment-method="external"><strong>Live Provider</strong><span>Uses the configured external payment provider when enabled</span></button></div><button id="confirmPayment" class="primary payment-confirm" type="button">Continue to payment</button><div id="paymentStatus" class="result"></div></article><aside class="card payment-trust"><h2>Payment & access</h2><ul><li>Your subscription activates only after a successful payment/test transaction.</li><li>External providers remain separately controlled by Master Admin.</li><li>If the external provider is unavailable, the internal application remains usable; it does not silently claim a successful live payment.</li></ul></aside></section>`)}
function stickersPage(){return page(x('coinBilling'),`<section class="kv30b-monetization-hero"><div><span class="eyebrow">Katha Vistaar · Creator Economy</span><h1>${kvIcon('coins')}<span>Coins & Stickers</span></h1><p>Browse administrator-published packs and stickers. Purchase and gifting are account actions.</p></div><div class="kv30b-balance-card"><span>${kvIcon('coins')} Balance</span><strong id="coinBalance">${state.user?x('loading'):'Login required'}</strong></div></section><section class="card kv30b-monetization-panel">${kv30bSectionHead(kvIcon('coins'),'Coin Center','Purchase coins safely','')}<div id="coinPacksBox" class="content-grid"><div class="card loading-card">Loading coin packs…</div></div><div class="form-row"><input id="coinOfferCode" placeholder="Offer / coupon code (optional)"><button class="button" id="refreshCoinCatalog">${kvIcon('refresh')} Refresh</button></div></section><section class="kv30b-monetization-panel">${kv30bSectionHead(kvIcon('sticker'),'Sticker Center','Give appreciation','')}<div id="stickersBox" class="content-grid"><div class="card loading-card">Loading stickers…</div></div></section>`)}
function adsPage(){return page('Ads & Promotions',`<div class="card"><h2>Internal ads</h2><p class="muted">Internal promotional inventory works without an external ad network. External ads remain provider/licence gated.</p><div class="button-row">${routeLink('discover',x('exploreFeatures'),'button')}${routeLink('write','Author opportunities','button')}</div></div>`)}
async function notificationsPage(){if(!state.user)return loginGate();return page(x('notificationCenter'),`${adStrip('notifications')}<section class="kv30b-notification-head"><div><span class="eyebrow">Katha Vistaar</span><h1>${x('notificationCenter')}</h1><p>Messages, engagement, creator updates and security alerts.</p></div><span class="service-badge">Live account feed</span></section><div id="notificationCenter" class="notification-center"><div class="card loading-card">${kvIcon('bell')} Loading notifications…</div></div>`)}
async function messagesPage(){if(!state.user)return loginGate();return page(x('messageBox'),`${adStrip('messages')}<section class="kv30b-message-shell"><aside class="card kv30b-message-aside"><div class="section-heading"><div><span class="eyebrow">Inbox</span><h1>${x('messageBox')}</h1></div></div><p class="muted">Message users you are allowed to contact. Attachments remain subject to policy.</p><div class="button-row"><button class="button" id="messageRefresh">${kvIcon('refresh')} Refresh</button><button class="primary" id="messageCompose">${kvIcon('plus')} New message</button></div></aside><section><div id="messageList" class="content-grid"><div class="card loading-card">${kvIcon('message')} Loading messages…</div></div></section></section>`)}
function subscriptionBillingPage(){return page(x('subscriptionBilling'),`<section class="kv30b-monetization-hero"><div><span class="eyebrow">Katha Vistaar · Membership</span><h1>${kvIcon('coins')}<span>${x('subscriptionBilling')}</span></h1><p>Compare plans before checkout. Viewing is public; purchase requires login and verified payment OTP.</p></div><div class="kv30b-payment-trust"><span>${kvIcon('lock')} Secure</span><span>${kvIcon('shield')} Policy governed</span><span>${kvIcon('payment')} Internal checkout</span></div></section><div id="subscriptionCatalog" class="kv30b-plan-grid"><div class="card loading-card">Loading plans…</div></div>`)}
function adminMonetizationPage(){return page(x('adminMonetization'),`<div class="card"><p class="muted">Policy controls are permission-gated. Master Admin has full control; designated Admins only receive explicitly granted rights.</p></div><section class="card"><h2>${kvIcon('shield')} GST / SAC Approval</h2><p class="muted">CA / external tax expert supplies the SAC/classification. Master Admin enters the supplied SAC and the applicable state/category tax rules, then gives final approval. GST rates are configuration-driven, including 0% where applicable. Monetization remains blocked until Master Admin approval.</p><div id="taxGstApprovalBox">Loading…</div></section><section class="card"><h2>${kvIcon('folder')} Ad media assets</h2><p class="muted">Designated ad-management Admins and Master Admin can upload/remove audio or video campaign assets. Files are kept separate from creator media.</p><div class="button-row"><input id="adminAdMediaFile" type="file" accept="audio/mpeg,audio/wav,audio/mp4,video/mp4,video/webm"><button class="primary" id="adminAdMediaUpload">Upload ad media</button></div><div id="adminAdMediaList" class="content-grid"></div><div id="adminAdMediaStatus" class="result"></div></section><div id="adminMonetizationBox" class="content-grid"><div class="card">Loading…</div></div>`)}
async function loadNotifications(){const box=document.getElementById('notificationCenter');if(!box)return;try{const d=await getJSON('/api/notifications');box.innerHTML=`<div class="notification-toolbar"><strong>${d.unread} unread</strong><button class="button" id="markAllNotifications">Mark all read</button></div>`+(d.notifications||[]).map(n=>`<article class="notification-item ${n.read?'':'unread'}" data-notification-id="${esc(n.id)}" data-deeplink="${esc(n.deepLink||'')}"><div class="notification-main"><strong>${esc(n.title)}</strong><p>${esc(n.body)}</p><small>${esc(n.category)} · ${esc(n.createdAt)}</small></div><button class="button notification-open" type="button">Open</button></article>`).join('')||`<div class="empty card">No notifications yet.</div>`;document.getElementById('markAllNotifications')?.addEventListener('click',async()=>{await getJSON('/api/notifications/read',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({all:true})});loadNotifications()});box.querySelectorAll('.notification-open').forEach(b=>b.onclick=async()=>{const item=b.closest('.notification-item');await getJSON('/api/notifications/read',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:item.dataset.notificationId})});if(item.dataset.deeplink)location.href=item.dataset.deeplink;else loadNotifications()})}catch(e){box.innerHTML=`<div class="card error">${esc(e.message)}</div>`}}
async function loadMessages(){const box=document.getElementById('messageList');if(!box)return;try{const d=await getJSON('/api/messages');const groups={};(d.messages||[]).forEach(m=>{const peer=m.from===state.user.id?m.to:m.from;(groups[peer]??=[]).push(m)});box.innerHTML=Object.entries(groups).map(([peer,rows])=>`<article class="card"><h3>Conversation</h3>${rows.map(m=>`<div class="message-row ${m.from===state.user.id?'sent':'received'}"><div>${esc(m.body)}</div><small>${esc(m.createdAt)}</small>${m.attachment?`<div>📎 ${esc(m.attachment.name||'attachment')}</div>`:''}</div>`).join('')}<button class="button reply-message" data-peer="${esc(peer)}">Reply</button></article>`).join('')||`<div class="empty card">No messages yet.</div>`;box.querySelectorAll('.reply-message').forEach(b=>b.onclick=()=>composeMessage(b.dataset.peer))}catch(e){box.innerHTML=`<div class="card error">${esc(e.message)}</div>`}}
async function composeMessage(peer=''){const to=await uiPrompt('Recipient user ID');if(!to)return;const body=await uiPrompt('Message');if(!body)return;try{await getJSON('/api/messages',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({toUserId:to,body})});loadMessages()}catch(e){showToast(e.message)}}
async function requestInternalPaymentOtp(action,reference,amount){
  const r=await getJSON('/api/payments/internal-otp/start',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({action,reference,amount})});
  state.paymentOtpToken=r.paymentToken;state.paymentOtpAction=action;state.paymentOtpReference=reference;
  const m=await openOtpDialog({target:r.target,purpose:r.purpose,targetType:r.targetType,sendPath:'/api/payments/internal-otp/start',sendBody:{action,reference,amount},message:`Payment verification code sent to your verified ${r.targetType}.`,lastResponse:r});
  if(!m)throw new Error('payment_otp_cancelled');
  const vr=await getJSON('/api/payments/internal-otp/verify',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({paymentToken:state.paymentOtpToken,otp:m.__otp})});
  if(!vr.verified)throw new Error('payment_otp_not_verified');
  return vr.paymentToken;
}
async function loadPaymentPage(){const summary=document.getElementById('paymentPlanSummary'),status=document.getElementById('paymentStatus');if(!summary||!state.user)return;try{const d=await getJSON('/api/monetization/catalog');const plan=(d.policy.subscriptions||[]).find(p=>p.id===state.pendingSubscriptionPlan)||d.policy.subscriptions?.[0];if(!plan){summary.textContent='No active plan selected.';return}state.pendingSubscriptionPlan=plan.id;let authorLabel='';if(plan.id==='author_subscription'){if(!state.pendingAuthorId){summary.innerHTML='<div class="card error">Choose an author before checkout.</div>';return}try{const ap=await getJSON('/api/profile/public?userId='+encodeURIComponent(state.pendingAuthorId));authorLabel=` · @${esc(ap.profile?.username||state.pendingAuthorId)}`}catch{authorLabel=''}}summary.innerHTML=`<strong>${esc(plan.label)}</strong><span>${esc(plan.type)}${authorLabel} · ${plan.price>0?'₹'+plan.price:'Free'} · ${plan.durationDays||0} days</span><p class="muted">${plan.adFree?'Ad-free':x('adsMayApply')} · ${(plan.benefits||[]).map(esc).join(' · ')}</p>`;document.querySelectorAll('[data-payment-method]').forEach(b=>b.onclick=()=>{document.querySelectorAll('[data-payment-method]').forEach(x=>x.classList.remove('active'));b.classList.add('active')});document.getElementById('confirmPayment')?.addEventListener('click',async()=>{const method=document.querySelector('[data-payment-method].active')?.dataset.paymentMethod||'internal_test';try{status.textContent='Processing…';let paymentToken=null;const idem=`${state.user.id||state.user.username}:${plan.id}:${Date.now()}`;if(method==='internal_test'&&Number(plan.price||0)>0)paymentToken=await requestInternalPaymentOtp('subscription',plan.id==='author_subscription'?`author_subscription:${state.pendingAuthorId}`:plan.id,Number(plan.price||0));const r=await getJSON('/api/subscriptions/purchase',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({planId:plan.id,authorId:plan.id==='author_subscription'?state.pendingAuthorId:undefined,mode:method==='internal_test'?'internal_test':'external',method,idempotencyKey:idem,paymentToken})});status.textContent=r.testMode?'✓ Subscription activated in internal test mode.':'✓ Payment provider accepted the request.';state.user=(await getJSON('/api/auth/me')).user;setTimeout(()=>navigate('account'),500)}catch(e){status.textContent=humanAuthError(e.message||'Payment could not be completed.')}})}catch(e){summary.textContent=humanAuthError(e.message)}}
async function fileAsDataUrl(input){const f=input?.files?.[0];if(!f)return null;if(f.size>2*1024*1024)throw new Error('Screenshot must be 2 MB or smaller.');if(!['image/png','image/jpeg','image/webp'].includes(f.type))throw new Error('Only PNG, JPEG or WebP screenshots are supported.');return await new Promise((resolve,reject)=>{const r=new FileReader();r.onload=()=>resolve({mimeType:f.type,data:String(r.result)});r.onerror=()=>reject(new Error('Screenshot could not be read.'));r.readAsDataURL(f);});}
async function initPublicAiHelp(){const form=document.getElementById('publicAiHelpForm'),out=document.getElementById('publicAiHelpAnswer');if(form&&out)form.onsubmit=async e=>{e.preventDefault();const q=document.getElementById('publicAiHelpQuestion').value.trim();if(!q)return;out.textContent='Internal AI is checking…';try{const r=await getJSON('/api/ai/help',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({problem:q,language:state.uiLanguage})});out.innerHTML=`<strong>${esc(r.ai.reply)}</strong><p class="muted">${esc(r.ai.category)} · ${r.ai.confidence||0}</p>`}catch(err){out.textContent=humanAuthError(err.message)}};const af=document.getElementById('publicAccountStateForm');if(af)af.onsubmit=async e=>{e.preventDefault();const out=document.getElementById('publicAccountStateResult');try{const screenshot=await fileAsDataUrl(document.getElementById('publicAccountStateScreenshot'));const r=await getJSON('/api/help/account-state-ticket',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({identifier:document.getElementById('publicAccountIdentifier').value,type:document.getElementById('publicAccountStateType').value,reason:document.getElementById('publicAccountStateReason').value,screenshot})});out.innerHTML=`<strong>Submitted.</strong> Ticket: ${esc(r.ticket?.id||'created')}</strong><p class="muted">Only Master Admin can decide the account-state request.</p>`}catch(err){out.textContent=humanAuthError(err.message)}};const tf=document.getElementById('publicTicketTrackForm');if(tf)tf.onsubmit=async e=>{e.preventDefault();const out=document.getElementById('publicTicketTrackResult');try{const n=encodeURIComponent(document.getElementById('publicTicketNumber').value.trim()),i=encodeURIComponent(document.getElementById('publicTicketIdentifier').value.trim());const r=await getJSON(`/api/help/tickets/track?ticketNumber=${n}&identifier=${i}`);out.innerHTML=`<strong>${esc(r.ticket.id)}</strong><p>${esc(r.ticket.status)} · ${esc(r.ticket.problem||'')}</p>`}catch(err){out.textContent=humanAuthError(err.message)}}}
async function loadSubscriptionCatalog(){const box=document.getElementById('subscriptionCatalog');if(!box)return;try{const d=await getJSON('/api/monetization/catalog');box.innerHTML=(d.policy.subscriptions||[]).map(s=>`<article class="card monetization-card"><div class="eyebrow">${esc(s.type)}</div><h3>${esc(s.label)}</h3><p class="price">${s.price>0?`₹${s.price}`:'Free / administrator configured'}</p><p>${s.adFree?'✓ Ad-free':x('adsMayApply')} · ${s.durationDays||0} days</p><ul>${(s.benefits||[]).map(b=>`<li>${esc(b)}</li>`).join('')||'<li>Benefits configured by administrator</li>'}</ul><button class="primary" data-buy-sub-plan="${esc(s.id)}">${state.user?x('buy')+' / '+x('internalPayment'):x('login')}</button><div class="result" data-sub-status="${esc(s.id)}"></div></article>`).join('')||'<div class="empty card">No active subscription plans.</div>';document.querySelectorAll('[data-buy-sub-plan]').forEach(btn=>btn.onclick=()=>{state.pendingSubscriptionPlan=btn.dataset.buySubPlan;if(!state.user){openLogin();return}navigate('payments')})}catch(e){box.innerHTML=`<div class="card error">${esc(e.message)}</div>`}}
async function loadTaxGstApproval(){const box=document.getElementById('taxGstApprovalBox');if(!box)return;try{const d=await getJSON('/api/admin/tax-gst-production-matrix');const m=d.matrix||{};const lb=m.legalBasis||{};const pm=m.productionMatrix||{};box.innerHTML=`<div class="result"><strong>Status:</strong> ${esc(m.status||'MISSING')} · <strong>Approved:</strong> ${pm.isApproved?'Yes':'No'} · <strong>Entries:</strong> ${(pm.entries||[]).length}</div><div class="form-row"><input id="taxNotificationNo" placeholder="Notification No." value="${esc(lb.notificationNo||'')}"><input id="taxNotificationDate" type="date" value="${esc(lb.notificationDate||'')}"><input id="taxSacHeading" placeholder="SAC Heading" value="${esc(lb.sacHeading||'')}"><input id="taxSacGroup" placeholder="SAC Group" value="${esc(lb.sacGroup||'')}"></div><div class="form-row"><input id="taxExactClassification" placeholder="Exact classification supplied by CA / Master Admin" value="${esc(lb.exactClassification||'')}"><input id="taxLegalReviewer" placeholder="Optional CA / Legal reference" value="${esc(m.approvalEvidence?.legalReviewer||'')}"><input id="taxEvidenceRefs" placeholder="Evidence references (comma separated)" value="${esc((m.approvalEvidence?.evidenceReferences||[]).join(', '))}"></div><textarea id="taxEntriesJson" rows="10" placeholder="Paste approved productionMatrix.entries JSON array; include applicable rate/effective period/rule version from CA/Legal.">${esc(JSON.stringify(pm.entries||[],null,2))}</textarea><div class="button-row"><button class="primary" id="taxGstApproveSave">Save & Approve GST / SAC Matrix</button></div><div id="taxGstApprovalStatus" class="result"></div>`;document.getElementById('taxGstApproveSave')?.addEventListener('click',async()=>{const out=document.getElementById('taxGstApprovalStatus');try{const entries=JSON.parse(document.getElementById('taxEntriesJson').value||'[]');const r=await getJSON('/api/admin/tax-gst-production-matrix',{method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify({legalBasis:{notificationNo:document.getElementById('taxNotificationNo').value,notificationDate:document.getElementById('taxNotificationDate').value,sacHeading:document.getElementById('taxSacHeading').value,sacGroup:document.getElementById('taxSacGroup').value,exactClassification:document.getElementById('taxExactClassification').value},entries,legalReviewer:document.getElementById('taxLegalReviewer').value,evidenceReferences:document.getElementById('taxEvidenceRefs').value.split(',').map(x=>x.trim()).filter(Boolean)})});out.textContent=r.ok?'Approved and persisted.':x('approvalFailed');loadTaxGstApproval()}catch(e){out.textContent=e.message||x('approvalFailed')}})}catch(e){box.innerHTML=`<div class="card error">${esc(e.message)}</div>`}}
async function loadAdminMonetization(){const box=document.getElementById('adminMonetizationBox');if(!box)return;try{const am=await getJSON('/api/admin/monetization/ad-assets');const al=document.getElementById('adminAdMediaList');if(al)al.innerHTML=(am.assets||[]).map(a=>`<div class="card"><strong>${esc(a.filename)}</strong><div class="button-row"><audio controls src="${esc(a.url)}"></audio><button class="button" data-remove-ad-asset="${esc(a.filename)}">Remove</button></div></div>`).join('')||'<div class="muted">No uploaded ad media.</div>';al?.querySelectorAll('[data-remove-ad-asset]').forEach(b=>b.onclick=async()=>{await getJSON('/api/admin/monetization/ad-assets/'+encodeURIComponent(b.dataset.removeAdAsset),{method:'DELETE'});loadAdminMonetization()});document.getElementById('adminAdMediaUpload')?.addEventListener('click',async()=>{const f=document.getElementById('adminAdMediaFile')?.files?.[0],o=document.getElementById('adminAdMediaStatus');if(!f){if(o)o.textContent=x('selectAudioVideo');return}try{const data=await new Promise((res,rej)=>{const r=new FileReader();r.onload=()=>res(r.result);r.onerror=rej;r.readAsDataURL(f)});const r=await getJSON('/api/admin/monetization/ad-assets',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({filename:f.name,mimeType:f.type,data})});if(o)o.textContent='✓ Uploaded '+r.asset.filename;loadAdminMonetization()}catch(e){if(o)o.textContent=e.message}});const d=await getJSON('/api/admin/monetization');const p=d.policy;loadTaxGstApproval();box.innerHTML=`<article class="card"><h2>${kvIcon('coins')} Coin packs</h2><pre>${esc(JSON.stringify(p.coinPacks,null,2))}</pre><button class="button" id="adminCoinEdit">Edit coin packs</button><button class="button" id="adminCoinGrant">Grant Coins</button></article><article class="card"><h2>${kvIcon('sticker')} Stickers (${p.stickers.length})</h2><div class="content-grid">${p.stickers.map(s=>`<div class="card"><strong>${esc(s.emoji)} ${esc(s.label)}</strong><p>${s.costCoins} Coins</p><button class="button admin-sticker-edit" data-id="${esc(s.id)}">Edit</button><button class="button admin-sticker-remove" data-id="${esc(s.id)}">Remove</button></div>`).join('')}</div><button class="button" id="adminStickerAdd">Add sticker</button><button class="button" id="adminStickerGrant">Grant Sticker</button></article><article class="card"><h2>${kvIcon('ticket')} Offers</h2><pre>${esc(JSON.stringify(p.offers,null,2))}</pre><button class="button" id="adminOfferAdd">Add offer</button></article><article class="card"><h2>${kvIcon('payment')} Subscription Plans</h2><div class="content-grid">${(p.subscriptions||[]).map(s=>`<div class="card"><strong>${esc(s.label)}</strong><p>${esc(s.type)} · ₹${s.price||0} · ${s.durationDays||0} days · ${s.adFree?'Ad-free':x('adsMayApply')}</p><button class="button admin-sub-edit" data-id="${esc(s.id)}">Edit</button><button class="button admin-sub-remove" data-id="${esc(s.id)}">Remove</button></div>`).join('')}</div><button class="button" id="adminSubAdd">Create new plan</button></article><article class="card"><h2>${kvIcon('megaphone')} Ad Campaigns</h2><pre>${esc(JSON.stringify(p.adCampaigns||[],null,2))}</pre><button class="button" id="adminAdAdd">Add ad campaign</button></article><article class="card"><h2>${kvIcon('megaphone')} Ad Policy</h2><pre>${esc(JSON.stringify(p.ads,null,2))}</pre><button class="button" id="adminAdPolicy">Edit ad policy</button></article><article class="card"><h2>${kvIcon('crown')} Royalty</h2><pre>${esc(JSON.stringify(p.royalty,null,2))}</pre><button class="button" id="adminRoyaltyEdit">Edit royalty policy</button></article><article class="card"><h2>${kvIcon('shield')} Creator & Upload Limits</h2><p class="muted">Master Admin only. Limits are configuration, not hardcoded application constants.</p><div id="creatorLimitsAdminBox">Loading…</div></article><article class="card"><h2>${kvIcon('lock')} Admin Permissions</h2><pre>${esc(JSON.stringify(p.adminPermissions||{},null,2))}</pre><button class="button" id="adminPermissionsEdit">Edit delegated permissions</button></article>`;
 document.getElementById('adminCoinEdit')?.addEventListener('click',async()=>{const raw=await uiPrompt('Coin packs JSON',JSON.stringify(p.coinPacks));if(!raw)return;try{await getJSON('/api/admin/monetization/coins',{method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify({packs:JSON.parse(raw)})});loadAdminMonetization()}catch(e){showToast(e.message)}});
 document.getElementById('adminCoinGrant')?.addEventListener('click',async()=>{const userId=await uiPrompt(x('userId'));const amount=Number(await uiPrompt(x('coins'),'50'));if(!userId||!amount)return;try{await getJSON('/api/admin/coins/grant',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({userId,amount,reason:'Administrator reward'})});showToast('Coins granted');}catch(e){showToast(e.message)}});
 document.getElementById('adminStickerAdd')?.addEventListener('click',async()=>{const id=await uiPrompt(x('stickerId'));if(!id)return;const label=await uiPrompt('Label')||id;const cost=Number(await uiPrompt(x('costInCoins'),'5'));try{await getJSON('/api/admin/monetization/stickers',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id,label,costCoins:cost,emoji:'🎁',active:true})});loadAdminMonetization()}catch(e){showToast(e.message)}});
 document.querySelectorAll('.admin-sticker-remove').forEach(b=>b.onclick=async()=>{try{await getJSON('/api/admin/monetization/stickers/'+encodeURIComponent(b.dataset.id),{method:'DELETE'});loadAdminMonetization()}catch(e){showToast(e.message)}}); document.querySelectorAll('.admin-sticker-edit').forEach(b=>b.onclick=async()=>{const x=p.stickers.find(s=>s.id===b.dataset.id);if(!x)return;const label=await uiPrompt('Label',x.label)||x.label;const cost=Number(await uiPrompt(x('costInCoins'),x.costCoins));const emoji=await uiPrompt('Emoji',x.emoji)||x.emoji;try{await getJSON('/api/admin/monetization/stickers',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:x.id,label,costCoins:cost,emoji,active:true})});loadAdminMonetization()}catch(e){showToast(e.message)}});
 document.getElementById('adminStickerGrant')?.addEventListener('click',async()=>{const userId=await uiPrompt(x('userId'));const sticker=await uiPrompt(x('stickerId'),'thanks');if(!userId||!sticker)return;try{await getJSON('/api/admin/stickers/grant',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({userId,sticker})});showToast('Sticker granted');}catch(e){showToast(e.message)}});
 document.getElementById('adminOfferAdd')?.addEventListener('click',async()=>{const id=await uiPrompt('Offer code');if(!id)return;const bonus=Number(await uiPrompt('Bonus Coins','0'));try{await getJSON('/api/admin/monetization/offers',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id,bonusCoins:bonus,scope:'all',active:true})});loadAdminMonetization()}catch(e){showToast(e.message)}});
 document.getElementById('adminSubAdd')?.addEventListener('click',async()=>{const id=await uiPrompt('New plan id');if(!id)return;const label=await uiPrompt(x('planName'),id)||id;const type=await uiPrompt('Type','reader')||'reader';const price=Number(await uiPrompt(x('priceInr'),'0'));const days=Number(await uiPrompt('Duration days','0'));try{await getJSON('/api/admin/monetization/subscriptions',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id,label,type,price,durationDays:days,adFree:true,active:true,benefits:[]})});loadAdminMonetization()}catch(e){showToast(e.message)}});
 document.querySelectorAll('.admin-sub-remove').forEach(b=>b.onclick=async()=>{try{await getJSON('/api/admin/monetization/subscriptions/'+encodeURIComponent(b.dataset.id),{method:'DELETE'});loadAdminMonetization()}catch(e){showToast(e.message)}}); document.querySelectorAll('.admin-sub-edit').forEach(b=>b.onclick=async()=>{const x=p.subscriptions.find(s=>s.id===b.dataset.id);if(!x)return;const label=await uiPrompt(x('planName'),x.label)||x.label;const price=Number(await uiPrompt(x('priceInr'),x.price||0));const days=Number(await uiPrompt('Duration days',String(x.durationDays??0)));const adFree=await uiConfirm('Ad-free? OK = yes');try{await getJSON('/api/admin/monetization/subscriptions',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({...x,label,price,durationDays:days,adFree})});loadAdminMonetization()}catch(e){showToast(e.message)}});
 document.getElementById('adminAdAdd')?.addEventListener('click',async()=>{const id=await uiPrompt('Ad campaign id');if(!id)return;const name=await uiPrompt(x('campaignName'),id)||id;const type=await uiPrompt('Type','native')||'native';const placement=await uiPrompt('Placement','home')||'home';try{await getJSON('/api/admin/monetization/ads',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id,name,type,placement,active:true,languages:'all'})});loadAdminMonetization()}catch(e){showToast(e.message)}}); document.querySelectorAll('.admin-ad-edit').forEach(b=>b.onclick=async()=>{const a=p.adCampaigns.find(x=>x.id===b.dataset.id);if(!a)return;const name=await uiPrompt(x('campaignName'),a.name)||a.name;const type=await uiPrompt('Type',a.type)||a.type;const placement=await uiPrompt('Placement',a.placement)||a.placement;try{await getJSON('/api/admin/monetization/ads',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({...a,name,type,placement})});loadAdminMonetization()}catch(e){showToast(e.message)}}); document.querySelectorAll('.admin-ad-remove').forEach(b=>b.onclick=async()=>{try{await getJSON('/api/admin/monetization/ads/'+encodeURIComponent(b.dataset.id),{method:'DELETE'});loadAdminMonetization()}catch(e){showToast(e.message)}});
 document.getElementById('adminAdPolicy')?.addEventListener('click',async()=>{const raw=await uiPrompt('Ad policy JSON',JSON.stringify(p.ads));if(!raw)return;try{await getJSON('/api/admin/monetization',{method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify({section:'ads',value:JSON.parse(raw)})});loadAdminMonetization()}catch(e){showToast(e.message)}});
 document.getElementById('adminRoyaltyEdit')?.addEventListener('click',async()=>{const followers=Number(await uiPrompt('Minimum genuine followers',String(p.royalty.minGenuineFollowers??0)));try{await getJSON('/api/admin/monetization',{method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify({section:'royalty',value:{minGenuineFollowers:followers,active:p.royalty.active!==false,externalPayoutRequired:p.royalty.externalPayoutRequired===true}})});loadAdminMonetization()}catch(e){showToast(e.message)}});
 loadAdminCreatorLimits();document.getElementById('adminPermissionsEdit')?.addEventListener('click',async()=>{const raw=await uiPrompt('Permissions JSON: {adminId:[permission,...]}',JSON.stringify(p.adminPermissions||{}));if(!raw)return;try{await getJSON('/api/admin/monetization/permissions',{method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify({permissions:JSON.parse(raw)})});loadAdminMonetization()}catch(e){showToast(e.message)}});
 }catch(e){box.innerHTML=`<div class="card error">${esc(e.message)}</div>`}}
function regionalAnalyticsPage(){if(!state.user)return loginGate();return page('Regional Analytics',`<section class="card"><span class="eyebrow">Analytics</span><h1>${kvIcon('insights')} Regional Activity</h1><p class="muted">Only collected activity is shown. Demographics are never inferred.</p><div id="regionalAnalytics"><div class="loading-card">Loading…</div></div></section>`)}
function eventsPage(){if(!state.user)return loginGate();return page(x('eventsCalendar'),`<section class="card"><span class="eyebrow">Community</span><h1>Events Calendar</h1><div id="eventsCalendar"><div class="loading-card">Loading…</div></div></section>`)}
function creatorTiersPage(){if(!state.user)return loginGate();return page(x('creatorTiers'),`<section class="card"><span class="eyebrow">Creator</span><h1>Creator Tiers & Benefits</h1><div id="creatorTiers"><div class="loading-card">Loading…</div></div></section>`)}
async function loadAdminCreatorLimits(){const box=document.getElementById('creatorLimitsAdminBox');if(!box)return;try{const d=await getJSON('/api/admin/creator-limits');const l=d.limits.defaults;const fields=[['story_words_per_part','Story words / part',1],['reel_duration_seconds','Reel seconds',1],['video_upload_duration_seconds','Video upload seconds',1],['photos_per_part','Photos / part',1],['photos_per_batch','Photos / batch',1],['comic_generated_images_per_part','Comic images / part',1],['pdf_upload_bytes','PDF bytes',1048576],['audio_upload_duration_seconds','Audio upload seconds',1],['audio_generation_duration_seconds','Audio generation seconds',1]];box.innerHTML='<div class="grid">'+fields.map(([k,label,m])=>`<label>${label}<input type="number" min="0" step="1" data-limit-key="${k}" value="${Math.floor(Number(l[k]||0)/m)}"></label>`).join('')+'</div><button class="primary" id="saveCreatorLimits">Save limits</button><div id="creatorLimitsStatus" class="result"></div>';box.querySelector('#saveCreatorLimits').onclick=async()=>{const payload={};fields.forEach(([k,_,m])=>payload[k]=Math.floor(Number(box.querySelector(`[data-limit-key="${k}"]`).value||0)*m));try{const r=await getJSON('/api/admin/creator-limits',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({limits:payload})});box.querySelector('#creatorLimitsStatus').textContent='Limits saved and audited.'}catch(e){box.querySelector('#creatorLimitsStatus').textContent=e.message}}}catch(e){box.innerHTML=`<div class="muted">${esc(e.message)}</div>`}}

async function loadRegionalAnalytics(){const b=document.getElementById('regionalAnalytics');if(!b)return;try{const d=await getJSON('/api/analytics/regional');const states=Object.entries(d.states||{});const langs=Object.entries(d.languages||{});b.innerHTML=`<div class="content-grid"><article class="card"><h3>States</h3>${states.map(([k,v])=>`<div class="service-row"><span>${esc(k)}</span><strong>${v}</strong></div>`).join('')||'<p class="muted">No state activity collected.</p>'}</article><article class="card"><h3>Languages</h3>${langs.map(([k,v])=>`<div class="service-row"><span>${esc(k)}</span><strong>${v}</strong></div>`).join('')||'<p class="muted">No language activity collected.</p>'}</article></div>`}catch(e){b.innerHTML=`<div class="card error">${esc(e.message)}</div>`}}
async function loadEvents(){const b=document.getElementById('eventsCalendar');if(!b)return;try{const d=await getJSON('/api/events/calendar');b.innerHTML=(d.events||[]).map(e=>`<article class="card"><h3>${esc(e.title)}</h3><p>${esc(e.date)} · ${esc(e.type)}</p></article>`).join('')}catch(e){b.innerHTML=`<div class="card error">${esc(e.message)}</div>`}}
async function loadCreatorTiers(){const b=document.getElementById('creatorTiers');if(!b)return;try{const d=await getJSON('/api/creator/tiers');b.innerHTML=`<p class="muted">Current tier: <strong>${esc(d.current.name)}</strong>. Tier thresholds are policy-controlled.</p>`+(d.tiers||[]).map(t=>`<article class="card"><h3>${esc(t.name)}</h3><p>${Number(t.minFollowers).toLocaleString()} followers minimum</p></article>`).join('')}catch(e){b.innerHTML=`<div class="card error">${esc(e.message)}</div>`}}
function render(route){try{updateHeader();const pages={home:home,discover:discover,trending:trendingPage,stories:()=>mediaPage('story'),categories:categoriesPage,comic:()=>mediaPage('comic'),audio:()=>mediaPage('audio'),reel:()=>mediaPage('reel'),library:library,reader:reader,write:write,account:account,'reader-dashboard':readerDashboard,'author-dashboard':authorDashboard,'admin-dashboard':adminDashboard,'ai-dashboard':aiDashboard,'account-settings':account,settings:settings,'phone-settings':phoneSettings,help:help,'safety-tickets':safetyTicketsPage,editor:editor,'media-tools':mediaTools,payments:paymentsPage,reports:reportsPage,ads:adsPage,stickers:stickersPage,notifications:notificationsPage,messages:messagesPage,subscriptions:subscriptionBillingPage,'admin-monetization':adminMonetizationPage,analytics:analyticsPage,audience:audiencePage,performance:performancePage,recommendations:recommendationsPage,accessibility:accessibilityPage,privacy:privacyPage,security:securityPage,interests:interestsPage,'master-command':masterCommandPage,'security-audit':securityAuditPage,'regional-analytics':regionalAnalyticsPage,events:eventsPage,'creator-tiers':creatorTiersPage,'my-writing':write,series:series};const app=document.getElementById('app');if(!app)throw new Error('Application root is missing');const isPublicProfile=route==='account'&&!!new URLSearchParams(location.search).get('userId')&&(!state.user||new URLSearchParams(location.search).get('userId')!==state.user.id);const builder=isPublicProfile?publicProfilePage:(pages[route]||home);app.innerHTML=builder();applyTranslations();bind();if(route==='help')initHelpSupport();if(route==='safety-tickets'&&state.user)bindSafetyTickets();if(route==='notifications'&&state.user)loadNotifications();if(route==='messages'&&state.user)loadMessages();if(route==='subscriptions')loadSubscriptionCatalog();if(route==='payments')loadPaymentPage();if(route==='help'&&!state.user)initPublicAiHelp();if(route==='admin-monetization')loadAdminMonetization();setActiveNav(route);if(['home','discover','stories','categories','comic','audio','reel','reader','series'].includes(route))loadPublicContent(route);if(route==='trending')loadTrending();if(route==='library'&&state.user)loadLibrary(state.libraryTab);if(route==='write')loadWriting();if(route==='series'&&state.user)loadSeriesManager();if(route==='account'){if(isPublicProfile)loadPublicProfile();else {loadProfile();initAccountSecurity();}}if(route==='phone-settings')loadProfile();if(route==='reader-dashboard'&&state.user)loadReaderDashboard();if(route==='author-dashboard'&&state.user)loadAuthorDashboard();if(route==='admin-dashboard')loadAdminDashboard().then(()=>loadAdminAuthorityDashboard());if(route==='ai-dashboard')loadAiDashboard();if(route==='reports'&&state.user)loadReports();if(route==='analytics'&&state.user)loadAnalyticsOverview();if(route==='audience'&&state.user)loadAudienceInsights();if(route==='performance'&&state.user)loadPerformance();if(route==='recommendations'&&state.user)loadRecommendations();if(route==='accessibility')initAccessibility();if(route==='privacy'&&state.user)initPrivacy();if(route==='security'&&state.user)initSecurity();if(route==='interests'&&state.user)initInterests();if(route==='master-command')loadMasterCommand();if(route==='security-audit')loadSecurityAudit();if(route==='regional-analytics')loadRegionalAnalytics();if(route==='events')loadEvents();if(route==='creator-tiers')loadCreatorTiers();if(route==='stickers')loadStickers();if(route==='media-tools'&&state.user)bindMediaTools();}catch(err){renderFailure(err)}}
async function loadTrending(){try{const d=await getJSON('/api/search?sort=readers');const el=document.getElementById('trendingGrid');if(el)el.innerHTML=(d.content||[]).slice(0,20).map(contentCard).join('')||`<div class="empty card">${t('emptyLibrary')}</div>`;bindContentButtons()}catch(e){const el=document.getElementById('trendingGrid');if(el)el.innerHTML=`<div class="empty card">${esc(e.message||'Unable to load trending content.')}</div>`}}
async function loadPublicContent(route){
 try{
  const type=route==='stories'?'story':route==='comic'?'comic':route==='audio'?'audio':route==='reel'?'reel':null;
  const category=type?state.categoryByType[type]:null;const workType=type?state.workTypeByType[type]:null;
  const params=new URLSearchParams();if(type)params.set('type',type);if(category)params.set('category',category);if(workType)params.set('workType',workType);
  const d=await getJSON('/api/content'+(params.toString()?'?'+params.toString():''));const arr=d.content||[];
  if(route==='series'){
    const groups={};
    arr.filter(c=>c.seriesId).forEach(c=>(groups[c.seriesId]??=[]).push(c));
    const html=Object.entries(groups).map(([sid,items])=>{items.sort((a,b)=>(a.partNumber||1)-(b.partNumber||1));const first=items[0];return `<article class="content-card series-card"><div class="content-icon">${kvIcon('book')}</div><div><span class="eyebrow">${items.length} ${x('part')}</span><h3>${esc(sid)}</h3><p>${esc(first?.title||'')}</p><div class="button-row">${first?`<button class="button" data-open-content="${first.id}" data-type="${first.type}" data-part="${first.partNumber||1}">${t('open')}</button>`:''}</div></div></article>`}).join('');
    const el=document.getElementById('publicSeriesList');if(el)el.innerHTML=html||`<div class="empty card">${t('emptyLibrary')}</div>`;
    bindContentButtons();return;
  }
  const map=route==='home'?{homeContinue:arr.slice(0,4),homeStories:arr.filter(c=>c.type==='story'),homeComics:arr.filter(c=>c.type==='comic'),homeAudio:arr.filter(c=>c.type==='audio'),homeReels:arr.filter(c=>c.type==='reel'),homeSeries:[]}:route==='categories'?{}:{discoverGrid:arr,storyGrid:arr,comicGrid:arr,audioGrid:arr,reelGrid:arr,readerGrid:arr.filter(c=>c.type==='story')};
  if(route==='home'){
    const groups={};arr.filter(c=>c.seriesId).forEach(c=>(groups[c.seriesId]??=[]).push(c));
    map.homeSeries=Object.entries(groups).map(([sid,items])=>({id:`series:${sid}`,type:'story',category:'series',title:sid,body:`${items.length} ${x('part')}${items.length===1?'':'s'}`,partNumber:items.length}));
  }
  for(const [id,items] of Object.entries(map)){const el=document.getElementById(id);if(!el)continue;if(id==='homeContinue'){el.innerHTML=items.slice(0,4).map((c,i)=>`<article class="stitch-continue-card"><img src="${stitchThumb(c.type)}" alt="" loading="lazy"><div><span class="eyebrow">${esc(c.type||'story')}</span><h3>${esc(c.title)}</h3><p>${esc((c.body||'').replace(/<[^>]+>/g,'').slice(0,70))}</p><div class="stitch-progress" aria-label="Reading progress"><span style="width:${45+(i*9)}%"></span></div><div class="button-row" style="margin-top:10px"><button class="button" data-open-content="${c.id}" data-type="${c.type}" data-part="${c.partNumber||1}">${c.type==='audio'?kvIcon('audio'):c.type==='reel'?kvIcon('reel'):kvIcon('book')}${c.type==='audio'?x('listen'):c.type==='reel'?x('watchReel'):x('readStory')}</button></div></div></article>`).join('')||`<div class="empty card">${t('emptyLibrary')}</div>`;continue}el.innerHTML=items.slice(0,8).map(contentCard).join('')||`<div class="empty card">${t('emptyLibrary')}</div>`}
  bindContentButtons();
 }catch(e){
  console.warn('Public content could not be loaded',e);
  const ids=route==='home'?['homeContinue','homeStories','homeSeries','homeComics','homeAudio','homeReels']:route==='series'?['publicSeriesList']:[route==='stories'?'storyGrid':route==='comic'?'comicGrid':route==='audio'?'audioGrid':route==='reel'?'reelGrid':route==='discover'?'discoverGrid':'readerGrid'];
  ids.forEach(id=>{const el=document.getElementById(id);if(el)el.innerHTML=`<div class="empty card">${esc(t('emptyLibrary'))}</div>`});
 }
}
async function loadLibrary(type){
 try{
  const d=await getJSON('/api/library?type='+encodeURIComponent(type));const el=document.getElementById('libraryContent');if(!el)return;
  const saved=d.savedItems||[],historyItems=d.history||[];
  const section=(title,items)=>`<section class="library-section"><h2>${title}</h2><div class="content-grid">${items.map(contentCard).join('')||`<div class="empty card">${t('emptyLibrary')}</div>`}</div></section>`;
  el.innerHTML=section(t('saved'),saved)+section(t('history'),historyItems);bindContentButtons();
 }catch(e){if(e.message==='login_required')render('library')}
}
async function populateSearchFilters(){const type=document.getElementById('searchType')?.value||'';const cat=document.getElementById('searchCategory'),wt=document.getElementById('searchWorkType');if(!cat||!wt)return;const cats=type?(CATEGORIES_BY_TYPE[type]||[]):[];const wts=type?(WORK_TYPES_BY_TYPE[type]||[]):[];cat.innerHTML=`<option value="">${x('all')}</option>`+cats.map(k=>`<option value="${k}">${categoryLabel(k)}</option>`).join('');wt.innerHTML=`<option value="">${x('all')}</option>`+wts.map(k=>`<option value="${k}">${esc(WORK_TYPE_LABEL(type,k))}</option>`).join('')}
async function runSearch(advanced=false){const q=document.getElementById('searchBox')?.value.trim()||'';const params=new URLSearchParams();if(q)params.set('q',q);if(advanced){for(const id of ['searchType','searchCategory','searchWorkType','searchSort']){const v=document.getElementById(id)?.value;if(v)params.set(id==='searchType'?'type':id==='searchCategory'?'category':id==='searchWorkType'?'workType':'sort',v)}}try{const d=await getJSON('/api/search?'+params.toString());const el=document.getElementById('discoverGrid');if(el)el.innerHTML=(d.content||[]).map(contentCard).join('')||`<div class="empty card">${t('emptyLibrary')}</div>`;const r=document.getElementById('searchResult');if(r)r.textContent=`${(d.content||[]).length} ${t('searchResults')}`;bindContentButtons()}catch(e){const r=document.getElementById('searchResult');if(r)r.textContent=e.message}}
function bindLibraryTabs(){document.querySelectorAll('[data-library-tab]').forEach(b=>b.onclick=()=>{state.libraryTab=b.dataset.libraryTab;render('library')})}
async function openContent(id){try{if(!state.user){openLogin();return}const r=await getJSON('/api/content/'+id);if(r.content?.type==='reel')showPreRoll('video','reel',()=>openContentAfterAd(id,r));else if(r.content?.type==='audio')showPreRoll('audio','fm',()=>openContentAfterAd(id,r));else if(r.content?.type==='story')showPreRoll('video','story',()=>openContentAfterAd(id,r));else if(r.content?.type==='comic')showPreRoll('video','comic',()=>openContentAfterAd(id,r));else openContentAfterAd(id,r);return;}catch(e){if(e.message==='novel_locked'){showToast(`🔒 Locked. ${e.coinUnlockCost??'configured'} coins or rewarded ad can unlock this part. ${e.nextEligibleAt?'Next daily unlock: '+new Date(e.nextEligibleAt).toLocaleString():''}`)}else if(e.message==='comic_subscription_required'||e.message==='audio_subscription_required')showToast('This part requires the separate reader subscription.');else if(e.message==='subscription_or_wait_required')showToast(`${x('locked')}: ${x('wait')}`);else if(e.message==='login_required')openLogin();else showToast(e.message)}}
async function openContentAfterAd(id,r){try{state.viewer=r.content;document.getElementById('viewerTitle').textContent=r.content.title;const mediaItems=r.content.mediaItems||[];const primaryHls=mediaItems.find(a=>a.hls)?.hls;const imageItems=mediaItems.filter(a=>String(a.mimeType||'').startsWith('image/'));document.getElementById('viewerBody').classList.add('reader-protected-content');document.getElementById('viewerBody').innerHTML=primaryHls?`<div class="media-player-wrap"><${String(primaryHls.type||'video')==='audio'?'audio':'video'} id="hlsPlayer" controls playsinline preload="metadata" style="width:100%;max-height:65vh"></${String(primaryHls.type||'video')==='audio'?'audio':'video'}></div>${imageItems.map(a=>`<img src="${a.url}" alt="${esc(a.filename||'')}" style="max-width:100%;height:auto;display:block;margin:10px auto">`).join('')}${r.content.body?`<div class="media-description">${r.content.body}</div>`:''}`:imageItems.length?`${imageItems.map(a=>`<img src="${a.url}" alt="${esc(a.filename||'')}" style="max-width:100%;height:auto;display:block;margin:10px auto">`).join('')}<div>${r.content.body||''}</div>`:(r.content.media?.assetId?`<img src="/api/media/assets/${encodeURIComponent(r.content.media.assetId)}" alt="" style="max-width:100%;height:auto"><div>${r.content.body||''}</div>`:(r.content.body||''));document.getElementById('viewerMeta').textContent=`${r.content.type} · Part ${r.content.partNumber||1} · ${r.adFree?x('adFree'):x('adSupported')}`;bindReaderProtection();if(r.content.media?.hls)initHlsPlayer(r.content.media.hls.playlist);await renderViewerActions(r.content);document.getElementById('contentViewer').showModal()}catch(e){if(e.message==='novel_locked'){showToast(`🔒 Locked. ${e.coinUnlockCost??'configured'} coins or rewarded ad can unlock this part. ${e.nextEligibleAt?'Next daily unlock: '+new Date(e.nextEligibleAt).toLocaleString():''}`)}else if(e.message==='comic_subscription_required'||e.message==='audio_subscription_required')showToast('This part requires the separate reader subscription.');else if(e.message==='subscription_or_wait_required')showToast(`${x('locked')}: ${x('wait')}`);else if(e.message==='login_required')openLogin();else showToast(e.message)}}
function initHlsPlayer(url){const v=document.getElementById('hlsPlayer');if(!v)return;if(window.Hls&&window.Hls.isSupported()){const h=new window.Hls({xhrSetup:(xhr)=>{xhr.withCredentials=true}});h.loadSource(url);h.attachMedia(v);v._kvHls=h}else{v.src=url}}
async function runReaderAI(action,c){const out=document.getElementById('viewerAiOutput');if(!out||!c)return;out.textContent=x('aiBusy');try{const text=String(c.body||'').replace(/<[^>]+>/g,' ').replace(/\s+/g,' ').trim();const r=await getJSON('/api/ai/reader-assist',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({action,text,title:c.title||'',language:state.readingLanguage||state.uiLanguage||'en',type:c.type,partNumber:c.partNumber||1})});out.innerHTML=`<strong>${esc(x('aiResult'))}</strong><br>${esc(r.result?.text||'')}<br><span class="muted">${esc(r.mode||'internal_ai')} · ${esc(x('aiNoExternal'))}</span>`}catch(e){out.textContent=humanAuthError(e.message||'AI request failed.')}}
async function renderViewerActions(c){const el=document.getElementById('viewerActions');if(!el)return;const author=c.author,eng=c.engagement||{};let following=false,authorSubscribed=false,liked=false;if(author){try{following=(await getJSON('/api/follows?authorId='+encodeURIComponent(author.id))).following;authorSubscribed=!!state.user?.subscriptions?.authorIds?.includes(author.id)}catch{}}try{liked=(await getJSON('/api/likes?contentId='+encodeURIComponent(c.id))).liked}catch{}let nav={};try{nav=await getJSON('/api/content-navigation?contentId='+encodeURIComponent(c.id))}catch{}
let catalog=null;try{catalog=await getJSON('/api/monetization/catalog')}catch{}const accessPolicy=catalog?.policy?.contentAccess?.stories?.novel||{};const isNovel=c.type==='story'&&String(c.workType||'').toLowerCase()==='novel';const freeParts=Number(accessPolicy.freeParts||0);const coinUnlockCost=Number(accessPolicy.coinUnlockCost||0);const isLockedAfterFree=isNovel&&Number(c.partNumber||1)>freeParts;const accessButtons=isLockedAfterFree?`${coinUnlockCost>0?`<button class="button" id="viewerCoinUnlock">${kvIcon('coins')} Unlock for ${coinUnlockCost} Coins</button>`:''}${accessPolicy.rewardedAdUnlock===true?`<button class="button" id="viewerRewardUnlock">${kvIcon('play')} Watch Ad → Unlock</button>`:''}`:'';
el.innerHTML=`${author?`<div class="viewer-author-line">${kvIcon('write')}${esc(authorLabel())}: <a class="author-link" href="/profile?userId=${encodeURIComponent(author.id)}" data-public-profile="${esc(author.id)}">${esc(author.name||author.username)}</a></div>`:''}<div class="viewer-toolbar"><button class="button" id="viewerPrevious" ${nav.previous?'':'disabled'}>← Previous</button><button class="button" id="viewerNext" ${nav.next?'':'disabled'}>Next →</button><button class="button" id="viewerStoryPage">${kvIcon('book')} Story Page</button><button class="button" id="viewerMarkRead">✓ Mark as Read</button><button class="button" id="viewerListen">${kvIcon('audio')} ${x('listen')}</button><button class="button" id="viewerShare">${kvIcon('share')} ${x('share')}</button><button class="button" id="viewerSave">${kvIcon('bookmark')} ${t('save')}</button><button class="button" id="viewerReaderSettings">${kvIcon('settings')} ${x('readerSettings')}</button>${author?`<button class="button" id="viewerFollow" ${author.id==='system'?'disabled':''}>${following?'✓ '+x('following'):'＋ '+x('followAuthor')}</button><button class="button" id="viewerAuthorSubscribe" ${author.id==='system'?'disabled':''}>${authorSubscribed?'✓ Author Subscribed':x('authorSubscription')}</button><button class="button" id="viewerCoin" ${author.id==='system'?'disabled':''}>🪙 Give Coins</button><button class="button" id="viewerSticker" ${author.id==='system'?'disabled':''}>🎁 Give Sticker</button>`:''}${accessButtons}</div><div class="ai-context-bar ai-context-reader" aria-label="Internal AI reading tools"><span class="ai-context-label">${kvIcon('spark')} ${x('aiReaderTools')}</span><button type="button" class="ai-icon-button" data-reader-ai="summary" title="${x('aiSummary')}" aria-label="${x('aiSummary')}">${kvIcon('document')}<span>${x('aiSummary')}</span></button><button type="button" class="ai-icon-button" data-reader-ai="explain" title="${x('aiExplain')}" aria-label="${x('aiExplain')}">${kvIcon('help')}<span>${x('aiExplain')}</span></button><button type="button" class="ai-icon-button" data-reader-ai="keypoints" title="${x('aiKeyPoints')}" aria-label="${x('aiKeyPoints')}">${kvIcon('insights')}<span>${x('aiKeyPoints')}</span></button><button type="button" class="ai-icon-button" data-reader-ai="translate" title=x('translateToReadingLanguage') aria-label=x('translateToReadingLanguage')>${kvIcon('globe')}<span>Translate</span></button></div><div id="viewerAiOutput" class="ai-context-output muted" aria-live="polite"></div><div class="viewer-engagement"><div class="rating-box"><strong>${kvIcon('trophy')} ${x('rating')}</strong><span id="viewerRatingSummary">${eng.ratingCount?eng.rating+' / 5 ('+eng.ratingCount+')':'—'}</span><span id="viewerLikeSummary" class="muted"> · ${kvIcon('like')} ${eng.likeCount||0}</span><div id="viewerStars" class="viewer-stars">${[1,2,3,4,5].map(n=>`<button type="button" data-rating="${n}" aria-label="${n} stars">☆</button>`).join('')}</div><button class="button" id="viewerLike">${liked?kvIcon('like')+' Liked':kvIcon('like')+' Like'}</button></div><div class="comments-box"><strong>${kvIcon('message')} ${x('comments')}</strong><div id="viewerComments" class="viewer-comments"><span class="muted">Loading…</span></div><div class="comment-compose"><textarea id="viewerCommentText" maxlength="1000" placeholder="${x('comment')}..."></textarea><button class="primary" id="viewerCommentSubmit">${x('submit')}</button></div></div></div>`;
 document.querySelectorAll('[data-reader-ai]').forEach(b=>b.addEventListener('click',()=>runReaderAI(b.dataset.readerAi,c)));
 document.getElementById('viewerPrevious')?.addEventListener('click',()=>nav.previous&&openContent(nav.previous.id));document.getElementById('viewerNext')?.addEventListener('click',()=>nav.next&&openContent(nav.next.id));document.getElementById('viewerStoryPage')?.addEventListener('click',()=>{document.getElementById('contentViewer')?.close();navigate(c.type==='story'?'stories':c.type==='comic'?'comic':c.type==='audio'?'audio':'reel')});
 document.getElementById('viewerMarkRead')?.addEventListener('click',async()=>{try{const r=await getJSON('/api/content/'+c.id+'/read',{method:'POST'});document.getElementById('viewerMarkRead').textContent='✓ Read';if(r.nextEligibleAt)showToast(r.nextEligibleAt?`Next locked novel part will be eligible at ${new Date(r.nextEligibleAt).toLocaleString()}.`:'Next locked novel part eligibility has been recorded.')}catch(e){showToast(e.message)}});
 document.getElementById('viewerCoinUnlock')?.addEventListener('click',async()=>{try{const r=await getJSON('/api/content/'+c.id+'/unlock',{method:'POST'});showToast(`Unlocked. Coins left: ${r.coins}`);openContent(c.id)}catch(e){showToast(e.message)}});
 document.getElementById('viewerRewardUnlock')?.addEventListener('click',async()=>{try{await getJSON('/api/content/'+c.id+'/rewarded-ad-unlock',{method:'POST'});showToast('Rewarded ad unlock recorded for this test build.');openContent(c.id)}catch(e){showToast(e.message)}});
 document.getElementById('viewerListen')?.addEventListener('click',()=>{if('speechSynthesis' in window){speechSynthesis.cancel();const u=new SpeechSynthesisUtterance(document.getElementById('viewerBody')?.innerText||'');u.lang=speechLocale(state.readingLanguage);speechSynthesis.speak(u)}else showToast('Speech playback is not supported in this browser.')});
 document.getElementById('viewerShare')?.addEventListener('click',async()=>{const url=location.href.split('#')[0]+'?work='+encodeURIComponent(c.id);try{if(navigator.share)await navigator.share({title:c.title,url});else{await navigator.clipboard?.writeText(url);showToast('Link copied')}}catch{}});
 document.getElementById('viewerSave')?.addEventListener('click',async()=>{try{await getJSON('/api/library/save',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({contentId:c.id,saved:true})});document.getElementById('viewerSave').textContent='✓ '+t('saved')}catch(e){showToast(e.message)}});
 document.getElementById('viewerReaderSettings')?.addEventListener('click',()=>openReaderSettings());
 document.getElementById('viewerFollow')?.addEventListener('click',async()=>{const next=!following;try{const r=await getJSON('/api/follows',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({authorId:author.id,following:next})});following=next;document.getElementById('viewerFollow').textContent=next?'✓ '+x('following'):'＋ '+x('followAuthor')}catch(e){showToast(e.message)}});
 document.getElementById('viewerAuthorSubscribe')?.addEventListener('click',()=>{if(authorSubscribed){showToast('This paid author subscription is already active. Manage it from Subscription & Billing.');return}state.pendingSubscriptionPlan='author_subscription';state.pendingAuthorId=author.id;navigate('payments')});
 document.getElementById('viewerCoin')?.addEventListener('click',async()=>{const amounts=Array.isArray(catalog?.policy?.coinGiftAmounts)?catalog.policy.coinGiftAmounts:[];if(!amounts.length){showToast('Coin gift options are currently unavailable.');return}const first=String(amounts[0]);const amount=Number(await uiPrompt(`Coin amount: ${amounts.join(', ')}`,first)||0);if(!amount||!amounts.includes(amount))return;try{const r=await getJSON('/api/coins/give',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({contentId:c.id,authorId:author.id,amount})});showToast(`${x('coin')}: ${amount}. ${x('coinBalance')}: ${r.coins}`)}catch(e){showToast(e.message)}});
 document.getElementById('viewerSticker')?.addEventListener('click',async()=>{const stickers=Array.isArray(catalog?.policy?.stickers)?catalog.policy.stickers:[];if(!stickers.length){showToast('Sticker options are currently unavailable.');return}const choices=stickers.map(s=>`${s.id} (${s.costCoins} Coins)`).join(', '),sticker=await uiPrompt(`Sticker: ${choices}`,String(stickers[0].id));const selected=stickers.find(s=>String(s.id)===String(sticker));if(!selected)return;try{const r=await getJSON('/api/stickers/gift',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({contentId:c.id,authorId:author.id,sticker:selected.id})});showToast(`Sticker sent. Coins left: ${r.coins}`)}catch(e){showToast(e.message)}});
 document.getElementById('viewerLike')?.addEventListener('click',async()=>{try{const r=await getJSON('/api/likes',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({contentId:c.id,liked:!liked})});liked=r.liked;document.getElementById('viewerLike').textContent=liked?kvIcon('like')+' Liked':kvIcon('like')+' Like';document.getElementById('viewerLikeSummary').textContent=` · 👍 ${r.count}`}catch(e){showToast(e.message)}});
 document.querySelectorAll('#viewerStars [data-rating]').forEach(b=>b.onclick=async()=>{try{const r=await getJSON('/api/reviews',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({contentId:c.id,rating:Number(b.dataset.rating)})});document.getElementById('viewerRatingSummary').textContent=`${r.summary.rating} / 5 (${r.summary.ratingCount})`;document.querySelectorAll('#viewerStars [data-rating]').forEach(x=>x.textContent=Number(x.dataset.rating)<=Number(b.dataset.rating)?'★':'☆')}catch(e){showToast(e.message)}});
 await loadViewerComments(c.id);document.getElementById('viewerCommentSubmit')?.addEventListener('click',async()=>{const box=document.getElementById('viewerCommentText'),text=box.value.trim();if(!text)return;try{await getJSON('/api/comments',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({contentId:c.id,body:text})});box.value='';await loadViewerComments(c.id)}catch(e){showToast(e.message)}});
}
async function loadViewerComments(cid){const el=document.getElementById('viewerComments');if(!el)return;try{const d=await getJSON('/api/comments?contentId='+encodeURIComponent(cid));const rows=d.comments||[];el.innerHTML=rows.length?rows.slice().reverse().map(r=>`<div class="viewer-comment"><strong>${esc(r.username)}</strong><span class="muted"> · ${new Date(r.createdAt).toLocaleString()}</span><p>${esc(r.body)}</p></div>`).join(''):`<span class="muted">${x('noComments')}</span>`}catch{el.innerHTML=`<span class="muted">${x('noComments')}</span>`}}
function openReaderSettings(){const old=document.getElementById('readerSettingsPopover');old?.remove();const p=JSON.parse(localStorage.getItem('kv.readerSettings')||'{"fontSize":18,"lineHeight":1.7,"mode":"light"}');const d=document.createElement('div');d.id='readerSettingsPopover';d.className='reader-settings-popover';d.innerHTML=`<div class="card"><h3>${x('readerSettings')}</h3><label>${x('fontSize')} <input id="readerFontSize" type="range" min="14" max="30" value="${p.fontSize}"></label><div class="button-row"><button class="button" data-reader-mode="light">☀ ${x('light')}</button><button class="button" data-reader-mode="sepia">📜 ${x('sepia')}</button><button class="button" data-reader-mode="dark">🌙 ${x('dark')}</button></div><button class="primary" id="readerSettingsDone">${x('submit')}</button></div>`;document.body.appendChild(d);const apply=()=>{const size=Number(document.getElementById('readerFontSize').value);document.getElementById('viewerBody').style.fontSize=size+'px';document.getElementById('viewerBody').dataset.readerMode=p.mode;localStorage.setItem('kv.readerSettings',JSON.stringify({fontSize:size,lineHeight:p.lineHeight||1.7,mode:p.mode||'light'}))};document.getElementById('readerFontSize').oninput=apply;d.querySelectorAll('[data-reader-mode]').forEach(b=>b.onclick=()=>{p.mode=b.dataset.readerMode;apply()});document.getElementById('readerSettingsDone').onclick=()=>d.remove();apply()}

function bindContentButtons(){document.querySelectorAll('[data-open-content]').forEach(b=>b.onclick=()=>openContent(b.dataset.openContent));document.querySelectorAll('[data-public-profile]').forEach(a=>a.onclick=e=>{e.preventDefault();openPublicProfile(a.dataset.publicProfile)});document.querySelectorAll('[data-save-content]').forEach(b=>b.onclick=async()=>{try{await getJSON('/api/library/save',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({contentId:b.dataset.saveContent,saved:true})});b.textContent='✓ '+t('saved')}catch(e){if(e.message==='login_required')openLogin()}})}
async function loadWriting(){try{const d=await getJSON('/api/my-content');state.myContent=d.content||[];const list=document.getElementById('writingList');if(!list)return;list.innerHTML=state.myContent.map(c=>{const approval=c.approval?.state||'draft';return `<article class="writing-item"><div><span class="pill">${esc(c.status)} · ${esc(approval)}</span><h3>${esc(c.title)}</h3><p>${esc(c.type)} · ${esc(c.category||'')}</p>${approval==='pending_admin'?`<p>${kvIcon('spark')} ${x('pendingAdmin')}</p>`:''}</div><div class="button-row"><button class="button" data-edit="${c.id}">${x('edit')||x('edit')}</button>${c.status==='published'?`<button class="button" data-unpublish="${c.id}">${x('unpublish')}</button>`:''}<button class="button" data-delete="${c.id}">${x('delete')}</button></div></article>`}).join('')||`<div class="empty card">${x('noDrafts')}</div>`;bindWriting()}catch{}}
function bindWriting(){document.querySelectorAll('[data-revisions]').forEach(b=>b.onclick=async()=>{try{const d=await getJSON('/api/content/revisions?contentId='+encodeURIComponent(b.dataset.revisions));showToast((d.revisions||[]).map(r=>new Date(r.createdAt).toLocaleString()+' — '+r.title).join('\n')||'No revision history yet.')}catch(e){showToast(e.message)}});document.querySelectorAll('[data-duplicate]').forEach(b=>b.onclick=async()=>{try{await getJSON('/api/content/'+b.dataset.duplicate+'/duplicate',{method:'POST'});loadWriting()}catch(e){showToast(e.message)}});document.querySelectorAll('[data-edit]').forEach(b=>b.onclick=()=>openEditor(b.dataset.edit));document.querySelectorAll('[data-delete]').forEach(b=>b.onclick=async()=>{if(await uiConfirm('Delete this content?')){await getJSON('/api/content/'+b.dataset.delete,{method:'DELETE'});loadWriting()}});document.querySelectorAll('[data-unpublish]').forEach(b=>b.onclick=async()=>{await getJSON('/api/content/'+b.dataset.unpublish,{method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify({status:'unpublished'})});loadWriting()});document.querySelectorAll('[data-create-draft]').forEach(b=>b.onclick=()=>navigate('editor'));document.querySelectorAll('[data-subscribe]').forEach(b=>b.onclick=()=>toggleSubscription(b.dataset.subscribe))}
function toggleSubscription(type){navigate('subscriptions')}
function populateEditorWorkTypes(type,selected=''){const s=document.getElementById('editorWorkType');if(!s)return;s.innerHTML=(WORK_TYPES_BY_TYPE[type]||[]).map(k=>`<option value="${k}">${esc(WORK_TYPE_LABEL(type,k))}</option>`).join('');s.value=selected||s.options[0]?.value||''}
async function openEditor(cid){navigate('editor');setTimeout(()=>{if(!cid)return;const c=state.myContent.find(x=>x.id===cid);if(!c)return;const f=document.getElementById('editorForm');f.dataset.id=cid;document.getElementById('editorTitle').value=c.title;document.getElementById('editorBody').innerHTML=c.body;document.getElementById('editorType').value=c.type;populateEditorWorkTypes(c.type,c.workType);document.getElementById('editorCategory').value=c.category;document.getElementById('editorPart').value=c.partNumber;document.getElementById('editorSeries').value=c.seriesId||'';document.getElementById('editorSummary').value=c.summary||'';document.getElementById('editorCover').value=c.cover||'';document.getElementById('rightsConfirmed').checked=!!c.rightsConfirmed;document.getElementById('mediaRightsConfirmed').checked=!!c.mediaRightsConfirmed;state.editorMedia=(c.mediaItems||[]).map(a=>({assetId:a.assetId,filename:a.filename,mimeType:a.mimeType,hls:a.hls}));const ml=document.getElementById('editorMediaList');if(ml)ml.innerHTML=state.editorMedia.map((a,i)=>`<div class="media-attachment"><span>${esc(a.filename||a.assetId)} · ${esc(a.mimeType)}</span></div>`).join('');getJSON('/api/content/'+encodeURIComponent(cid)+'/studio').then(d=>{state.studioProject=d.studio?.project||d.story?.studioProject||{};renderStudioWorkspace(c.type,state.studioProject);bindStudioControls()}).catch(()=>{state.studioProject={};renderStudioWorkspace(c.type,state.studioProject);bindStudioControls()})},50)}
async function saveEditor(status='draft',publishAt=null){
 const f=document.getElementById('editorForm'),mediaIds=(state.editorMedia||[]).map(a=>a.assetId).filter(Boolean);
 const type=document.getElementById('editorType').value;
 const base={title:document.getElementById('editorTitle').value.trim(),body:document.getElementById('editorBody').innerHTML,category:document.getElementById('editorCategory').value.trim(),type,workType:document.getElementById('editorWorkType').value,partNumber:Number(document.getElementById('editorPart').value||1),seriesId:document.getElementById('editorSeries').value.trim()||null,summary:document.getElementById('editorSummary').value.trim(),cover:document.getElementById('editorCover').value.trim(),rightsConfirmed:document.getElementById('rightsConfirmed').checked,mediaRightsConfirmed:document.getElementById('mediaRightsConfirmed').checked,mediaAssetId:mediaIds[0]||null,mediaAssetIds:mediaIds};
 if(!base.title){document.getElementById('editorStatus').textContent=x('titleRequired');return}
 if((type==='comic'||type==='audio'||type==='reel')&&!mediaIds.length){document.getElementById('editorStatus').textContent=x('mediaRequiredBeforePublish');if(status!=='draft')return}
 try{
  const cid=f.dataset.id;
  let r=await getJSON(cid?'/api/content/'+cid:'/api/content',{method:cid?'PATCH':'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({...base,status:'draft'})});
  const idValue=cid||r.content.id; if(!cid)f.dataset.id=idValue;
  if(state.studioProject&&typeof state.studioProject==='object'&&Object.keys(state.studioProject).length){
   await getJSON('/api/content/'+encodeURIComponent(idValue)+'/studio',{method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify({project:state.studioProject})});
  }
  if(status==='published'||status==='scheduled'){
   const pub=await getJSON('/api/studio/publish/'+encodeURIComponent(idValue),{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({status,publishAt,rightsConfirmed:base.rightsConfirmed,mediaRightsConfirmed:base.mediaRightsConfirmed,idempotencyKey:'ui-'+Date.now()})});
   r={...r,publication:pub.publication||pub,replayed:pub.replayed};
  }
  const pub=r.publication;
  if(pub?.status==='pending_review')document.getElementById('editorStatus').textContent=x('submittedForAdminReview');
  else if(pub?.status==='rejected_deleted')document.getElementById('editorStatus').textContent=x('rejectedDeletedPolicy');
  else document.getElementById('editorStatus').textContent=status==='published'?x('publishedSuccess'):status==='scheduled'?x('scheduledSuccess'):x('save');
  document.getElementById('saveState').textContent=x('autosave');
 }catch(e){document.getElementById('editorStatus').textContent=e.message==='creator_subscription_required'?x('creatorSub'):e.message}
}
function renderEditorMediaList(){
 const list=document.getElementById('editorMediaList');
 if(!list)return;
 list.innerHTML=(state.editorMedia||[]).map((a,i)=>`<div class="media-attachment"><span>${esc(a.filename||a.id)} · ${esc(a.mimeType)} · ${a.hls?x('hlsReady'):x('assetReady')}</span><button type="button" class="link-button" data-remove-editor-media="${i}" aria-label="Remove ${esc(a.filename||a.id)}">×</button></div>`).join('');
 list.querySelectorAll('[data-remove-editor-media]').forEach(b=>b.onclick=()=>{state.editorMedia.splice(Number(b.dataset.removeEditorMedia),1);renderEditorMediaList()});
}
async function uploadEditorMedia(){
 const input=document.getElementById('editorMediaFile'),status=document.getElementById('editorMediaStatus');const files=[...(input?.files||[])];
 if(!files.length){if(status)status.textContent=x('mediaRights');return}
 state.editorMedia=state.editorMedia||[];
 for(const f of files){
  const maxClient=(f.type==='application/pdf'?419430400:10*1024*1024);if(f.size>maxClient){status.textContent=`${esc(f.name)} · maximum ${Math.round(maxClient/1024/1024)} MB`;continue}
  try{
   const r=await getJSON('/api/media/assets/stream',{method:'POST',headers:{'Content-Type':f.type||'application/octet-stream','X-KV-Mime-Type':f.type||'','X-KV-Filename':encodeURIComponent(f.name)},body:f});
   state.editorMedia.push(r.asset);
   if((f.type||'').startsWith('audio/')||(f.type||'').startsWith('video/')){
     const h=await getJSON('/api/media/hls/create',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({assetId:r.asset.id})});
     const item=state.editorMedia[state.editorMedia.length-1];item.hls=h.hls;
   }
   status.textContent=`✓ ${files.length} · ${x('save')}`;
  }catch(e){status.textContent=`${esc(f.name)}: ${e.message}`}
 }
 renderEditorMediaList();
}
async function loadSeriesManager(){const box=document.getElementById('seriesList');if(!box)return;const d=await getJSON('/api/my-content'),groups={};for(const c of d.content.filter(x=>x.seriesId))(groups[c.seriesId]??=[]).push(c);box.innerHTML=Object.entries(groups).map(([sid,items])=>`<section class="card"><h2>${esc(sid)}</h2>${items.sort((a,b)=>a.partNumber-b.partNumber).map(c=>`<div class="writing-item"><span>${c.partNumber}. ${esc(c.title)} <small>${esc(c.status)} · ${esc(c.seriesStatus||'ongoing')}</small></span><div class="button-row"><button class="button" data-move-up="${c.id}" data-series="${esc(sid)}">↑</button><button class="button" data-move-down="${c.id}" data-series="${esc(sid)}">↓</button><button class="button" data-add-part="${c.id}">${kvIcon('plus')} ${x('addPart')||x('addPart')}</button><button class="button" data-series-status="${c.id}">${(c.seriesStatus||'ongoing')==='completed'?x('reopen'):x('complete')}</button></div></div>`).join('')}</section>`).join('')||'<div class="empty card">No series parts yet.</div>';document.querySelectorAll('[data-move-up],[data-move-down]').forEach(b=>b.onclick=()=>reorderPart(b.dataset.id,b.dataset.series,b.hasAttribute('data-move-up')?-1:1));document.querySelectorAll('[data-add-part]').forEach(b=>b.onclick=async()=>{try{const title=await uiPrompt(x('newPartTitle'));if(!title)return;await getJSON('/api/content/'+encodeURIComponent(b.dataset.addPart)+'/add-part',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({title})});await loadSeriesManager();showToast(x('newDraftPartCreated'))}catch(e){showToast(e.message,'error')}});document.querySelectorAll('[data-series-status]').forEach(b=>b.onclick=async()=>{try{const current=b.closest('.writing-item')?.querySelector('small')?.textContent||'';const status=current.includes('completed')?'ongoing':'completed';await getJSON('/api/content/'+encodeURIComponent(b.dataset.seriesStatus)+'/series-status',{method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify({status})});await loadSeriesManager()}catch(e){showToast(e.message,'error')}})}
async function reorderPart(id,sid,dir){const d=await getJSON('/api/my-content'),items=d.content.filter(c=>c.seriesId===sid).sort((a,b)=>a.partNumber-b.partNumber),i=items.findIndex(c=>c.id===id),j=i+dir;if(i<0||j<0||j>=items.length)return;[items[i].partNumber,items[j].partNumber]=[items[j].partNumber,items[i].partNumber];await getJSON('/api/series/reorder',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({parts:items.map(c=>({id:c.id,partNumber:c.partNumber}))})});loadSeriesManager()}
async function loadProfile(){try{const d=await getJSON('/api/profile'),p=d.profile;for(const [id,val] of [['profileName',p.name],['profileLocation',p.location],['profileAddress',p.address],['profileDob',p.dob],['profileGender',p.gender],['profilePhoto',p.profilePhoto]]){const e=document.getElementById(id);if(e)e.value=val||''}const pm=document.getElementById('profileMobile');if(pm)pm.textContent=p.mobile||'—';const phone=document.getElementById('phoneSettingsValue');if(phone)phone.textContent=p.mobile||'—';const pe=document.getElementById('profileEmail');if(pe)pe.textContent=p.email||'—';const vs=document.getElementById('verificationState');if(vs)vs.textContent=`Mobile: ${p.mobileVerified?'Verified':x('notVerified')} · Email: ${p.emailVerified?'Verified':x('notVerified')}`}catch{}}
async function saveProfile(e){e.preventDefault();const b={name:document.getElementById('profileName').value,location:document.getElementById('profileLocation').value,address:document.getElementById('profileAddress').value,dob:document.getElementById('profileDob').value,gender:document.getElementById('profileGender').value,profilePhoto:document.getElementById('profilePhoto').value};try{await getJSON('/api/profile',{method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify(b)});document.getElementById('profileStatus').textContent=x('saveProfile')}catch(err){document.getElementById('profileStatus').textContent=err.message}}
async function startContactChange(kind){const value=await uiPrompt(kind==='mobile'?x('mobile'):x('email'));if(!value)return;try{const r=await getJSON('/api/profile/change-contact',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({kind,value})});state.otpContext={target:r.target,purpose:r.purpose};const otp=await uiPrompt(`${x('otpSent')}${r.demoOtp?'\n'+x('demoOtp')+': '+r.demoOtp:''}`);if(!otp)return;await getJSON('/api/profile/verify-contact',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({target:r.target,purpose:r.purpose,otp})});render('account')}catch(e){showToast(e.message)}}
function renderMobileNav(){
 const nav=document.getElementById('primaryNav');
 if(!nav)return;
 const item=(route,label)=>routeLink(route,label,'mobile-nav-link');
 let html='<div class="nav-group-label">'+x('formats')+'</div><div class="nav-format-group">';
 html+=item('stories',kvIcon('book')+x('stories'))+item('comic',kvIcon('comic')+x('comic'))+item('audio',kvIcon('audio')+x('audio'))+item('reel',kvIcon('reel')+x('reel'));
 html+='</div>'+item('discover',kvIcon('search')+x('discover'))+item('categories',kvIcon('library')+x('categories'))+item('subscriptions',kvIcon('coins')+x('subscriptionBilling'))+item('stickers',kvIcon('sticker')+x('coinBilling'))+item('notifications',kvIcon('bell')+x('notificationCenter'))+item('messages',kvIcon('message')+x('messageBox'));
 if(state.user){
  html+=item('account',kvIcon('profile')+x('profile'))+item('reader-dashboard',kvIcon('dashboard')+x('readerDashboard'))+item('author-dashboard',kvIcon('write')+x('authorDashboard'))+item('write',kvIcon('write')+x('write'))+item('editor',kvIcon('settings')+'Creator Studio')+item('media-tools',kvIcon('audio')+'Media Studio')+item('account-settings',kvIcon('settings')+x('profileSettings'))+item('settings',kvIcon('settings')+t('settings'))+item('help',kvIcon('help')+t('help'));
 }else{
  html+='<button type="button" class="mobile-nav-link" data-open-login>'+kvIcon('login')+t('login')+'</button>';
  html+='<button type="button" class="mobile-nav-link" data-register>'+kvIcon('userPlus')+x('createAccount')+'</button>';
  html+=item('settings',kvIcon('settings')+t('settings'))+item('help',kvIcon('help')+t('help'));
 }
 nav.innerHTML=html;
}
function updateHeader(){const a=document.querySelector('.header-actions');renderMobileNav();if(!a)return;let auth;if(state.user){const avatar=state.user.profilePhoto?`<img src="${esc(state.user.profilePhoto)}" alt="${esc(state.user.username)}">`:esc((state.user.name||state.user.username||'U').slice(0,1).toUpperCase());auth=`<div class="header-icon-actions"><button class="icon-button" id="notificationHeaderButton" type="button" title="${x('notificationCenter')}">${kvIcon('bell')}</button><button class="profile-header-button ${state.user.profilePhoto?'':'avatar-fallback'}" id="profileHeaderButton" type="button" title="${x('profile')}">${avatar}</button></div>`}else{auth=`<button id="openLogin" class="primary" type="button">${t('login')}</button>`}a.innerHTML=auth;const pb=document.getElementById('profileHeaderButton');if(pb)pb.onclick=openProfileMenu;const nb=document.getElementById('notificationHeaderButton');if(nb)nb.onclick=()=>navigate('notifications');const login=document.getElementById('openLogin');if(login)login.onclick=openLogin}
async function probeStudioRuntimeCapabilities(){
 const out={browser:{webgpu:false,webcodecs:false,wasm:false,offscreenCanvas:false,hardwareConcurrency:navigator.hardwareConcurrency||null,deviceMemory:navigator.deviceMemory||null},server:null};
 try{out.browser.wasm=typeof WebAssembly!=='undefined';out.browser.offscreenCanvas=typeof OffscreenCanvas!=='undefined';}catch{}
 try{if(navigator.gpu){const ad=await navigator.gpu.requestAdapter();out.browser.webgpu=!!ad; if(ad&&typeof ad.requestAdapterInfo==='function'){try{const i=await ad.requestAdapterInfo();out.browser.gpuVendor=i.vendor||null;out.browser.gpuArchitecture=i.architecture||null;}catch{}}}}catch{}
 try{if(typeof VideoEncoder!=='undefined'&&typeof VideoEncoder.isConfigSupported==='function'){const r=await VideoEncoder.isConfigSupported({codec:'avc1.640034',width:2160,height:3840,framerate:60,bitrate:42500000});out.browser.webcodecs=!!r.supported;}}catch{}
 try{const r=await getJSON('/api/studio/runtime-capabilities');out.server=r.capabilities||null;}catch(e){out.server={error:e.message};}
 window.kv30StudioRuntime=out;return out;
}

function bindStudioControls(){
 const type=document.getElementById('editorType')?.value||'story';
 document.querySelectorAll('[data-studio-tab]').forEach(b=>b.onclick=()=>{document.querySelectorAll('[data-studio-tab]').forEach(x=>x.classList.remove('active'));b.classList.add('active');document.getElementById('studioWorkspace')?.scrollIntoView({block:'nearest',behavior:'smooth'})});
 document.getElementById('studioAiPlan')?.addEventListener('click',async()=>{try{const r=await getJSON('/api/ai/creator-studio-plan',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({type,title:document.getElementById('editorTitle')?.value||'',prompt:document.getElementById('editorBody')?.innerText||''})});state.studioProject=r.plan||{};renderStudioWorkspace(type,state.studioProject);document.getElementById('studioStatus').textContent='AI plan ready — creator approval required.'}catch(e){document.getElementById('studioStatus').textContent=e.message}});
 document.getElementById('studioSave')?.addEventListener('click',async()=>{const f=document.getElementById('editorForm'),cid=f?.dataset.id;if(!cid){document.getElementById('studioStatus').textContent='Save the draft once before saving the studio project.';return}try{const endpoint=type==='story'?'/api/studio/story/'+encodeURIComponent(cid):'/api/content/'+encodeURIComponent(cid)+'/studio';const method=type==='story'?'PUT':'PATCH';await getJSON(endpoint,{method,headers:{'Content-Type':'application/json'},body:JSON.stringify({project:state.studioProject})});document.getElementById('studioStatus').textContent='Studio project saved.'}catch(e){document.getElementById('studioStatus').textContent=e.message}});
}
function openPublicProfile(userId){const uid=String(userId||'').trim();if(!uid)return;history.pushState({},'',`/profile?userId=${encodeURIComponent(uid)}`);render('account')}
function speechLocale(code){const m={en:'en-IN',as:'as-IN',bn:'bn-IN',brx:'hi-IN',doi:'hi-IN',gu:'gu-IN',hi:'hi-IN',kn:'kn-IN',ks:'ks-IN',kok:'kok-IN',mai:'mai-IN',ml:'ml-IN',mni:'mni-IN',mr:'mr-IN',ne:'ne-NP',or:'or-IN',pa:'pa-IN',sa:'sa-IN',sat:'sat-IN',sd:'sd-IN',ta:'ta-IN',te:'te-IN',ur:'ur-IN'};return m[String(code||'en').split('-')[0]]||'en-IN'}

function kvIcon(name){const p={home:'<path d="M3 11.5 12 4l9 7.5"/><path d="M5.5 10.5V20h13v-9.5"/><path d="M9.5 20v-5h5v5"/>',search:'<circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/>',library:'<rect x="4" y="4" width="16" height="16" rx="2"/><path d="M8 4v16M12 8h5M12 12h5M12 16h3"/>',write:'<path d="m4 20 4.2-1 9.7-9.7a2.1 2.1 0 0 0-3-3L5.2 16 4 20Z"/><path d="m13.8 7.2 3 3"/>',profile:'<circle cx="12" cy="8" r="3.5"/><path d="M5 20c.8-3.5 3.1-5.5 7-5.5s6.2 2 7 5.5"/>',book:'<path d="M5 4.5A2.5 2.5 0 0 1 7.5 2H20v17H7.5A2.5 2.5 0 0 0 5 21V4.5Z"/><path d="M5 4.5V21M9 6h7M9 10h7"/>',comic:'<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M7 9h3M14 9h3M7 14h10M8 18h8"/>',audio:'<path d="M5 9v6M9 6v12M13 3v18M17 6v12M21 9v6"/>',reel:'<rect x="4" y="5" width="16" height="14" rx="2"/><path d="m10 9 5 3-5 3Z"/>',bell:'<path d="M18 9a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9Z"/><path d="M10 21h4"/>',settings:'<path d="M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M18.4 5.6l-2.1 2.1M7.7 16.3l-2.1 2.1"/><circle cx="12" cy="12" r="4"/>',help:'<circle cx="12" cy="12" r="9"/><path d="M9.6 9a2.5 2.5 0 1 1 4.5 1.5c-.8 1-2.1 1.3-2.1 2.8M12 17h.01"/>',lock:'<rect x="5" y="10" width="14" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/>',coins:'<circle cx="12" cy="12" r="7"/><path d="M9 9.5h5.5a2 2 0 0 1 0 4H10a2 2 0 0 0 0 4h3"/><path d="M12 6v2M12 16v2"/>',sticker:'<path d="M5 4h10l4 4v12H5z"/><path d="M15 4v5h5M8 13h8M8 17h5"/>',logout:'<path d="M10 5H5v14h5M14 8l4 4-4 4M8 12h10"/>',login:'<path d="M15 5h4v14h-4M11 8l-4 4 4 4M7 12h10"/>',userPlus:'<circle cx="9" cy="8" r="3"/><path d="M3.5 20c.6-3.4 2.5-5.2 5.5-5.2s4.9 1.8 5.5 5.2M17 8v6M14 11h6"/>',message:'<path d="M4 5h16v11H8l-4 4V5Z"/><path d="M8 9h8M8 12h5"/>',dashboard:'<rect x="4" y="4" width="7" height="7" rx="1"/><rect x="13" y="4" width="7" height="7" rx="1"/><rect x="4" y="13" width="7" height="7" rx="1"/><rect x="13" y="13" width="7" height="7" rx="1"/>',megaphone:'<path d="m4 12 12-5v10L4 12Z"/><path d="M16 10h3a2 2 0 0 1 0 4h-3M7 14l1.5 5"/>',trophy:'<path d="M8 4h8v4a4 4 0 0 1-8 0V4Z"/><path d="M8 6H5a3 3 0 0 0 3 4M16 6h3a3 3 0 0 1-3 4M12 12v4M8 20h8M10 16h4"/>',spark:'<path d="m12 3 1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8L12 3Z"/>',bookmark:'<path d="M6 4h12v16l-6-3-6 3V4Z"/>',download:'<path d="M12 4v11M8 11l4 4 4-4M5 20h14"/>',plus:'<path d="M12 5v14M5 12h14"/>',shield:'<path d="M12 3 19 6v5c0 4.4-2.9 8-7 10-4.1-2-7-5.6-7-10V6l7-3Z"/><path d="m9 12 2 2 4-4"/>',palette:'<path d="M12 3a9 9 0 0 0 0 18h1.2a1.8 1.8 0 0 0 0-3.6H12a1.5 1.5 0 0 1 0-3h2.2A6.8 6.8 0 0 0 12 3Z"/><circle cx="7.5" cy="9" r=".8"/><circle cx="10" cy="6.5" r=".8"/><circle cx="14" cy="6.5" r=".8"/>',phone:'<rect x="7" y="3" width="10" height="18" rx="2"/><path d="M10 6h4M11 18h2"/>',mail:'<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/>',globe:'<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c3 3.2 3 14.8 0 18M12 3c-3 3.2-3 14.8 0 18"/>','save':'<path d="M5 4h14v16l-7-3-7 3V4Z"/><path d="M8 4v5h8V4"/>','waveform':'<path d="M3 12h2M7 8v8M11 4v16M15 7v10M19 9v6M22 12h-2"/>','mix':'<path d="M4 6h5l6 12h5M4 18h5L15 6h5"/><path d="M18 4h3v3M18 20h3v-3"/>','scissors':'<circle cx="6" cy="7" r="2.5"/><circle cx="6" cy="17" r="2.5"/><path d="m8 8 12 10M8 16 20 6"/>','play':'<path d="m8 5 11 7-11 7V5Z"/>','folder':'<path d="M3 7h7l2 2h9v10H3V7Z"/>','history':'<path d="M4 12a8 8 0 1 0 2.3-5.7"/><path d="M4 5v5h5M12 8v4l3 2"/>','document':'<path d="M6 3h9l4 4v14H6z"/><path d="M15 3v5h4M9 12h6M9 16h6"/>','attachment':'<path d="m8 12 5.5-5.5a3.2 3.2 0 0 1 4.5 4.5l-7.2 7.2a4.5 4.5 0 0 1-6.4-6.4l7-7"/>','ticket':'<path d="M4 6h16v4a2 2 0 0 0 0 4v4H4v-4a2 2 0 0 0 0-4V6Z"/><path d="M9 9h6M9 15h6"/>','crown':'<path d="m4 7 4 4 4-6 4 6 4-4-2 12H6L4 7Z"/>','share':'<circle cx="18" cy="5" r="2.5"/><circle cx="6" cy="12" r="2.5"/><circle cx="18" cy="19" r="2.5"/><path d="m8.2 10.8 7.5-4.4M8.2 13.2l7.5 4.4"/>','like':'<path d="M7 10v10H4V10h3ZM9 20h7.2a2 2 0 0 0 2-1.7l1-6a2 2 0 0 0-2-2.3h-4l.6-3.2A2.3 2.3 0 0 0 11.5 4L9 10v10Z"/>','chevron':'<path d="m9 6 6 6-6 6"/>','fingerprint':'<path d="M7 10a5 5 0 0 1 10 0v2M5 10a7 7 0 0 1 14 0v4M9 15v2M12 10v9M15 15v3"/>','refresh':'<path d="M20 11a8 8 0 0 0-14-5L4 8M4 5v3h3M4 13a8 8 0 0 0 14 5l2-2M20 19v-3h-3"/>','payment':'<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 9h18M7 14h4"/>','accessibility':'<circle cx="12" cy="5" r="2"/><path d="M5 9h14M12 7v13M8 21l4-6 4 6M8 10l-3 5M16 10l3 5"/>','insights':'<path d="M4 19V9M10 19V5M16 19v-8M22 19H2"/>'};return `<svg class="kv-svg-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">${p[name]||p.help}</g></svg>`}
function uiPrompt(message,defaultValue=''){return new Promise(resolve=>{let d=document.getElementById('kvActionDialog');if(!d){d=document.createElement('dialog');d.id='kvActionDialog';d.innerHTML='<form method="dialog" class="kv-action-form"><div class="dialog-header"><h2>Katha Vistaar</h2><button type="button" id="kvActionClose" aria-label="Close">×</button></div><p id="kvActionMessage" class="muted"></p><input id="kvActionInput" type="text" autocomplete="off"><div class="dialog-actions"><button type="button" class="button" id="kvActionCancel">Cancel</button><button type="submit" class="primary">OK</button></div></form>';document.body.appendChild(d)}const input=d.querySelector('#kvActionInput');d.querySelector('#kvActionMessage').textContent=String(message||'');input.type=/admin|key|password|secret/i.test(String(message||''))?'password':'text';input.value=defaultValue??'';let settled=false;const finish=v=>{if(settled)return;settled=true;d.close();resolve(v)};d.querySelector('#kvActionClose').onclick=()=>finish(null);d.querySelector('#kvActionCancel').onclick=()=>finish(null);d.querySelector('form').onsubmit=e=>{e.preventDefault();finish(input.value)};d.addEventListener('cancel',()=>finish(null),{once:true});d.showModal();setTimeout(()=>input.focus(),0)})}
function uiConfirm(message){return new Promise(resolve=>{let d=document.getElementById('kvConfirmDialog');if(!d){d=document.createElement('dialog');d.id='kvConfirmDialog';d.innerHTML='<form method="dialog" class="kv-action-form"><div class="dialog-header"><h2>Katha Vistaar</h2><button type="button" id="kvConfirmClose" aria-label="Close">×</button></div><p id="kvConfirmMessage" class="muted"></p><div class="dialog-actions"><button type="button" class="button" id="kvConfirmNo">Cancel</button><button type="submit" class="primary">Confirm</button></div></form>';document.body.appendChild(d)}d.querySelector('#kvConfirmMessage').textContent=String(message||'');let settled=false;const finish=v=>{if(settled)return;settled=true;d.close();resolve(v)};d.querySelector('#kvConfirmClose').onclick=()=>finish(false);d.querySelector('#kvConfirmNo').onclick=()=>finish(false);d.querySelector('form').onsubmit=e=>{e.preventDefault();finish(true)};d.addEventListener('cancel',()=>finish(false),{once:true});d.showModal()})}
function showToast(message,type='info'){let t=document.getElementById('kvToast');if(!t){t=document.createElement('div');t.id='kvToast';t.className='kv-toast';document.body.appendChild(t)}t.textContent=String(message||'');t.dataset.type=type;t.classList.add('show');clearTimeout(showToast.timer);showToast.timer=setTimeout(()=>t.classList.remove('show'),2800)}
async function performLogout(){const buttons=[...document.querySelectorAll('[data-logout]')];buttons.forEach(b=>{b.disabled=true;b.setAttribute('aria-busy','true')});try{const r=await getJSON('/api/auth/logout',{method:'POST'});if(!r.loggedOut||!r.sessionInvalidated)throw new Error('logout_not_confirmed');const check=await getJSON('/api/auth/me');if(check.authenticated)throw new Error('session_still_active');state.user=null;state.otpContext=null;state.resetContext=null;state.myContent=[];sessionStorage.clear();localStorage.removeItem('kv.editor.autosave');closeProfileMenu?.();closeMobileMenu();updateHeader();history.replaceState({},'',ROUTE_PATHS.home);render('home');showToast('Logged out successfully.');}catch(e){buttons.forEach(b=>{b.disabled=false;b.removeAttribute('aria-busy')});showToast('Logout could not be confirmed. Please try again.','error');console.error('Katha Vistaar logout failure',e)}}

function bind(){function bindReaderProtection(){const el=document.getElementById('viewerBody');if(!el||el.dataset.protectionBound)return;el.dataset.protectionBound='1';['copy','cut','contextmenu','selectstart','dragstart'].forEach(ev=>el.addEventListener(ev,e=>{if(e.target.closest('input,textarea,button,video,audio'))return;e.preventDefault()}));document.addEventListener('keydown',e=>{if(!document.getElementById('contentViewer')?.open)return;if((e.ctrlKey||e.metaKey)&&['c','x','s','p'].includes(String(e.key).toLowerCase()))e.preventDefault()},{passive:false});}
document.querySelectorAll('[data-route]').forEach(a=>a.onclick=e=>{e.preventDefault();closeMobileMenu();navigate(a.dataset.route)});document.querySelectorAll('[data-competition]').forEach(b=>b.onclick=()=>showToast(`${b.dataset.competition} — ${t('competitionJoin')}`));document.querySelectorAll('[data-profile-tab]').forEach(b=>b.onclick=()=>{const tab=b.dataset.profileTab;document.querySelectorAll('[data-profile-tab]').forEach(x=>{const active=x===b;x.classList.toggle('active',active);x.setAttribute('aria-selected',String(active))});const panel=document.getElementById('profileTabPanel');if(panel){const labels={works:x('myWorks'),posts:x('posts'),updates:x('updates')};const text={works:t('writeText'),posts:'No public posts are available yet.',updates:'No public updates are available yet.'};panel.innerHTML=`<strong>${labels[tab]||labels.works}</strong><p class="muted">${text[tab]||text.works}</p>${tab==='works'?routeLink('write',x('open'),'button'):''}`;panel.querySelectorAll('[data-route]').forEach(a=>a.onclick=e=>{e.preventDefault();navigate(a.dataset.route)})}});document.querySelectorAll('[data-back]').forEach(b=>b.onclick=()=>{if(history.length>1)history.back();else navigate('home')});document.querySelectorAll('[data-open-login]').forEach(b=>b.onclick=openLogin);document.querySelectorAll('[data-register]').forEach(b=>b.onclick=openRegister);document.querySelectorAll('[data-public-profile]').forEach(a=>a.onclick=e=>{e.preventDefault();openPublicProfile(a.dataset.publicProfile)});const s=document.getElementById('searchBtn');if(s)s.onclick=()=>runSearch();const adv=document.getElementById('advancedSearchToggle');if(adv)adv.onclick=()=>{const p=document.getElementById('advancedSearchPanel');if(p){p.hidden=!p.hidden;if(!p.hidden)populateSearchFilters()}};const applyAdv=document.getElementById('applyAdvancedSearch');if(applyAdv)applyAdv.onclick=()=>runSearch(true);const st=document.getElementById('searchType');if(st)st.onchange=()=>populateSearchFilters();const et=document.getElementById('editorType');if(et){populateEditorWorkTypes(et.value);renderStudioWorkspace(et.value,state.studioProject);et.onchange=()=>{populateEditorWorkTypes(et.value);state.studioProject={};const host=document.querySelector('.creator-studio');if(host){host.outerHTML=studioPanel(et.value);renderStudioWorkspace(et.value,state.studioProject);bindStudioControls()}}}bindStudioControls();probeStudioRuntimeCapabilities().catch(()=>{});loadCreatorLimitsHint();const emu=document.getElementById('editorMediaUpload');if(emu)emu.onclick=uploadEditorMedia;
const cap=document.getElementById('creatorAiPlan');if(cap)cap.onclick=async()=>{const out=document.getElementById('creatorAiOutput');try{const r=await getJSON('/api/ai/creator-assist',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({type:document.getElementById('editorType')?.value||'story',title:document.getElementById('editorTitle')?.value||'',body:document.getElementById('editorBody')?.innerText||'',request:'Create a format-specific production plan: story chapters, comic panels/pages, FM episode/audio production, or reel shot/timing plan.'})});out.textContent=(r.assistant?.suggestions||[]).join(' ')}catch(e){out.textContent=e.message}};
const cag=document.getElementById('creatorAiGenerate');if(cag)cag.onclick=async()=>{const out=document.getElementById('creatorAiOutput');try{const r=await getJSON('/api/ai/creator-generate',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({type:document.getElementById('editorType')?.value||'story',title:document.getElementById('editorTitle')?.value||'',prompt:document.getElementById('editorBody')?.innerText||''})});document.getElementById('editorTitle').value=r.generated.title;document.getElementById('editorBody').innerHTML=r.generated.body;out.textContent='Internal AI created a draft scaffold. Review and approve it yourself; AI cannot publish it.'}catch(e){out.textContent=e.message}};const vd=document.getElementById('voiceDictate');if(vd)vd.onclick=()=>{const SR=window.SpeechRecognition||window.webkitSpeechRecognition;if(!SR){document.getElementById('creatorAiOutput').textContent='Voice-to-text is not available in this browser; use the keyboard microphone if your device provides it.';return}const rec=new SR();rec.lang=speechLocale(state.uiLanguage);rec.interimResults=false;rec.onresult=e=>{document.getElementById('editorBody').innerText+=' '+e.results[0][0].transcript};rec.onerror=e=>document.getElementById('creatorAiOutput').textContent='Voice input error: '+e.error;rec.start();document.getElementById('creatorAiOutput').textContent='Listening… speak now.'};
const aiEt=document.getElementById('editorType'),ci=document.getElementById('comicIllustratorAssist'),apc=document.getElementById('audioPacingAssist'),sb=document.getElementById('storyboardAssist'),da=document.getElementById('dialogueArchitectAssist');if(aiEt){const syncAiFormat=()=>{if(ci)ci.hidden=aiEt.value!=='comic';if(apc)apc.hidden=aiEt.value!=='audio';if(sb)sb.hidden=!['story','reel'].includes(aiEt.value);if(da)da.hidden=!['story','comic','audio'].includes(aiEt.value);const ch=document.getElementById('characterArchitectAssist');if(ch)ch.hidden=!['story','comic','audio','reel'].includes(aiEt.value);const sm=document.getElementById('storyMapAssist');if(sm)sm.hidden=aiEt.value!=='story';};syncAiFormat();aiEt.addEventListener('change',syncAiFormat)}if(ci)ci.onclick=async()=>{const out=document.getElementById('creatorAiOutput');try{const r=await getJSON('/api/ai/comic-illustrator',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({prompt:document.getElementById('editorBody')?.innerText||document.getElementById('editorTitle')?.value||'',panels:3})});out.textContent=r.panels.map(p=>`Panel ${p.panel}: ${p.scene} — ${p.dialogue}`).join(' | ')+' AI proposal only; creator approval required.'}catch(e){out.textContent=e.message}};if(apc)apc.onclick=async()=>{const out=document.getElementById('creatorAiOutput');try{const r=await getJSON('/api/ai/audio-pacing',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({script:document.getElementById('editorBody')?.innerText||''})});out.textContent=`Estimated ${r.estimatedSeconds}s. `+r.segments.map(s=>`${s.name}: ${s.seconds}s`).join(' · ')+' AI proposal only; creator approval required.'}catch(e){out.textContent=e.message}};if(sb)sb.onclick=async()=>{const out=document.getElementById('creatorAiOutput');try{const r=await getJSON('/api/ai/storyboard',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({prompt:document.getElementById('editorBody')?.innerText||document.getElementById('editorTitle')?.value||'',scenes:5})});out.textContent=r.scenes.map(s=>`Scene ${s.scene}: ${s.title} — ${s.visual} — ${s.action}`).join(' | ')+' AI proposal only; creator approval required.'}catch(e){out.textContent=e.message}};if(da)da.onclick=async()=>{const out=document.getElementById('creatorAiOutput');try{const r=await getJSON('/api/ai/dialogue-architect',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({context:document.getElementById('editorBody')?.innerText||document.getElementById('editorTitle')?.value||'',speakers:2})});out.textContent=r.dialogue.map(d=>`${d.speaker}: ${d.line}`).join(' | ')+' AI proposal only; creator approval required.'}catch(e){out.textContent=e.message}};const ch=document.getElementById('characterArchitectAssist');if(ch)ch.onclick=async()=>{const out=document.getElementById('creatorAiOutput');try{const r=await getJSON('/api/ai/character-assist',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({type:document.getElementById('editorType')?.value||'story',title:document.getElementById('editorTitle')?.value||'',body:document.getElementById('editorBody')?.innerText||''})});out.innerHTML=`<strong>${esc(x('aiResult'))}</strong><br>${esc((r.proposal?.suggestions||[]).join(' '))}<br><span class="muted">${esc(x('aiNoExternal'))} Creator approval required.</span>`}catch(e){out.textContent=e.message}};const sm=document.getElementById('storyMapAssist');if(sm)sm.onclick=async()=>{const out=document.getElementById('creatorAiOutput');try{const r=await getJSON('/api/ai/story-mapper',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({premise:document.getElementById('editorBody')?.innerText||document.getElementById('editorTitle')?.value||x('currentStoryPremise'),branches:3})});out.innerHTML=`<strong>${esc(x('aiResult'))}</strong><br>${esc((r.nodes||[]).map(n=>n.label+': '+n.direction).join(' · '))}<br><span class="muted">${esc(x('aiNoExternal'))} Creator approval required.</span>`}catch(e){out.textContent=e.message}};
const cai=document.getElementById('creatorAiSuggest');if(cai)cai.onclick=async()=>{const out=document.getElementById('creatorAiOutput');try{const r=await getJSON('/api/ai/creator-assist',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({type:document.getElementById('editorType')?.value||'story',title:document.getElementById('editorTitle')?.value||'',body:document.getElementById('editorBody')?.innerText||''})});out.textContent=(r.assistant?.suggestions||[]).join(' ');if(r.assistant?.authorApprovalRequired)out.textContent+=' AI suggestions never change or publish your work without your approval.'}catch(e){out.textContent=e.message}};document.querySelectorAll('[data-cmd]').forEach(b=>b.onclick=()=>{document.execCommand(b.dataset.cmd,false,b.dataset.value||null);document.getElementById('editorBody')?.focus()});const sf=document.querySelector('[data-save-editor]');if(sf)sf.onclick=()=>saveEditor('draft');const pf=document.querySelector('[data-publish-editor]');if(pf)pf.onclick=()=>saveEditor('published');const sc=document.querySelector('[data-schedule-editor]');if(sc)sc.onclick=async()=>{const d=await uiPrompt(x('scheduleFormat'));if(d)saveEditor('scheduled',d)};const pv=document.querySelector('[data-preview-editor]');if(pv)pv.onclick=()=>{document.getElementById('viewerTitle').textContent=document.getElementById('editorTitle').value;document.getElementById('viewerBody').innerHTML=document.getElementById('editorBody').innerHTML;document.getElementById('viewerMeta').textContent='Preview';document.getElementById('contentViewer').showModal()};document.querySelectorAll('[data-subscribe]').forEach(b=>b.onclick=()=>toggleSubscription(b.dataset.subscribe));document.querySelectorAll('[data-change-contact]').forEach(b=>b.onclick=()=>startContactChange(b.dataset.changeContact));const pfm=document.getElementById('profileForm');if(pfm)pfm.onsubmit=saveProfile;document.getElementById('enablePasskey')?.addEventListener('click',registerPasskey);const sl=document.getElementById('settingsLanguage');if(sl)sl.onclick=openLanguageDialog;populateReadingLanguage();loadUserPreferencesUI();loadDeviceAccessUI();const ap=document.querySelector('[data-appeal]');if(ap)ap.onclick=async()=>{const apology=document.getElementById('apology').value;await getJSON('/api/account/appeal',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({apology})});showToast(x('appealSubmitted'))};document.querySelector('[data-admin-ai-login]')?.addEventListener('click',adminAiLogin);const lo=document.querySelector('[data-logout]');if(lo)lo.onclick=performLogout;bindLibraryTabs();document.querySelectorAll('[data-category-type]').forEach(b=>b.onclick=()=>{const type=b.dataset.categoryType;state.categoryByType[type]=b.dataset.category||null;render(currentRoute())});document.querySelectorAll('[data-work-type-format]').forEach(b=>b.onclick=()=>{state.workTypeByType[b.dataset.workTypeFormat]=b.dataset.workType||null;render(currentRoute())})}
async function loadDeviceAccessUI(){const box=document.getElementById('deviceAccessSettings');if(!box)return;try{const d=await getJSON('/api/preferences/device-access');const labels={microphone:'Microphone',camera:'Camera',photos:'Photos / Gallery',media:'Audio / Video Media',notifications:x('notifications'),location:'Location',clipboard:'Clipboard'};box.innerHTML=Object.entries(labels).map(([k,v])=>`<label class="toggle-row"><input type="checkbox" data-device-access="${k}" ${d.access[k]?'checked':''}> <span>${v}</span></label>`).join('')+'<p class="muted">Turning a capability off does not grant it to the app. When a feature needs it, Katha Vistaar asks you to enable it and the browser/OS decides the actual permission.</p>';box.querySelectorAll('[data-device-access]').forEach(i=>i.onchange=async()=>{try{await getJSON('/api/preferences/device-access',{method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify({[i.dataset.deviceAccess]:i.checked})})}catch(e){i.checked=!i.checked;showToast(e.message)}})}catch(e){box.innerHTML=`<div class="card error">${esc(e.message)}</div>`}}

async function loadUserPreferencesUI(){
 const theme=document.getElementById('settingTheme'),font=document.getElementById('settingFont'),fontSize=document.getElementById('settingFontSize');
 if(theme){theme.value=localStorage.getItem('kv.theme')||'system';document.documentElement.dataset.theme=theme.value;theme.onchange=e=>{document.documentElement.dataset.theme=e.target.value;localStorage.setItem('kv.theme',e.target.value)}}
 if(font){font.value=localStorage.getItem('kv.font')||'system';document.documentElement.dataset.font=font.value;font.onchange=e=>{document.documentElement.dataset.font=e.target.value;localStorage.setItem('kv.font',e.target.value)}}
 if(fontSize){fontSize.value=localStorage.getItem('kv.fontSize')||'16';document.documentElement.style.setProperty('--kv-font-size',fontSize.value+'px');fontSize.oninput=e=>{document.documentElement.style.setProperty('--kv-font-size',e.target.value+'px');localStorage.setItem('kv.fontSize',e.target.value)}}
 document.getElementById('settingsLanguage')?.addEventListener('click',openLanguageDialog);populateReadingLanguage();
 if(!state.user)return;
 try{const d=await getJSON('/api/notification-preferences');const p=d.preferences||{};const c=p.channels||{};for(const [id,val] of [['prefInApp',c.in_app!==false],['prefWeb',c.web!==false],['prefEmail',c.email!==false],['prefComment',p.notifications?.comment!==false],['prefFollow',p.notifications?.follow!==false],['prefAuthor',p.notifications?.author!==false]]){const el=document.getElementById(id);if(el)el.checked=val}
 const save=document.getElementById('saveNotificationPreferences');if(save)save.onclick=async()=>{const payload={channels:{in_app:document.getElementById('prefInApp').checked,web:document.getElementById('prefWeb').checked,email:document.getElementById('prefEmail').checked},notifications:{comment:document.getElementById('prefComment').checked,follow:document.getElementById('prefFollow').checked,author:document.getElementById('prefAuthor').checked}};await getJSON('/api/notification-preferences',{method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});showToast('Notification settings saved.')}}catch(e){console.warn('Notification preferences unavailable:',e.message)}
}
function populateReadingLanguage(){const s=document.getElementById('readingLanguage');if(!s)return;s.innerHTML=state.languages.map(x=>`<option value="${x.code}">${esc(x.nativeName)}</option>`).join('');s.value=state.languages.some(x=>x.code===state.readingLanguage)?state.readingLanguage:'en';s.onchange=()=>{state.readingLanguage=s.value;localStorage.setItem('kv.readingLanguage',s.value)}}
function closeMobileMenu(){const nav=document.getElementById('primaryNav'),toggle=document.getElementById('menuToggle');nav?.classList.remove('open');toggle?.setAttribute('aria-expanded','false');document.body?.classList.remove('kv-menu-open')}
function setActiveNav(route){document.querySelectorAll('#primaryNav [data-route],#mobileBottomNav [data-route]').forEach(a=>a.classList.toggle('active',a.dataset.route===route));closeMobileMenu()}
function openProfileMenu(){const d=document.getElementById('profileMenu');if(d){renderProfileMenu();d.showModal()}}
function renderProfileMenu(){const box=document.getElementById('profileMenuList');if(!box)return;box.innerHTML=`${routeLink('account',`${kvIcon('profile')}${x('profile')}`,'button profile-menu-link')}${state.user?routeLink('reader-dashboard',`${kvIcon('dashboard')}Reader Dashboard`,'button profile-menu-link'):''}${state.user?routeLink('author-dashboard',`${kvIcon('write')}Author Dashboard`,'button profile-menu-link'):''}${routeLink('settings',`${kvIcon('settings')}${x('appSettings')}`,'button profile-menu-link')}${routeLink('phone-settings',`${kvIcon('phone')}${t('phoneSettings')}`,'button profile-menu-link')}${routeLink('notifications',`${kvIcon('bell')}Notifications`,'button profile-menu-link')}${routeLink('messages',`${kvIcon('message')}Message Box`,'button profile-menu-link')}${routeLink('subscriptions',`${kvIcon('coins')}Subscription & Billing`,'button profile-menu-link')}${routeLink('stickers',`${kvIcon('sticker')}Coins & Stickers`,'button profile-menu-link')}${routeLink('safety-tickets',`${kvIcon('ticket')}Safety & Tickets`,'button profile-menu-link')}${routeLink('help',`${kvIcon('help')}${t('help')}`,'button profile-menu-link')}<button type="button" class="button profile-menu-link danger" data-logout>${kvIcon('logout')}${x('logout')}</button>`;box.querySelectorAll('[data-route]').forEach(a=>a.onclick=e=>{e.preventDefault();closeProfileMenu();navigate(a.dataset.route)});const lo=box.querySelector('[data-logout]');if(lo)lo.onclick=performLogout}
function phoneSettings(){if(!state.user)return page(t('phoneSettings'),loginGate());return page(t('phoneSettings'),`<div class="grid"><article class="card"><h2>${kvIcon('phone')}${t('phoneSettings')}</h2><p>${x('mobile')}: <strong id="phoneSettingsValue">—</strong></p><p>${t('phoneVerificationText')}</p><button class="primary" data-change-contact="mobile">${x('changeMobile')}</button></article><article class="card"><h2>${kvIcon('mail')}${x('email')}</h2><p>${t('emailVerificationText')}</p><button class="button" data-change-contact="email">${x('changeEmail')}</button></article></div>`)}

window.addEventListener('popstate',()=>{try{render(currentRoute())}catch(err){renderFailure(err)}});
function openSmartAssist(initialType='story'){
 const existing=document.getElementById('kvSmartAssistDialog');if(existing)existing.remove();
 const d=document.createElement('dialog');d.id='kvSmartAssistDialog';d.className='kv-smart-dialog';
 d.innerHTML=`<form method="dialog" class="kv-smart-form"><div class="dialog-header"><div><span class="eyebrow">Internal AI</span><h2>${kvIcon('spark')} Smart Assistant</h2></div><button type="button" class="icon-button" data-smart-close aria-label="Close">×</button></div><div class="kv-smart-form-grid"><label>Format<select id="smartFormat">${[['story',x('storyNovel')],['comic','Comic'],['audio',x('audio')],['reel','Reel']].map(x=>`<option value="${x[0]}" ${x[0]===initialType?'selected':''}>${x[1]}</option>`).join('')}</select></label><label>Mode<select id="smartMode"><option value="manual">Manual</option><option value="ai-assisted">AI-assisted</option><option value="ai-generated">AI-generated proposal</option></select></label><label>Language<select id="smartLanguage">${state.languages.map(l=>`<option value="${l.code}" ${l.code===(state.uiLanguage||'en')?'selected':''}>${esc(l.nativeName||l.name)}</option>`).join('')}</select></label></div><label>What do you want to create or understand?<textarea id="smartPrompt" rows="5" maxlength="6000" required placeholder="Example: Turn my Gujarati story idea into a Hindi audio-story plan with character emotion and narration pacing."></textarea><div class="kv-smart-note">${kvIcon('shield')} Internal-first · External AI not required · Your approval is required before applying or publishing.</div><div class="dialog-actions"><button type="button" class="button" data-smart-close>Cancel</button><button type="submit" class="primary" id="smartSubmit">Ask Internal AI</button></div><div id="smartResult" class="kv-smart-result" aria-live="polite"></div></form>`;
 document.body.appendChild(d);const close=()=>{if(d.open)d.close();d.remove()};d.querySelectorAll('[data-smart-close]').forEach(b=>b.onclick=close);d.querySelector('form').addEventListener('submit',async e=>{e.preventDefault();const out=d.querySelector('#smartResult'),btn=d.querySelector('#smartSubmit'),format=d.querySelector('#smartFormat').value,mode=d.querySelector('#smartMode').value,language=d.querySelector('#smartLanguage').value,prompt=d.querySelector('#smartPrompt').value.trim();if(mode==='manual'){close();navigate('editor');setTimeout(()=>{const type=document.getElementById('editorType');if(type){type.value=format;type.dispatchEvent(new Event('change'))}const title=document.getElementById('editorTitle');if(title&&!title.value&&prompt)title.value=prompt.slice(0,90);const body=document.getElementById('editorBody');if(body&&prompt&&!body.innerText.trim())body.innerText=prompt;const lang=document.getElementById('editorLanguage');if(lang)lang.value=language},80);return}btn.disabled=true;out.textContent=x('aiWorking');try{const r=await getJSON('/api/ai/smart-assist',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({type,mode,language,prompt})});out.innerHTML=`<strong>Internal AI proposal</strong><p>${esc(r.proposal?.text||'Structured proposal returned; open the relevant Creator Studio to review it.')}</p><small>${esc(r.aiId)} · ${esc(r.language)} · external AI: no</small>`}catch(err){out.textContent=humanAuthError(err.code||err.message)}finally{btn.disabled=false}});d.showModal();d.querySelector('#smartPrompt')?.focus();
}
function initStaticBindings(){
  document.querySelectorAll('[data-smart-format]').forEach(b=>b.onclick=()=>openSmartAssist(b.dataset.smartFormat||'story'));document.getElementById('openSmartAssist')?.addEventListener('click',()=>openSmartAssist('story'));
  const openLoginBtn=document.getElementById('openLogin');
  if(openLoginBtn)openLoginBtn.onclick=openLogin;
  const menuToggle=document.getElementById('menuToggle');
  const primaryNav=document.getElementById('primaryNav');
  if(menuToggle&&primaryNav)menuToggle.onclick=()=>{const open=primaryNav.classList.toggle('open');menuToggle.setAttribute('aria-expanded',String(open));document.body.classList.toggle('kv-menu-open',open)};
  primaryNav?.addEventListener('click',e=>{if(e.target.closest('[data-route],[data-open-login],[data-register]'))closeMobileMenu()});
  document.addEventListener('keydown',e=>{if(e.key==='Escape')closeMobileMenu()});
  const languageButton=document.getElementById('languageButton');
  if(languageButton)languageButton.onclick=openLanguageDialog;
  const languageClose=document.getElementById('languageClose');
  if(languageClose)languageClose.onclick=closeLanguageDialog;
  const languagePicker=document.getElementById('languagePicker');
  if(languagePicker)languagePicker.addEventListener('click',e=>{if(e.target===languagePicker)closeLanguageDialog()});
  const loginForm=document.getElementById('loginForm');
  if(loginForm)loginForm.addEventListener('submit',handleLoginSubmit);
  const forgot=document.getElementById('forgotPassword');
  if(forgot)forgot.onclick=openForgotPassword;
  const passkeyLogin=document.getElementById('passkeyLogin');
  if(passkeyLogin)passkeyLogin.onclick=loginWithPasskey;
  document.querySelectorAll('[data-close-dialog]').forEach(b=>b.onclick=()=>b.closest('dialog')?.close());
  const registerForm=document.getElementById('registerForm');
  if(registerForm){registerForm.addEventListener('submit',handleRegisterSubmit);const ru=registerForm.querySelector('[name=username]'),rid=registerForm.querySelector('[name=userId]'),rn=registerForm.querySelector('[name=name]');rn?.addEventListener('input',()=>{if(!ru.value)refreshIdentitySuggestions()});ru?.addEventListener('input',checkIdentityAvailability);rid?.addEventListener('input',checkIdentityAvailability);setTimeout(refreshIdentitySuggestions,0);}
  document.querySelectorAll('[data-password-toggle]').forEach(b=>b.addEventListener('click',()=>togglePasswordVisibility(b)));
  const rp=document.getElementById('registerPassword'),rc=document.getElementById('registerConfirmPassword'),rm=document.getElementById('registerPasswordMatch');
  const checkRegisterPasswords=()=>{if(!rp||!rc||!rm)return; if(!rc.value){rm.textContent='';rm.className='field-hint';return;} const ok=rp.value===rc.value;rm.textContent=ok?x('passwordsMatch'):x('passwordMismatch');rm.className=ok?'field-hint valid':'field-hint invalid';};
  rp?.addEventListener('input',checkRegisterPasswords);rc?.addEventListener('input',checkRegisterPasswords);
  const otpForm=document.getElementById('otpForm');if(otpForm)otpForm.addEventListener('submit',e=>{e.preventDefault();verifyOtpDialog()});initOtpBoxes();
  const otpClose=document.getElementById('otpClose');if(otpClose)otpClose.onclick=cancelOtpDialog;
  const otpCancel=document.getElementById('otpCancel');if(otpCancel)otpCancel.onclick=cancelOtpDialog;
  const otpDialog=document.getElementById('otpDialog');if(otpDialog)otpDialog.addEventListener('close',()=>{if(state.otpResolve)cancelOtpDialog()});
  const otpResend=document.getElementById('otpResend');if(otpResend)otpResend.onclick=resendOtpDialog;const forgotForm=document.getElementById('forgotPasswordForm');if(forgotForm)forgotForm.addEventListener('submit',handleForgotPasswordSubmit);const resetForm=document.getElementById('resetPasswordForm');if(resetForm)resetForm.addEventListener('submit',handleResetPasswordSubmit);
  const viewerClose=document.getElementById('contentViewerClose');
  if(viewerClose)viewerClose.onclick=()=>document.getElementById('contentViewer')?.close();
  document.addEventListener('input',handleAutosaveInput);
}
function openLanguageDialog(){document.getElementById('languagePicker').showModal()}function closeLanguageDialog(){const d=document.getElementById('languagePicker');if(d.open)d.close()}function renderLanguagePicker(){const label=document.getElementById('languageButtonLabel'),lang=state.languages.find(x=>x.code===state.uiLanguage)||state.languages[0];if(label)label.textContent=lang.nativeName;const list=document.getElementById('languageList');if(!list)return;list.innerHTML=state.languages.map(x=>`<button type="button" class="language-option${x.code===state.uiLanguage?' selected':''}" data-language="${x.code}"><span>${esc(x.nativeName)}</span><small>${esc(x.name)}</small></button>`).join('');list.querySelectorAll('[data-language]').forEach(b=>b.onclick=()=>{state.uiLanguage=b.dataset.language;localStorage.setItem('kv.uiLanguage',state.uiLanguage);closeLanguageDialog();renderLanguagePicker();updateHeader();render(currentRoute())})}
function applyTranslations(){document.documentElement.lang=state.uiLanguage;document.querySelectorAll('[data-i18n]').forEach(el=>el.textContent=t(el.dataset.i18n))}
async function loadReaderDashboard(){try{const d=await getJSON('/api/dashboard/reader');const b=document.getElementById('readerDash');if(!b)return;b.innerHTML=`<div class="card"><h3>${kvIcon('profile')} ${esc(d.profile.username)}</h3><p class="muted">Coins: ${d.coins} · Saved: ${(d.library||[]).length} · History: ${(d.history||[]).length}</p></div>${(d.challenges||[]).map(c=>`<div class="card"><h3>${kvIcon('trophy')} ${esc(c)}</h3><p class="muted">Reading challenge / engagement task.</p></div>`).join('')}` }catch(e){const b=document.getElementById('readerDash');if(b)b.innerHTML=`<div class="card error">${esc(e.message)}</div>`}}
async function loadAuthorDashboard(){try{const d=await getJSON('/api/dashboard/author');const b=document.getElementById('authorDash');if(!b)return;b.innerHTML=`<div class="card"><h3>Works</h3><strong>${d.stats.works}</strong></div><div class="card"><h3>Readers</h3><strong>${Number(d.stats.readers).toLocaleString()}</strong></div><div class="card"><h3>Coins</h3><strong>${d.stats.coins}</strong></div><div class="card"><h3>Missions</h3>${d.missions.map(x=>`<div class="pill">${esc(x)}</div>`).join('')}</div><section class="card"><div class="section-heading"><div><h3>Training AI Coach</h3><p class="muted">Emotion-aware coaching for writing, comic, FM/audio and reel creation. Choose a female, male or child voice profile for rehearsal.</p></div><span class="service-badge">Internal AI ON</span></div><div class="button-row"><input id="trainingAiTopic" type="text" placeholder=x('trainingTopicPlaceholder') aria-label=x('trainingTopic')><select id="trainingAiLanguage" aria-label=x('trainingLanguage')></select><button class="primary" id="trainingAiCoach">Coach me</button></div><div id="trainingAiOutput" class="result" aria-live="polite"></div></section>`;const ls=document.getElementById('trainingAiLanguage');if(ls)ls.innerHTML=(state.languages||[]).map(l=>`<option value="${esc(l.code)}" ${l.code===state.uiLanguage?'selected':''}>${esc(l.nativeName)}</option>`).join('');document.getElementById('trainingAiCoach')?.addEventListener('click',async()=>{const out=document.getElementById('trainingAiOutput'),topic=document.getElementById('trainingAiTopic')?.value.trim();if(!topic){out.textContent=x('enterTrainingTopic');return}out.textContent=x('trainingPreparing');try{const r=await getJSON('/api/training/ai-coach',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({topic,language:document.getElementById('trainingAiLanguage')?.value||state.uiLanguage})});const o=r.output||{};out.innerHTML=`<strong>${esc(o.operation||x('trainingAi'))}</strong><p>${esc((o.teachingSignals||[]).join(' · '))}</p><p>${esc((o.stages||[]).join(' → '))}</p><p class="muted">${esc((o.voiceOptions||[]).slice(0,6).map(v=>v.id).join(' · '))}</p>`}catch(e){out.textContent=humanAuthError(e.message||x('trainingUnavailable'))}})}catch(e){const b=document.getElementById('authorDash');if(b)b.innerHTML=`<div class="card error">${esc(e.message)}</div>`}}
async function performAdminLogout(){try{const r=await getJSON('/api/admin/session',{method:'DELETE'});if(!r.ok)throw new Error('admin_logout_not_confirmed');localStorage.removeItem('kv.admin.role');history.replaceState({},'',ROUTE_PATHS.home);render('home');showToast('Admin session ended successfully.')}catch(e){showToast('Admin logout could not be confirmed. Please try again.','error')}}
async function loadAdminDashboard(){const b=document.getElementById('adminDash');if(!b)return;let key=await uiPrompt(x('adminLogin'));if(!key){b.innerHTML='<div class="card">'+x('adminLoginCancelled')+'</div>';return}let productKey=await uiPrompt(x('productKeyPrompt'));try{let m=null;try{m=await getJSON('/api/admin/session',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({masterKey:key,productKey,role:'master_admin'})})}catch(_){m=await getJSON('/api/admin/session',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({key,role:'admin'})})}localStorage.setItem('kv.admin.role',m.role);const d=await getJSON('/api/admin/dashboard');const services=(d.summary.services||[]).map(s=>'<div class="service-row"><div><strong>'+esc(s.label)+'</strong><div class="muted">'+esc(s.mode)+' · '+esc(s.health?.reason||'')+'</div></div><button class="button" data-service-toggle="'+esc(s.id)+'" data-service-enabled="'+(s.enabled?'1':'0')+'">'+(s.enabled?kvIcon('shield'):kvIcon('lock'))+'</button></div>').join('');b.innerHTML='<div class="card"><h3>'+x('adminRole')+'</h3><strong>'+esc(d.role)+'</strong><div class="dialog-actions"><button type="button" class="button danger" data-admin-logout>Log out admin</button></div></div><div class="card"><h3>'+x('adminUsers')+'</h3><strong>'+d.summary.users+'</strong></div><div class="card"><h3>'+x('adminContent')+'</h3><strong>'+d.summary.content+'</strong></div><div class="card"><h3>'+x('adminHelpTickets')+'</h3><strong>'+d.summary.helpTickets+'</strong></div><div class="card"><h3>'+x('adminServices')+'</h3><p class="muted">'+x('fallback')+'</p><div class="service-list">'+services+'</div></div>';document.querySelector('[data-admin-logout]')?.addEventListener('click',performAdminLogout);document.querySelectorAll('[data-service-toggle]').forEach(btn=>btn.onclick=async()=>{try{await getJSON('/api/admin/services/toggle',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({service:btn.dataset.serviceToggle,enabled:btn.dataset.serviceEnabled!=='1'})});loadAdminDashboard()}catch(e){showToast(e.message,'error')}})}catch(e){b.innerHTML='<div class="card error">'+esc(e.message)+'</div>'}}
async function loadAiDashboard(){
 const b=document.getElementById('aiDash');if(!b)return;
 const renderReference=(ref)=>{
  const live=ref?.live||{}, mods=Array.isArray(ref?.modules)?ref.modules:[];
  const card=(title,status,detail)=>`<article class="card"><div class="row-between"><h3>${esc(title)}</h3><span class="pill">${esc(status)}</span></div><p class="muted">${esc(detail)}</p></article>`;
  const modelReady=live.modelRegistry?.modelInferenceReady===true;
  const ttsReady=live.ttsVoiceMatrix?.neuralReady===true;
  const rows=mods.map(mod=>{
   const x=live[{"model-registry":"modelRegistry","inference-studio":"inferenceStudio","tts-voice-matrix":"ttsVoiceMatrix","rag":"rag","lora":"lora","benchmark-safety":"benchmark","api-console":"apiConsole","telemetry":"telemetry","sdk":"sdk"}[mod.id]]||{};
   const state=mod.id==='model-registry'?(modelReady?'PASS':'BLOCKED'):mod.id==='tts-voice-matrix'?(ttsReady?'PASS':'PARTIAL'):mod.id==='inference-studio'?(x.runtimeEnabled?'PARTIAL':'BLOCKED'):mod.id==='lora'||mod.id==='sdk'?x('referenceOnly'):mod.id==='benchmark-safety'?'PASS':mod.id==='api-console'||mod.id==='telemetry'||mod.id==='rag'?'PASS':'REFERENCE';
   return `<div class="service-row"><div><strong>${esc(mod.label)}</strong><div class="muted">${esc(mod.kv30Module||'')} · ${esc(mod.implementation||'')}</div></div><span class="pill">${esc(state)}</span></div>`;
  }).join('');
  return `<section class="card"><div class="row-between"><div><span class="eyebrow">KV30 Reference Layer</span><h3>Design / UX / Architecture Mapping</h3></div><span class="pill">NO ENGINE INTEGRATION</span></div><p class="muted">Project KV30 is used only as a reference source. Unverified engine, model, TTS, benchmark and cryptographic claims are not imported.</p><div class="service-list">${rows}</div></section>
  <div class="content-grid">
   ${card('Model Registry',modelReady?'PASS':'BLOCKED',`${live.modelRegistry?.configuredModel||'No model'} · ${live.modelRegistry?.reason||''}`)}
   ${card('Inference Studio',live.inferenceStudio?.streaming?'PASS':'PARTIAL',`Runtime enabled: ${!!live.inferenceStudio?.runtimeEnabled} · Streaming: not verified`)}
   ${card('TTS Voice Matrix',ttsReady?'PASS':'PARTIAL',`Piper: ${!!live.ttsVoiceMatrix?.piperAvailable} · eSpeak: ${!!live.ttsVoiceMatrix?.espeakAvailable} · neural ready: ${ttsReady}`)}
   ${card('Knowledge / RAG',live.rag?.persistent?'PASS':'BLOCKED',`Scopes: ${(live.rag?.scopes||[]).join(', ')} · approval required: ${!!live.rag?.knowledgeApprovalRequired}`)}
   ${card('LoRA Governance',live.lora?.implemented?'PASS':x('referenceOnly'),'Governance contract exists; production LoRA engine/weights are not claimed.')}
   ${card('Benchmark / Safety','PASS',`KV30 evaluation state · external benchmark claims imported: ${!!live.benchmark?.externalClaimsImported}`)}
   ${card('API Verification','PASS',`${(live.apiConsole?.verifiedRoutes||[]).length} canonical KV30 routes mapped`)}
   ${card('Telemetry', 'PASS',`${live.telemetry?.events||0} live internal AI telemetry events`)}
   ${card('SDK Integration',live.sdk?.implemented?'PASS':x('referenceOnly'),'Future local SDK boundary only; no KV30 SDK dependency shipped.')}
  </div>`;
 };
 try{
  const h=await getJSON('/api/admin/ai-dashboard');
  const ref=await getJSON('/api/admin/ai-capability-assurance');
  const roles=h.roles||{};
  b.innerHTML=`<div class="card"><h3>${x('aiInternal')}</h3><p>${esc(h.policy?.version||'v30')}</p><span class="pill">${x('aiPolicy')}</span><p class="muted">${x('governedLoop')}</p><p class="muted">Internal model: ${esc(h.internalModelRuntime?.model||'not configured')} · ${h.internalModelRuntime?.enabled?'enabled':'disabled'}</p></div><div class="card"><h3>${x('aiExternal')}</h3><p class="muted">External layer: ${h.providerPolicy?.external?.enabled?'ON':'OFF'} · Internal remains first and required.</p>${localStorage.getItem('kv.admin.role')==='master_admin'?`<button class="button" id="aiExternalToggle">Turn external ${h.providerPolicy?.external?.enabled?'OFF':'ON'}</button>`:''}</div><div class="card"><h3>${x('designAI')}</h3><div class="chips">${(h.designer?.capabilities||[]).map(v=>`<span class="pill">${esc(v)}</span>`).join('')}</div></div><div class="card"><h3>${x('programmerAI')}</h3><div class="chips">${(h.programmer?.capabilities||[]).map(v=>`<span class="pill">${esc(v)}</span>`).join('')}</div></div><div class="card"><h3>${x('aiLayers')}</h3><div class="chips">${Object.entries(roles).map(([k,v])=>`<span class="pill">${esc(k)} · ${esc(v.approval||'governed')}</span>`).join('')}</div><p class="muted">${x('aiHumanAuthority')}</p></div>${renderReference(ref.reference)}${aiWorkbenchProposal()}`;
  document.getElementById('aiExternalToggle')?.addEventListener('click',async()=>{try{await getJSON('/api/admin/ai-provider-policy',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({externalEnabled:!h.providerPolicy?.external?.enabled})});loadAiDashboard()}catch(e){showToast(e.message,'error')}});
  initAiWorkbench();
 }catch(e){if(e.message==='admin_required'){b.innerHTML=`<div class="card"><p>${x('aiManagementLogin')}</p><button class="primary" data-admin-ai-login>${x('adminLogin')}</button></div>`;document.querySelector('[data-admin-ai-login]')?.addEventListener('click',adminAiLogin)}else b.innerHTML=`<div class="card error">${esc(e.message)}</div>`}
}
async function adminAiLogin(){const masterKey=await uiPrompt(x('adminLogin'));if(!masterKey)return;const productKey=await uiPrompt('Product Key');if(!productKey)return;try{const r=await getJSON('/api/admin/session',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({masterKey,productKey,role:'master_admin'})});if(r.role!=='master_admin'&&r.role!=='admin')throw new Error('admin_role_mismatch');loadAiDashboard()}catch(e){showToast(e.message)}}
async function loadReports(){try{const d=await getJSON('/api/reports/summary');const b=document.getElementById('reportsDash');if(b)b.innerHTML=`<div class="card"><h3>Works</h3><strong>${d.works}</strong></div><div class="card"><h3>Readers</h3><strong>${d.readers}</strong></div><div class="card"><h3>Coins</h3><strong>${d.coins}</strong></div><div class="card"><h3>External services currently fallback/off</h3><p>${d.serviceFallbacks.map(x=>esc(x.label)).join('<br>')||x('none')}</p></div>`}catch(e){const b=document.getElementById('reportsDash');if(b)b.innerHTML=`<div class="card error">${esc(e.message)}</div>`}}
async function loadStickers(){try{const d=await getJSON('/api/stickers');const cb=document.getElementById('coinBalance');if(cb)cb.textContent=d.loggedIn?`${d.coins} Coins`:'Login required to show balance';const pb=document.getElementById('coinPacksBox');if(pb)pb.innerHTML=(d.policy?.coinPacks||[]).map(p=>`<article class="card monetization-card"><h3>${p.coins.toLocaleString()} Coins</h3><p class="price">₹${Number(p.price).toFixed(2)}</p><button class="primary" data-buy-coins="${p.coins}">${state.user?x('buy')+' · '+x('internalPayment'):x('login')}</button></article>`).join('')||'<div class="empty card">No coin packs available.</div>';const b=document.getElementById('stickersBox');if(b)b.innerHTML=d.catalog.map(sticker=>`<article class="card monetization-card"><div class="sticker-visual">${kvIcon('sticker')}</div><h3>${esc(sticker.label)}</h3><p>${sticker.cost} Coins</p><button class="button" data-buy-sticker="${esc(sticker.id)}">${state.user?'Buy sticker':x('login')}</button></article>`).join('')||'<div class="empty card">No active stickers.</div>';document.querySelectorAll('[data-buy-coins]').forEach(btn=>btn.onclick=async()=>{if(!state.user){document.getElementById('openLogin')?.click();return}try{const coins=Number(btn.dataset.buyCoins);const paymentToken=await requestInternalPaymentOtp('coin_purchase',String(coins),Number((d.policy?.coinPacks||[]).find(p=>p.coins===coins)?.price||0));const r=await getJSON('/api/coins/purchase',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({coins,method:'internal_test',offerCode:document.getElementById('coinOfferCode')?.value.trim()||undefined,idempotencyKey:String(Date.now())+Math.random(),paymentToken})});showToast(`Coins added. Balance: ${r.coins}${r.transaction?.offerId?' · Offer applied':''}`);loadStickers()}catch(e){showToast(e.message,'error')}});document.querySelectorAll('[data-buy-sticker]').forEach(btn=>btn.onclick=async()=>{if(!state.user){document.getElementById('openLogin')?.click();return}try{const r=await getJSON('/api/stickers/purchase',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({sticker:btn.dataset.buySticker,idempotencyKey:String(Date.now())+Math.random()})});showToast(`Sticker purchased. Coins left: ${r.coins}`);loadStickers()}catch(e){showToast(e.message)}});document.getElementById('refreshCoinCatalog')?.addEventListener('click',loadStickers)}catch(e){const b=document.getElementById('stickersBox');if(b)b.innerHTML=`<div class="card error">${esc(e.message)}</div>`}}async function bindMediaTools(){
 document.querySelectorAll('[data-media-job]').forEach(b=>b.onclick=async()=>{try{const d=await getJSON('/api/media/jobs',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({type:b.dataset.mediaJob})});showToast(`Job ${d.job.id} queued (${d.job.mode}).`)}catch(e){showToast(e.message)}});
 const sel=document.getElementById('mediaContentSelect');try{const mine=await getJSON('/api/my-content');if(sel)sel.innerHTML='<option value="">No content yet</option>'+(mine.content||[]).map(c=>`<option value="${esc(c.id)}">${esc(c.title)} · ${esc(c.type)}</option>`).join('')}catch{}
 const upload=document.getElementById('mediaUploadBtn');if(upload)upload.onclick=async()=>{const f=document.getElementById('mediaFile')?.files?.[0],status=document.getElementById('mediaUploadStatus');if(!f){if(status)status.textContent=x('chooseMediaFirst');return}if(f.size>10*1024*1024){status.textContent=x('localTestUploadLimit');return}const reader=new FileReader();reader.onload=async()=>{try{const r=await getJSON('/api/media/assets',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({filename:f.name,mimeType:f.type,data:reader.result})});const asset=r.asset;status.innerHTML=`Uploaded and quarantined: <strong>${esc(asset.id)}</strong> · ${esc(asset.mimeType)} · ${asset.size} bytes · SHA-256 ${esc(asset.sha256)}<br><button class="button" id="makeHlsBtn">Generate encrypted HLS</button>`;document.getElementById('makeHlsBtn').onclick=async()=>{try{const h=await getJSON('/api/media/hls/create',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({assetId:asset.id,contentId:sel?.value||''})});status.innerHTML+=`<br>HLS ready: <a href="${h.hls.playlist}" target="_blank">${h.hls.playlist}</a> · AES-128`;await loadMediaAssets()}catch(e){status.textContent='HLS generation failed: '+e.message}};await loadMediaAssets()}catch(e){status.textContent=e.message}};reader.readAsDataURL(f)};
 await loadMediaAssets();
}
async function loadMediaAssets(){const box=document.getElementById('mediaAssetList');if(!box)return;try{const r=await getJSON('/api/media/assets');box.innerHTML=(r.assets||[]).map(a=>`<div class="card" style="margin:8px 0"><strong>${esc(a.filename||a.id)}</strong><div class="muted">${esc(a.mimeType)} · ${a.status}</div>${a.hls?`<a href="${a.hls.playlist}" target="_blank">Open HLS playlist</a>`:'<span class="muted">Not transcoded yet</span>'}</div>`).join('')||'<p class="muted">No uploaded assets yet.</p>'}catch(e){box.textContent=e.message}}
function renderFailure(err){console.error('Katha Vistaar render failure',err);const app=document.getElementById('app');if(!app)return;const message=esc(err?.message||String(err||'Unknown error'));app.innerHTML=`<section class="page-shell"><div class="card error-diagnostic"><span class="eyebrow">Katha Vistaar diagnostic</span><h1>Application failed to render</h1><p>The source program raised an error. This diagnostic does not substitute for a fix.</p><pre>${message}</pre></div></section>`}
async function loadConfig(){try{const [l,f,m,p]=await Promise.all([getJSON('/api/languages'),getJSON('/api/features'),getJSON('/api/auth/me'),getJSON('/api/monetization/catalog')]);state.languages=(l.languages||[]).filter(x=>x.enabled);state.features=f.features||{};state.user=m.user||null;state.monetizationPolicy={contentAccess:{stories:{novel:{freeParts:Number(p.policy?.contentAccess?.stories?.novel?.freeParts||0),dailyProgressHours:Number(p.policy?.contentAccess?.stories?.novel?.dailyProgressHours||0),coinUnlockCost:Number(p.policy?.contentAccess?.stories?.novel?.coinUnlockCost||0),rewardedAdUnlock:p.policy?.contentAccess?.stories?.novel?.rewardedAdUnlock===true}},media:{noAppFreeParts:Number(p.policy?.contentAccess?.media?.noAppFreeParts||0),appFreeParts:Number(p.policy?.contentAccess?.media?.appFreeParts||0)}},coinGiftAmounts:Array.isArray(p.policy?.coinGiftAmounts)?p.policy.coinGiftAmounts.map(Number).filter(Number.isFinite).map(Math.floor).filter(n=>n>0):[],stickers:Array.isArray(p.policy?.stickers)?p.policy.stickers:[],royalty:{minGenuineFollowers:Number(p.policy?.royalty?.minGenuineFollowers||0)}}}catch(err){console.warn('Configuration API unavailable; using safe public defaults.',err);state.languages=[];state.features={};state.user=null}state.authChecked=true;if(!state.languages.length)state.languages=[{code:'en',name:'English',nativeName:'English',enabled:true}];if(!state.languages.some(x=>x.code===state.uiLanguage))state.uiLanguage='en';try{renderLanguagePicker();updateHeader();render(currentRoute())}catch(err){renderFailure(err)}}
function passwordEyeSvg(open){return open?'<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="12" r="2.5" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>':'<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3 3 18 18M10.6 6.2A10.8 10.8 0 0 1 12 6c6 0 9.5 6 9.5 6a16.8 16.8 0 0 1-3.2 3.8M6.7 6.7C4 8.2 2.5 12 2.5 12s3.5 6 9.5 6c1.1 0 2.1-.2 3-.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>'}
function togglePasswordVisibility(button){const id=button?.dataset.passwordToggle;if(!id)return;const input=document.getElementById(id);if(!input)return;const show=input.type==='password';input.type=show?'text':'password';button.innerHTML=passwordEyeSvg(show);button.setAttribute('aria-label',show?x('hidePassword'):x('showPassword'));button.setAttribute('title',show?x('hidePassword'):x('showPassword'))}
function startOtpTimer(seconds=60){clearInterval(state.otpTimer);state.otpSeconds=seconds;const b=document.getElementById('otpResend');const tick=()=>{if(!b)return;if(state.otpSeconds>0){b.disabled=true;b.textContent=`${x('resendOtp')} (${state.otpSeconds}s)`;state.otpSeconds-=1}else{b.disabled=false;b.textContent=x('resendOtp');clearInterval(state.otpTimer);state.otpTimer=null}};tick();state.otpTimer=setInterval(tick,1000)}
function stopOtpTimer(){clearInterval(state.otpTimer);state.otpTimer=null;state.otpSeconds=0;if(state.otpAbort){try{state.otpAbort.abort()}catch(_){ }state.otpAbort=null}}
function validatePasswordPair(password,confirm,box){if(password!==confirm){if(box)box.textContent=x('passwordMismatch');return false}if(String(password||'').length<6){if(box)box.textContent=x('passwordTooShort');return false}return true}
function getOtpCode(){return [...document.querySelectorAll('[data-otp-digit]')].map(i=>i.value.replace(/\D/g,'').slice(0,1)).join('').slice(0,6)}
function setOtpCode(value){const code=String(value||'').replace(/\D/g,'').slice(0,6);const boxes=[...document.querySelectorAll('[data-otp-digit]')];boxes.forEach((b,i)=>b.value=code[i]||'');const hidden=document.getElementById('otpCode');if(hidden)hidden.value=code;}
function focusOtpBox(index){const boxes=[...document.querySelectorAll('[data-otp-digit]')];boxes[Math.max(0,Math.min(index,boxes.length-1))]?.focus()}
function initOtpBoxes(){const boxes=[...document.querySelectorAll('[data-otp-digit]')];boxes.forEach((box,index)=>{box.oninput=()=>{box.value=box.value.replace(/\D/g,'').slice(-1);const code=getOtpCode();const hidden=document.getElementById('otpCode');if(hidden)hidden.value=code;if(box.value&&index<boxes.length-1)focusOtpBox(index+1);if(code.length===6)document.getElementById('otpVerifyButton')?.focus()};box.onkeydown=e=>{if(e.key==='Backspace'&&!box.value&&index>0){focusOtpBox(index-1);return}if(e.key==='ArrowLeft'&&index>0){e.preventDefault();focusOtpBox(index-1)}if(e.key==='ArrowRight'&&index<boxes.length-1){e.preventDefault();focusOtpBox(index+1)}};box.onpaste=e=>{e.preventDefault();setOtpCode((e.clipboardData||window.clipboardData).getData('text'));focusOtpBox(Math.min(getOtpCode().length,boxes.length-1))}});}
async function openOtpDialog(context){
  state.otpContext=context;
  const d=document.getElementById('otpDialog');if(!d)throw new Error('otp_dialog_unavailable');
  const title=document.getElementById('otpDialogTitle'),message=document.getElementById('otpDialogMessage'),status=document.getElementById('otpDeliveryStatus'),code=document.getElementById('otpCode'),test=document.getElementById('otpTestCode'),error=document.getElementById('otpError'),target=document.getElementById('otpTarget');
  if(!title||!message||!status||!code||!test||!error)throw new Error('otp_dialog_incomplete');
  title.textContent=x('verifyOtp');message.textContent=context.message||x('otpSent');
  const r=context.lastResponse||{}; status.textContent=r.delivery==='local_test_outbox' ? `${x('serviceStatus')}: ${x('fallback')} — external provider is not connected.` : `${x('serviceStatus')}: ${r.delivery||'ready'}`;
  if(target)target.textContent=context.targetLabel||maskOtpTarget(context.target,context.targetType);
  test.textContent=r.demoOtp?`${x('demoOtp')}: ${r.demoOtp}`:''; code.value=''; setOtpCode(''); error.textContent=''; initOtpBoxes();
  if(r.demoOtp)setOtpCode(r.demoOtp);
  if(d.open)d.close();d.showModal();startOtpTimer(60);focusOtpBox(0);
  if((context.targetType||'mobile')==='mobile' && window.isSecureContext && navigator.credentials?.get && !r.demoOtp){try{const ac=new AbortController();state.otpAbort=ac;navigator.credentials.get({otp:{transport:['sms']},signal:ac.signal}).then(cred=>{if(cred?.code){setOtpCode(cred.code);}}).catch(()=>{});}catch(_){} }
  return new Promise((resolve,reject)=>{state.otpResolve=resolve;state.otpReject=reject});
}
function maskOtpTarget(target,type){const v=String(target||'');if(type==='email'||v.includes('@')){const [a,d]=v.split('@');return `${(a||'').slice(0,1)}•••@${d||''}`}return v.length>4?`${v.slice(0,3)}••••${v.slice(-2)}`:'registered contact'}
function cancelOtpDialog(){stopOtpTimer();const d=document.getElementById('otpDialog');const resolve=state.otpResolve;state.otpResolve=null;state.otpReject=null;if(d?.open)d.close();resolve?.(null)}
async function sendOtpAndOpen({target,purpose,sendPath='/api/auth/send-otp',sendBody={identifier:target},message}){
  const r=await getJSON(sendPath,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(sendBody)});
  return openOtpDialog({target:r.target||target,purpose:r.purpose||purpose,sendPath,sendBody,message:message||x('otpSent'),lastResponse:r});
}
async function verifyOtpDialog(){
  const ctx=state.otpContext,code=getOtpCode()||document.getElementById('otpCode')?.value.trim(),box=document.getElementById('otpError');
  if(!ctx||!/^\d{6}$/.test(code||'')){if(box)box.textContent=x('verifyOtp');return}
  try{
    const path=ctx.verifyPath||(ctx.purpose?.startsWith('login-')?'/api/auth/verify-login-otp':'/api/auth/verify-otp');
    const m=await getJSON(path,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({target:ctx.target,purpose:ctx.purpose,otp:code})});
    m.__otp=code;if(m.resetToken)m.__resetToken=m.resetToken;stopOtpTimer();const resolve=state.otpResolve;state.otpResolve=null;state.otpReject=null;document.getElementById('otpDialog')?.close();resolve?.(m);
  }catch(e){if(box)box.textContent=e.message}
}
async function resendOtpDialog(){
  const ctx=state.otpContext;if(!ctx)return;
  try{
    const r=await getJSON(ctx.sendPath,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(ctx.sendBody)});
    ctx.lastResponse=r;ctx.target=r.target||ctx.target;ctx.purpose=r.purpose||ctx.purpose;if(r.paymentToken)state.paymentOtpToken=r.paymentToken;startOtpTimer(60);
    document.getElementById('otpTestCode').textContent=r.demoOtp?`${x('demoOtp')}: ${r.demoOtp}`:'';if(r.demoOtp)setOtpCode(r.demoOtp);
    document.getElementById('otpDeliveryStatus').textContent=r.delivery==='local_test_outbox'?`${x('serviceStatus')}: ${x('fallback')} — external provider is not connected.`:`${x('serviceStatus')}: ${r.delivery||'ready'}`;
  }catch(e){document.getElementById('otpError').textContent=e.message}
}
async function handleLoginSubmit(e){
 e.preventDefault();const data=Object.fromEntries(new FormData(e.currentTarget));const box=document.getElementById('loginError');if(box)box.textContent='';
 try{const m=await getJSON('/api/auth/login',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)});state.user=m.user;document.getElementById('login')?.close();updateHeader();render(currentRoute());}
 catch(err){
  if(err.code==='verification_required'){
   try{
    const options=err.details?.otpOptions||[];let choice=options.find(o=>o.verified)||options[0];
    if(options.length>1)choice=await chooseOtpContact(options,'login');
    if(!choice)return;
    const m=await sendOtpAndOpen({target:choice.target,purpose:choice.purpose,sendBody:{identifier:data.identifier,target:choice.target},targetType:choice.type,targetLabel:choice.label,message:x('otpSent')});
    if(!m)return;state.user=m.user;document.getElementById('login')?.close();updateHeader();render(currentRoute());
   }catch(e2){if(box)box.textContent=humanAuthError(e2.code||e2.message)}
  }else if(box)box.textContent=humanAuthError(err.code||err.message);
 }
}
function humanAuthError(code){const map={invalid_credentials:'The username, email or mobile number and password do not match.',account_locked:'This account is temporarily locked. Please contact support.',verification_required:'Please verify your registered mobile number or email by OTP.',account_exists:'An account already exists with this email or mobile number.',mobile_exists:'An account already exists with this mobile number.',username_exists:'That username is already taken. Choose another username.',user_id_exists:'That User ID is already taken. Choose another User ID.',invalid_username:'Username must be 3-24 characters using letters, numbers or underscore.',invalid_user_id:'User ID must be 3-32 characters using letters, numbers, underscore or hyphen.',invalid_or_expired_otp:'The OTP is invalid or expired. Request a new OTP and try again.',password_mismatch:x('passwordMismatch'),password_too_short:x('passwordTooShort'),account_temporarily_locked:x('accountTemporarilyLocked'),wrong_old_password:x('wrongOldPassword'),password_reuse:x('passwordReuse')};return map[code]||'Unable to complete the request. Please try again.'}
function chooseOtpContact(options,purpose){return new Promise(resolve=>{const existing=document.getElementById('otpContactChoice');if(existing)existing.remove();const d=document.createElement('dialog');d.id='otpContactChoice';d.innerHTML=`<form class="auth-choice-card"><div class="auth-choice-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6.5 12 13l8-6.5" fill="none" stroke="currentColor" stroke-width="1.8"/><rect x="3" y="5" width="18" height="14" rx="2" fill="none" stroke="currentColor" stroke-width="1.8"/></svg></div><h2>Choose verification method</h2><p class="muted">Select where Katha Vistaar should send your OTP.</p><div class="auth-choice-list">${options.map((o,i)=>`<label class="auth-choice"><input type="radio" name="otpChoice" value="${i}" ${i===0?'checked':''}><span><strong>${esc(o.label||o.type)}</strong><small>${esc(o.description||x('registeredContact'))}</small></span></label>`).join('')}</div><div class="dialog-actions"><button type="button" class="button" data-choice-cancel>Cancel</button><button type="submit" class="primary">Send OTP</button></div></form>`;document.body.appendChild(d);const finish=v=>{if(d.open)d.close();d.remove();resolve(v)};d.querySelector('[data-choice-cancel]').onclick=()=>finish(null);d.querySelector('form').onsubmit=e=>{e.preventDefault();const i=Number(new FormData(e.currentTarget).get('otpChoice'));finish(options[i]||null)};d.addEventListener('cancel',()=>finish(null),{once:true});d.showModal()})}
async function handleForgotPasswordSubmit(e){
 e.preventDefault();const box=document.getElementById('forgotError');if(box)box.textContent='';const identifier=String(new FormData(e.currentTarget).get('identifier')||'').trim();if(!identifier)return;
 try{const r=await getJSON('/api/auth/forgot-password',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({identifier})});if(!r.target&&!r.otpOptions?.length){if(box)box.textContent='If the account exists, an OTP will be sent to its registered contact.';return;}let choice=r.otpOptions?.length>1?await chooseOtpContact(r.otpOptions,'reset'):null;choice=choice||r.otpOptions?.[0]||{target:r.target,purpose:r.purpose,type:r.target?.includes('@')?'email':'mobile'};document.getElementById('forgotPasswordDialog')?.close();const m=await openOtpDialog({target:choice.target,purpose:choice.purpose,sendPath:'/api/auth/resend-otp',sendBody:{target:choice.target,purpose:choice.purpose},targetType:choice.type,targetLabel:choice.label,message:x('otpSent'),lastResponse:{...r,...choice}});if(!m)return;openResetPasswordDialog({target:choice.target,purpose:choice.purpose,resetToken:m.__resetToken});}
 catch(err){if(box)box.textContent=humanAuthError(err.code||err.message)}
}
async function handleResetPasswordSubmit(e){
 e.preventDefault();const box=document.getElementById('resetError');if(box)box.textContent='';const d=Object.fromEntries(new FormData(e.currentTarget));if(!validatePasswordPair(d.password,d.confirmPassword,box))return;const ctx=state.resetContext;if(!ctx){if(box)box.textContent='Password reset session is no longer valid. Start again.';return;}
 try{const out=await getJSON('/api/auth/reset-password',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({target:ctx.target,purpose:ctx.purpose,resetToken:ctx.resetToken,password:d.password,confirmPassword:d.confirmPassword})});state.user=null;state.resetContext=null;document.getElementById('resetPasswordDialog')?.close();updateHeader();render(currentRoute());showToast(x('loginAgainAfterReset'));openLogin();}
 catch(err){if(box)box.textContent=humanAuthError(err.message)}
}
let identityCheckTimer=null;async function refreshIdentitySuggestions(){const f=document.getElementById('registerForm');if(!f)return;const u=f.querySelector('[name=username]'),i=f.querySelector('[name=userId]'),n=f.querySelector('[name=name]');if(!u||!i)return;try{const r=await getJSON('/api/auth/identity-suggestions?username='+encodeURIComponent(u.value||n?.value||'reader'));if(!u.value)u.value=r.username;if(!i.value)i.value=r.userId;checkIdentityAvailability()}catch(e){console.warn('Identity suggestion unavailable',e)}}
async function checkIdentityAvailability(){const f=document.getElementById('registerForm');if(!f)return;const u=f.querySelector('[name=username]'),i=f.querySelector('[name=userId]');if(!u||!i)return;clearTimeout(identityCheckTimer);identityCheckTimer=setTimeout(async()=>{try{const r=await getJSON('/api/auth/check-identity?username='+encodeURIComponent(u.value)+'&userId='+encodeURIComponent(i.value));const ub=document.getElementById('usernameAvailability'),ib=document.getElementById('userIdAvailability');if(ub)ub.textContent=r.username?.valid?(r.username.available?'✓ '+x('usernameAvailable'):'✕ '+x('usernameTaken')):x('invalidUsername');if(ib)ib.textContent=r.userId?.valid?(r.userId.available?'✓ '+x('userIdAvailable'):'✕ '+x('userIdTaken')):x('invalidUserId')}catch(e){}},180)}
async function handleRegisterSubmit(e){
 e.preventDefault();const box=document.getElementById('registerError');if(box)box.textContent='';const data=Object.fromEntries(new FormData(e.currentTarget));data.verificationMethod=document.querySelector('input[name=verificationMethod]:checked')?.value||'';if(!validatePasswordPair(data.password,data.confirmPassword,box))return;if(!data.email&&!data.mobile){if(box)box.textContent='Enter at least one registered email or mobile number.';return;}
 try{const r=await getJSON('/api/auth/register',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)});document.getElementById('register')?.close();const m=await openOtpDialog({target:r.target,purpose:r.purpose,sendPath:'/api/auth/resend-otp',sendBody:{target:r.target,purpose:r.purpose},message:x('otpSent'),lastResponse:r});if(!m)return;showToast(x('otpSent')+' '+x('loginAgainAfterReset'));openLogin();}
 catch(err){if(box)box.textContent=humanAuthError(err.message)}
}
let autosaveTimer=null;function handleAutosaveInput(e){if(!e.target.closest('#editorForm'))return;clearTimeout(autosaveTimer);autosaveTimer=setTimeout(async()=>{const form=document.getElementById('editorForm'),cid=form?.dataset.id,title=document.getElementById('editorTitle')?.value.trim()||'',body=document.getElementById('editorBody')?.innerHTML||'',summary=document.getElementById('editorSummary')?.value||'';if(title||body)localStorage.setItem('kv.editor.autosave',JSON.stringify({title,body,summary,contentId:cid||null,at:new Date().toISOString()}));if(!cid)return;try{const r=await getJSON('/api/content/'+encodeURIComponent(cid)+'/autosave',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({title,body,summary,workType:document.getElementById('editorWorkType')?.value||'',category:document.getElementById('editorCategory')?.value||'',partNumber:Number(document.getElementById('editorPart')?.value||1)})});const stateEl=document.getElementById('saveState');if(stateEl&&r.autosaved)stateEl.textContent=x('autosave')+' ✓';}catch(err){console.warn('Remote autosave unavailable; local recovery copy retained.',err)}},1000)}
window.addEventListener('error',e=>{console.error(e.error||e.message);if(!state.authChecked)renderFailure(e.error||new Error(e.message||'Unknown error'))});
window.addEventListener('unhandledrejection',e=>{console.error(e.reason);if(!state.authChecked)renderFailure(e.reason||new Error('Unhandled promise rejection'))});
function initApp(){try{initStaticBindings();loadConfig()}catch(err){renderFailure(err)}}
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',initApp,{once:true});else initApp();


