Object.assign(extra.gu,{supportTitle:'આંતરિક AI મદદ અને સપોર્ટ',supportLoginRequired:'User Ticket સપોર્ટ માટે Login ફરજિયાત છે.',supportContact:'આ Login સાથે વેરીફાઇ થયેલો સંપર્ક',supportChannel:'સપોર્ટનો માર્ગ',supportAi:'આંતરિક AI મદદ',supportTicket:'યુઝર ટિકિટ',supportEmail:'ઈમેલ સપોર્ટ',supportMobile:'મોબાઇલ સપોર્ટ',supportCreate:'સપોર્ટ ટિકિટ બનાવો',supportProblem:'તમારી સમસ્યા લખો',supportResult:'સપોર્ટ પરિણામ',supportTicketId:'ટિકિટ ID',supportAiSolved:'આંતરિક AIએ પોતાની સુરક્ષિત મર્યાદામાં સમસ્યા ઉકેલી છે.',supportRoutedAdmin:'AI સુરક્ષિત રીતે ઉકેલી શક્યું નથી. ટિકિટ નક્કી કરેલા એડમિન પાસે મોકલવામાં આવી છે.',supportRoutedMaster:'આ કેસ માટે ઉચ્ચ સ્તરની સમીક્ષા જરૂરી છે. ટિકિટ માસ્ટર એડમિન પાસે મોકલવામાં આવી છે.',supportHistory:'મારી સપોર્ટ ટિકિટ્સ',supportNoTickets:'હજુ કોઈ સપોર્ટ ટિકિટ નથી.',supportNote:'Helpમાં Login સાથે વેરીફાઇ થયેલો મોબાઇલ/ઈમેલ જ ટિકિટમાં ઉપયોગ થાય છે. Help માટે બીજો OTP લેવામાં આવતો નથી. AI security, privacy અને policyની મર્યાદામાં જ કામ કરે છે.',supportThreeLayers:'ત્રણ AI સપોર્ટ લેયર: Internal AI → Designated Admin AI → Master Admin AI. માનવીય Admin AI કરતાં ઉપર છે અને Master Admin સર્વોચ્ચ માનવીય સત્તા છે.',supportWriterScope:'Writer access Master Adminના assignment મુજબ છે: Master Admin પાસે બધા writers; Designated Admin અને Internal AI પાસે માત્ર તેમને ફાળવેલા writers.',supportCritical:'Security, account takeover, payment, legal, privacy-breach અને Admin-level કેસ માટે ઉચ્ચ સ્તરની માનવીય સમીક્ષા જરૂરી છે.',uncertainCases:'અનિશ્ચિત કેસ નિર્ણય માટે નક્કી કરેલા Admin / Master Admin પાસે મોકલવામાં આવે છે.',policyTitle:'નીતિ',policyText:'પુષ્ટ થયેલા ઉલ્લંઘનોની જાણ કરવામાં આવે છે, તેમને દૂર કરવામાં આવે છે અને તેમની ગણતરી થાય છે. ત્રણ ઉલ્લંઘન પછી અપીલ બાકી હોય ત્યાં સુધી એકાઉન્ટ લોક થાય છે.',privacyTitle:'ગોપનીયતા',open:'ખોલો'});
