{
  "version": "30.0.0",
  "passwordHistoryLimit": 3,
  "loginPolicy": {
    "maxConsecutiveIncorrectPasswords": 3,
    "lockMode": "temporary",
    "unlockFlow": "forgot_password_otp_then_new_password",
    "automaticTimeout": false
  },
  "changePassword": {
    "requiresCurrentPassword": true,
    "otpRequired": false,
    "sessionContinues": true,
    "biometricRemainsEnabledAfterChange": true
  },
  "forgotPassword": {
    "otpRequired": true,
    "loginAfterResetRequired": true,
    "unlocksTemporaryPasswordLock": true,
    "disablesDeviceBiometric": true
  }
}
