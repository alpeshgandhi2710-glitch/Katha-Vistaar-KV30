  "principle": "Two-layer graceful degradation: the internal program layer remains on and is the authoritative fallback. The external provider layer is off by default and can only be enabled by Master Admin after credentials, endpoint, health check, and applicable licence/data-policy gates pass. If an external provider is absent, disabled, unreachable, or fails, the application remains operational on the internal layer.",
  "masterAdminOnly": true,
  "architecture": {
    "internalLayer": {
      "enabled": true,
      "authority": "program",
      "purpose": "always-on local fallback and core feature execution",
      "mustNeverDependOnExternalProvider": true
    },
    "externalLayer": {
      "enabled": false,
      "authority": "master_admin",
      "purpose": "optional provider integration",
      "enableCondition": "provider credentials + endpoint + health check + licence/data-policy gates where required",
      "disableBehavior": "immediate internal fallback without application crash"
    },
    "providerContract": {
      "transport": "HTTPS",
      "healthEndpoint": "GET /health",
      "auth": "Authorization: Bearer <API key>",
      "sendContract": "provider-specific adapter or generic JSON adapter",
      "failClosed": true
    }
  },
  "twoLayerContract": {
    "internalLayer": "always_on",
    "externalLayer": "master_admin_controlled",
    "externalEnabledDefault": false,
    "failClosed": true,
    "masterAdminOnlyToggle": true,
    "firewallRequiredBeforeExternalCall": true
  }
}
