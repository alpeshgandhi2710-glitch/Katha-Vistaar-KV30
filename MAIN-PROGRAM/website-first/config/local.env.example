# External services are optional. Leave blank/off and the application uses safe fallbacks.
# Master Admin can enable a service only after its provider credentials and policy/license gates are ready.
PORT=8787
KV_ADMIN_KEY=
# Master Admin secrets: provision externally; never commit live values.
KV_MASTER_ADMIN_KEY=
KV_MASTER_RECOVERY_KEY=
KV_PRODUCT_KEY=
KV_MASTER_ADMIN_ID=
KV_SUPPORT_ADMIN_ID=

# Internal communications (always-on application layer; live credentials are provisioned outside the ZIP)
KV_INTERNAL_MAIL_DOMAIN=kathavistaar.internal
KV_INTERNAL_SMTP_EMAIL_HOST=
KV_INTERNAL_SMTP_EMAIL_PORT=587
KV_INTERNAL_SMTP_EMAIL_SECURE=false
KV_INTERNAL_SMTP_EMAIL_STARTTLS=true
KV_INTERNAL_SMTP_EMAIL_USER=
KV_INTERNAL_SMTP_EMAIL_PASSWORD=
KV_INTERNAL_SMTP_EMAIL_FROM=no-reply@kathavistaar.internal
KV_INTERNAL_MAIL_REPLY_TO=
KV_INTERNAL_SMS_GATEWAY_ENDPOINT=
KV_INTERNAL_SMS_GATEWAY_API_KEY=
KV_INTERNAL_SMS_GATEWAY_HEALTH_URL=

# Email
KV_EMAIL_PROVIDER=
KV_EMAIL_API_KEY=
# SMS
KV_SMS_PROVIDER=
KV_SMS_API_KEY=
# WhatsApp
KV_WHATSAPP_PROVIDER=
KV_WHATSAPP_API_KEY=
# Push
KV_PUSH_PROVIDER=
KV_PUSH_API_KEY=
# Payments
KV_PAYMENT_PROVIDER=
KV_PAYMENT_KEY_ID=
KV_PAYMENT_SECRET=
