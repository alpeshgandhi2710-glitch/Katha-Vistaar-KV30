{
  "zoom": {
    "min": 0.8,
    "max": 2.5,
    "step": 0.1,
    "default": 1.0
  },
  "font_size": {
    "min": 12,
    "max": 32,
    "step": 1,
    "default": 18
  },
  "font_family": [
    "system",
    "serif",
    "sans",
    "monospace"
  ],
  "line_spacing": {
    "min": 1.0,
    "max": 2.5,
    "step": 0.1,
    "default": 1.5
  },
  "theme": [
    "light",
    "sepia",
    "dark"
  ],
  "text_color": "user-selectable",
  "background_color": "user-selectable",
  "persist_per_user": true
}